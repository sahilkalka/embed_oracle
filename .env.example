# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Generate each secret with: openssl rand -hex 32
SESSION_SECRET=

# Database (SQLite default for zero-friction setup, switch to postgresql:// for production)
DATABASE_URL="file:./dev.db"

# Admin Setup
ADMIN_DEFAULT_EMAIL=admin@embeddedindia.in
# Set this locally or as the GitHub Actions secret; use a unique value of at least 16 characters.
ADMIN_DEFAULT_PASSWORD=
# Required in production: at least 32 random characters. Rotating it signs out every admin.
ADMIN_JWT_SECRET=
# Separate key for webmail sessions (optional; derived from ADMIN_JWT_SECRET when empty)
WEBMAIL_JWT_SECRET=

# Mailer (Nodemailer SMTP Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=info@embeddedindia.in
SMTP_PASS=your-smtp-app-password
SMTP_FROM="Embedded India <info@embeddedindia.in>"

# Copilot and article generation share the connected provider in Admin > AI.
# These server-only values are fallbacks when admin settings are empty.
AI_PROVIDER=nvidia
AI_API_KEY=
AI_MODEL=meta/llama-3.1-70b-instruct
AI_BASE_URL=

# Anti-Spam / Cloudflare Turnstile (required in production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostname allowlist; defaults to the APP_URL hostname.
# TURNSTILE_ALLOWED_HOSTNAMES=embeddedindia.in,www.embeddedindia.in

# Monetization & Ads (Optional)
ADSENSE_PUB_ID=
META_PIXEL_ID=

# Mail server admin API (mailcow). Server-side only; never expose to the browser.
MAILCOW_API_URL=http://127.0.0.1:8088/api/v1
MAILCOW_API_KEY=
