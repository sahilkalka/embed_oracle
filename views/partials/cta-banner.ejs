<!-- Unified CTA Banner Partial -->
<section class="py-16 bg-white dark:bg-brand-surface border-t border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-center">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">Ready to engineer your next embedded system?</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300 text-base max-w-xl mx-auto font-medium">
      Speak directly with an Embedded India systems architect to evaluate your technical requirements and timeline.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/contact" class="btn-shimmer inline-flex items-center gap-2 min-h-[44px] px-8 py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl shadow-lg transition active:scale-95 transform hover:-translate-y-0.5">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span>Request an Engineering Consultation</span>
      </a>
      <% if (settings.phone_visible !== '0' && settings.phone_visible !== 'false' && settings.phone_visible !== false && settings.phone_visible !== 0) { %>
      <a href="tel:<%= (settings.contact_phone || '+91 83285 14090').replace(/[^0-9+]/g, '') %>" class="inline-flex items-center gap-2 min-h-[44px] px-6 py-3 border-2 border-slate-300 dark:border-brand-border text-slate-800 dark:text-white font-bold rounded-xl hover:bg-slate-100 dark:hover:bg-brand-dark transition">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span><%= settings.contact_phone || '+91 83285 14090' %></span>
      </a>
      <% } %>
    </div>
  </div>
</section>
