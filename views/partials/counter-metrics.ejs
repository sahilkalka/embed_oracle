<!-- Shared Counter Metrics Partial -->
<!-- Used on homepage and about page to avoid duplicate markup -->
<% const deliveredSystemsVal = (typeof settings !== 'undefined' && settings.delivered_systems) ? String(settings.delivered_systems) : '150+'; %>
<% const deliveredSystemsNum = parseInt(deliveredSystemsVal.replace(/[^0-9]/g, ''), 10) || 0; %>
<% const hilRateVal = (typeof settings !== 'undefined' && settings.hil_rate) ? String(settings.hil_rate) : '98%'; %>
<% const responseSlaVal = (typeof settings !== 'undefined' && settings.response_sla) ? String(settings.response_sla) : '<24h'; %>
<% if (deliveredSystemsNum > 0) { %>
<section class="mt-12 bg-white dark:bg-brand-surface rounded-3xl p-8 border border-slate-200 dark:border-brand-border shadow-md grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
  <div>
    <p class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono">
      <%= deliveredSystemsVal %>
    </p>
    <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 font-semibold uppercase tracking-wider">Delivered Systems</p>
  </div>
  <div>
    <p class="text-3xl sm:text-4xl font-black text-brand-500 dark:text-accent font-mono">
      <%= hilRateVal %>
    </p>
    <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 font-semibold uppercase tracking-wider">First-Pass HIL Rate</p>
  </div>
  <div>
    <p class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono">
      <%= responseSlaVal %>
    </p>
    <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 font-semibold uppercase tracking-wider">Architect Response SLA</p>
  </div>
</section>
<% } %>
