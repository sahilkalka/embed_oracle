<!-- Sticky Mobile Bottom Bar - visible only on mobile (<768px) -->
<% const cPath = (typeof currentPath !== 'undefined') ? currentPath : ''; %>
<div id="mobile-cta-bar" class="fixed bottom-0 inset-x-0 z-50 flex md:hidden items-center justify-between bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 py-1.5 px-2 shadow-2xl shadow-black/20" style="position: fixed !important; bottom: 0 !important; left: 0 !important; right: 0 !important; width: 100% !important; top: auto !important; z-index: 9990 !important;">
  
  <!-- Services -->
  <a href="/services" aria-label="Services" class="min-w-0 flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-colors duration-200 <%= cPath.startsWith('/services') ? 'text-brand-600 dark:text-accent font-black' : 'text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-accent' %>">
    <span class="material-symbols-rounded text-xl mb-0.5 leading-none" aria-hidden="true">memory</span>
    <span class="text-[11px] font-bold leading-tight">Services</span>
  </a>

  <!-- Projects -->
  <a href="/projects" aria-label="Projects" class="min-w-0 flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-colors duration-200 <%= cPath.startsWith('/projects') ? 'text-brand-600 dark:text-accent font-black' : 'text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-accent' %>">
    <span class="material-symbols-rounded text-xl mb-0.5 leading-none" aria-hidden="true">inventory_2</span>
    <span class="text-[11px] font-bold leading-tight">Projects</span>
  </a>

  <!-- About -->
  <a href="/about" aria-label="About" class="min-w-0 flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-colors duration-200 <%= cPath === '/about' ? 'text-brand-600 dark:text-accent font-black' : 'text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-accent' %>">
    <span class="material-symbols-rounded text-xl mb-0.5 leading-none" aria-hidden="true">info</span>
    <span class="text-[11px] font-bold leading-tight">About</span>
  </a>

  <!-- Single Primary Contact Action -->
  <div class="min-w-0 flex-1 flex items-center justify-center px-1">
    <a href="/contact" aria-label="Book a call" class="w-full min-w-0 inline-flex items-center justify-center gap-1 py-2 px-1.5 min-[400px]:px-2 rounded-xl bg-gradient-to-r from-brand-600 via-brand-500 to-accent text-white font-black text-[10px] min-[400px]:text-[11px] shadow-md shadow-brand-500/25 active:scale-95 transition-all text-center whitespace-nowrap">
      <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">call</span>
      <span class="min-[400px]:hidden">Call</span>
      <span class="hidden min-[400px]:inline">Book a Call</span>
    </a>
  </div>

</div>
