<!-- Unified Lead Magnet Partial -->
<section class="bg-slate-50 dark:bg-brand-dark text-slate-900 dark:text-white py-14 border-t border-slate-200 dark:border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white dark:bg-brand-surface rounded-2xl p-8 sm:p-10 border border-slate-200 dark:border-brand-border shadow-lg flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="max-w-xl text-center lg:text-left">
        <div class="inline-flex items-center space-x-2 px-3 py-1 bg-brand-50 dark:bg-brand-900/50 text-brand-600 dark:text-accent rounded-full text-xs font-bold uppercase tracking-wider mb-3 border border-brand-200 dark:border-brand-border">
          <span>Free Engineering Lead Magnet</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Subscribe for Weekly Embedded Tips &amp; Get the Free PCB Design Checklist
        </h2>
        <p class="text-slate-600 dark:text-slate-300 mt-2 text-sm sm:text-base">
          Join 3,500+ hardware &amp; firmware engineers. Receive curated DFM rules, high-speed routing techniques, and RTOS architecture patterns.
        </p>
      </div>
      <div class="w-full lg:w-auto flex-1 max-w-md">
        <form id="newsletter-form" class="lead-magnet-form space-y-3">
          <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off">
          <input type="hidden" name="source" value="<%= typeof currentPath !== 'undefined' ? currentPath : '/' %>">
          <div class="flex flex-col sm:flex-row gap-2">
            <input type="email" name="email" required aria-label="Work email for newsletter" placeholder="Enter your work email..." class="flex-1 px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 transition text-sm">
            <button type="submit" class="btn-shimmer inline-flex items-center justify-center gap-2 px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-sm transition shadow-md whitespace-nowrap active:scale-95">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>Subscribe</span>
            </button>
          </div>
          <p id="newsletter-status" class="lead-magnet-status text-xs text-slate-600 dark:text-slate-300"></p>
          <p class="text-xs text-slate-500 dark:text-slate-400 text-center sm:text-left font-medium flex items-center justify-center sm:justify-start gap-1.5">
            <span class="text-brand-500 dark:text-accent text-sm flex-shrink-0">🔒</span>
            <span>Zero spam. One-click unsubscribe at any time. Double opt-in secured.</span>
          </p>
        </form>
        <div id="newsletter-success-box" class="lead-magnet-success hidden mt-3 p-3 rounded-xl bg-brand-500/15 text-brand-600 dark:text-accent text-xs font-semibold border border-brand-500/30">
          ✅ Subscribed! Check your inbox for the PCB Design Checklist.
        </div>
      </div>
    </div>
  </div>
</section>
