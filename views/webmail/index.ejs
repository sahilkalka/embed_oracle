  <script>
    // Dummy Message Database for Realistic Local Testing
    const DUMMY_MESSAGES = [
      {
        id: 0,
        sender: 'Rajesh Kumar <rajesh.kumar@tataelxsi.com>',
        avatar: 'RK',
        subject: 'RFQ: STM32MP157 SOM Custom Board Design & BSP',
        time: 'Today at 10:42 AM',
        meta: 'To: sahil@embeddedindia.in',
        body: `<p>Hi Sahil,</p>
               <p>We reviewed your recent Embedded India case studies on high-reliability <strong>STM32MP157</strong> hardware development and Linux Board Support Package (BSP) bring-up.</p>
               <p>Our engineering division is building an industrial edge telematics controller requiring:</p>
               <ul style="margin: 0 0 16px 24px; list-style-type: disc;">
                 <li>Custom 6-layer impedance-controlled carrier board for STM32MP157C dual Cortex-A7 + Cortex-M4.</li>
                 <li>Dual Gigabit Ethernet with IEEE 1588 PTP, CAN FD, and isolated RS-485 interfaces.</li>
                 <li>Custom Yocto Scarthgap Linux BSP with hardware-accelerated TouchGFX / Qt6 framebuffers.</li>
               </ul>
               <p>We would like to request an engineering proposal and timeline for Phase 1. Please find our initial pin-mapping requirements attached.</p>`
      },
      {
        id: 1,
        sender: 'Ananya Sharma <ananya.sharma@iot-edge.io>',
        avatar: 'AS',
        subject: 'Consultation: Embedded Linux Qt6 HMI Gateway',
        time: 'Today at 9:15 AM',
        meta: 'To: sahil@embeddedindia.in',
        body: `<p>Dear Sahil,</p>
               <p>Thanks for the quick response on our RFQ. Can we schedule a 30-minute technical review call tomorrow at 3:00 PM IST?</p>
               <p>We want to align on our hardware requirements for the NXP i.MX8M Plus application processor, specifically relating to secure boot authentication and high-refresh touchscreen display drivers.</p>
               <p>Please let me know if this slot works for your calendar.</p>`
      },
      {
        id: 2,
        sender: 'Embedded India Postmaster <postmaster@embeddedindia.in>',
        avatar: 'EI',
        subject: 'DKIM & ARC Cryptographic Signing Verified',
        time: 'Yesterday at 6:30 PM',
        meta: 'To: admin@embeddedindia.in',
        body: `<p>Hello Administrator,</p>
               <p>The automated cryptographic signing check for domain <strong>embeddedindia.in</strong> has passed all security validations:</p>
               <ul style="margin: 0 0 16px 24px; list-style-type: disc;">
                 <li><strong>DKIM:</strong> 2048-bit RSA key valid on selector <code>dkim._domainkey.embeddedindia.in</code></li>
                 <li><strong>SPF:</strong> <code>v=spf1 mx a:mail.embeddedindia.in ~all</code> validated</li>
                 <li><strong>DMARC:</strong> Alignment status PASS with policy <code>p=quarantine</code></li>
               </ul>
               <p>Deliverability score to Outlook, Gmail, and Yahoo is currently rated <strong>10/10</strong>.</p>`
      },
      {
        id: 3,
        sender: 'Vikram Mehta <vikram.mehta@bhel.in>',
        avatar: 'VM',
        subject: 'PO Confirmation: Modbus RS-485 DAQ Modules',
        time: 'Nov 8 at 2:10 PM',
        meta: 'To: sahil@embeddedindia.in',
        body: `<p>Dear Sahil,</p>
               <p>Please find attached our formal Purchase Order <strong>#PO-49201</strong> for the 25 units of industrial isolated RS-485 DAQ interface controllers.</p>
               <p>Kindly verify the delivery schedule against our purchase agreement and send across the dispatch tracking once shipped.</p>`
      }
    ];

    let currentMessageId = 0;

    function loadMessage(index, element) {
      currentMessageId = index;
      const msg = DUMMY_MESSAGES[index];
      if (!msg) return;

      document.getElementById('viewSubject').innerHTML = msg.subject;
      document.getElementById('viewSender').textContent = msg.sender;
      document.getElementById('viewAvatar').textContent = msg.avatar;
      document.getElementById('viewMeta').textContent = msg.meta + ' • ' + msg.time;
      document.getElementById('viewBody').innerHTML = msg.body;

      document.querySelectorAll('.ms-mail-item').forEach(el => el.classList.remove('selected'));
      if (element) {
        element.classList.add('selected');
        element.classList.remove('unread');
      }

      // Switch view on mobile: open mail in the same full-width container
      const ws = document.getElementById('msWorkspace');
      if (ws) {
        ws.classList.add('reading-active');
        const view = document.getElementById('activeEmailContent');
        if (view) view.scrollTop = 0;
      }
    }

    function closeReadingPane() {
      const ws = document.getElementById('msWorkspace');
      if (ws) ws.classList.remove('reading-active');
    }

    function filterMessages(query) {
      const q = (query || '').toLowerCase().trim();
      const items = document.querySelectorAll('.ms-mail-item');
      items.forEach((item, idx) => {
        const msg = DUMMY_MESSAGES[idx];
        if (!msg) return;
        const match = msg.sender.toLowerCase().includes(q) || msg.subject.toLowerCase().includes(q);
        item.style.display = match ? 'block' : 'none';
      });
    }

    function selectFolder(folder, element) {
      document.querySelectorAll('.ms-folder-item').forEach(el => el.classList.remove('active'));
      if (element) element.classList.add('active');
      closeReadingPane();
      const fp = document.querySelector('.ms-folders-pane');
      if (fp) fp.classList.remove('open');
    }

    function openComposeModal() {
      document.getElementById('composeModal').style.display = 'flex';
      document.getElementById('composeTo').focus();
    }

    function closeComposeModal() {
      document.getElementById('composeModal').style.display = 'none';
    }

    function replyCurrent() {
      const msg = DUMMY_MESSAGES[currentMessageId];
      if (!msg) return;
      openComposeModal();
      document.getElementById('composeTo').value = msg.sender;
      document.getElementById('composeSubject').value = 'Re: ' + msg.subject;
    }

    function deleteCurrent() {
      const activeEl = document.querySelector('.ms-mail-item.selected');
      if (activeEl) {
        activeEl.style.transition = 'all 0.2s ease';
        activeEl.style.opacity = '0';
        setTimeout(() => {
          activeEl.remove();
          closeReadingPane();
          const remaining = document.querySelector('.ms-mail-item');
          if (remaining) {
            remaining.click();
            if (window.innerWidth <= 820) {
              closeReadingPane();
            }
          }
        }, 200);
      }
    }

    function sendDummyMessage() {
      const to = document.getElementById('composeTo').value;
      const subject = document.getElementById('composeSubject').value;
      if (!to || !subject) {
        alert('Please specify recipient and subject.');
        return;
      }
      alert('✓ Message sent via Outlook Web to ' + to);
      closeComposeModal();
    }
  </script>
