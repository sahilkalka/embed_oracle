<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in - Outlook Web &bull; Embedded India</title>
  <link rel="icon" type="image/svg+xml" href="/assets/mail/custom-shortlogo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;600;700&family=Inter:wght@400;500;600;700&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0,0&display=block" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      background: radial-gradient(circle at top right, #eef3f8 0%, #f3f2f1 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
  </style>
</head>
<body class="text-slate-800 antialiased selection:bg-blue-100 selection:text-blue-900">

  <!-- Minimal Brand Header -->
  <header class="py-4 px-6 flex items-center justify-between border-b border-slate-200/60 bg-white/70 backdrop-blur-md">
    <a href="/" class="inline-flex items-center gap-2 text-slate-700 hover:text-blue-600 transition text-xs font-semibold" title="Return to Embedded India Portal" aria-label="Return to Embedded India Portal">
      <span class="material-symbols-rounded text-base leading-none text-slate-500">arrow_back</span>
      <span>Embedded India</span>
    </a>

    <div class="inline-flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider">Mail Server Online</span>
    </div>
  </header>

  <!-- Central Outlook Sign In Box -->
  <main class="flex-1 flex items-center justify-center p-4 sm:p-6" role="main">
    <div class="w-full max-w-[440px] bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-200/80 p-7 sm:p-9 relative overflow-hidden transition-all duration-200">

      <!-- Top Microsoft & Outlook Branding Badge -->
      <div class="flex items-center gap-3 mb-6">
        <div class="w-11 h-11 rounded-xl bg-[#0078d4] flex items-center justify-center shadow-md shadow-blue-500/20 shrink-0">
          <svg width="26" height="26" viewBox="0 0 64 64" fill="none">
            <rect width="64" height="64" rx="14" fill="#005A9E"/>
            <rect x="10" y="18" width="44" height="30" rx="4" fill="#28A8EA" fill-opacity="0.95"/>
            <path d="M10 22 L32 38 L54 22" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="52" cy="18" r="7" fill="#10B981"/>
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-1.5">
            <span>Outlook</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">Web</span>
          </h1>
          <p class="text-xs text-slate-500 font-medium">Embedded India Mail Gateway</p>
        </div>
      </div>

      <!-- Heading -->
      <div class="mb-5">
        <h2 class="text-lg font-bold text-slate-900">Sign in</h2>
        <p class="text-xs text-slate-500 mt-0.5">to access your mailbox, calendar, and contacts</p>
      </div>

      <!-- Flash Error Notification -->
      <% if (error) { %>
        <div class="mb-5 p-3 rounded-xl bg-rose-50 border border-rose-200/80 text-rose-700 text-xs flex items-start gap-2.5 animate-shake">
          <span class="material-symbols-rounded text-base text-rose-500 shrink-0 mt-0.5" aria-hidden="true">error</span>
          <div class="flex-1 font-medium leading-relaxed"><%= error %></div>
        </div>
      <% } %>

      <!-- Authentication Form -->
      <form action="/webmail/login" method="POST" class="space-y-4" id="webmailLoginForm">
        <%- typeof csrfField !== 'undefined' ? csrfField : '' %>
        <div>
          <label for="mbEmail" class="block text-xs font-bold text-slate-700 mb-1.5">Email address</label>
          <div class="relative">
            <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none" aria-hidden="true">mail</span>
            <input type="email"
                   id="mbEmail"
                   name="email"
                   value="<%= registeredEmail || '' %>"
                   required
                   autofocus
                   placeholder="name@embeddedindia.in"
                   class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition bg-white"
                   autocomplete="username">
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="mbPassword" class="block text-xs font-bold text-slate-700">Password</label>
            <a href="/admin/email" class="text-[11px] font-semibold text-blue-600 hover:text-blue-700 transition" title="Reset mailbox password via admin">Forgot password?</a>
          </div>
          <div class="relative">
            <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none" aria-hidden="true">key</span>
            <input type="password"
                   id="mbPassword"
                   name="password"
                   required
                   placeholder="Enter mailbox password"
                   class="w-full pl-9 pr-10 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition bg-white"
                   autocomplete="current-password">
            <button type="button"
                    onclick="togglePasswordVisibility()"
                    class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 rounded cursor-pointer"
                    title="Toggle password visibility"
                    aria-label="Toggle password visibility">
              <span class="material-symbols-rounded text-lg leading-none" id="pwToggleIcon">visibility</span>
            </button>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit"
                id="submitBtn"
                class="w-full mt-2 inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-[#0078d4] hover:bg-[#106ebe] active:bg-[#005a9e] text-white font-bold text-sm shadow-md shadow-blue-500/25 transition cursor-pointer">
          <span class="material-symbols-rounded text-lg leading-none">login</span>
          <span>Sign in</span>
        </button>
      </form>

      <!-- Protocol & EAS Notice -->
      <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
        <span class="inline-flex items-center gap-1">
          <span class="material-symbols-rounded text-xs text-blue-600">sync</span>
          <span>ActiveSync + IMAP</span>
        </span>
        <a href="/admin/email" class="inline-flex items-center gap-1 text-slate-500 hover:text-slate-800 transition">
          <span class="material-symbols-rounded text-xs">admin_panel_settings</span>
          <span>Admin Console</span>
        </a>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="py-4 px-6 text-center text-xs text-slate-400">
    &copy; <%= new Date().getFullYear() %> Embedded India. Powered by TLS-Secured Dovecot IMAP &amp; Postfix SMTP.
  </footer>

  <script>
    function togglePasswordVisibility() {
      const pwInput = document.getElementById('mbPassword');
      const icon = document.getElementById('pwToggleIcon');
      if (pwInput.type === 'password') {
        pwInput.type = 'text';
        icon.textContent = 'visibility_off';
      } else {
        pwInput.type = 'password';
        icon.textContent = 'visibility';
      }
    }

    document.getElementById('webmailLoginForm')?.addEventListener('submit', function() {
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="material-symbols-rounded text-lg leading-none animate-spin">progress_activity</span><span>Authenticating...</span>';
    });
  </script>
</body>
</html>
