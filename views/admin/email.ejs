        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <button type="button" data-import-preset="hostinger" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs font-bold cursor-pointer">
