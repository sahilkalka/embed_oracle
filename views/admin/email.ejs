          </div>
          <div>
            <label class="block font-bold text-slate-700 dark:text-slate-200 mb-1" for="importSourcePort">IMAP Port</label>
            <input type="number" id="importSourcePort" required min="1" max="65535" value="993" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border font-mono text-slate-900 dark:text-white outline-none focus:border-emerald-500">
          </div>
          <div>
            <label class="block font-bold text-slate-700 dark:text-slate-200 mb-1" for="importSourceEnc">Security Mode</label>
            <select id="importSourceEnc" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border font-semibold text-slate-900 dark:text-white outline-none focus:border-emerald-500">
              <option value="SSL" selected>SSL / TLS (Port 993)</option>
              <option value="TLS">STARTTLS (Port 143)</option>
              <option value="PLAIN">Unencrypted (Not recommended)</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
          <label class="inline-flex items-start gap-2 cursor-pointer text-slate-700 dark:text-slate-200">
            <input type="checkbox" id="importAutomap" checked class="mt-0.5 rounded border-slate-300">
