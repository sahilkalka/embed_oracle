      `Checked ${fmtDate(d.checkedAt)} · ${s.pass || 0} pass, ${s.warn || 0} warn, ${s.fail || 0} fail`;
    const badgeCls = {
      pass: 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300',
      warn: 'bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300',
      fail: 'bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300'
    };
    document.getElementById('dnsChecksList').innerHTML = (d.checks || []).map(c => `
      <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
