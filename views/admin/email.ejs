    document.getElementById('addMailboxModal').classList.remove('hidden');
    document.getElementById('newMbUsername').focus();
  }
  function closeAddMailboxModal() {
    document.getElementById('addMailboxModal').classList.add('hidden');
  }

  function openShareGuidelinesModal(email, name, password) {
    activeShareData = {
      email: email,
      name: name,
      password: password || 'Welcome2026!#'
    };
    document.getElementById('previewMailboxEmail').textContent = email;
    document.getElementById('previewMailboxPassword').textContent = activeShareData.password;
    document.getElementById('shareTargetEmail').value = '';
    document.getElementById('shareEmailFeedback').className = 'hidden';
    document.getElementById('shareGuidelinesModal').classList.remove('hidden');
    document.getElementById('shareTargetEmail').focus();
  }
  function closeShareGuidelinesModal() {
    document.getElementById('shareGuidelinesModal').classList.add('hidden');
  }

  function generateRandomPass() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!#$';
    let res = '';
    for (let i = 0; i < 12; i++) res += chars.charAt(Math.floor(Math.random() * chars.length));
    document.getElementById('newMbPassword').value = res;
  }

  function resetPasswordModal(address, name) {
    const newPass = prompt('Enter new password for ' + address + ':', 'Reset' + Math.floor(Math.random() * 9000 + 1000) + '!');
    if (newPass) {
      alert('✓ Password updated for ' + address + ' to: ' + newPass);
      if (confirm('Would you like to share the updated credentials and setup guidelines over email now?')) {
        openShareGuidelinesModal(address, name, newPass);
      }
    }
  }

  // Delete User Mailbox (Removes from both mobile card list and desktop table)
  function deleteMailbox(address, rowId, cardId) {
    if (confirm('Are you sure you want to delete mailbox "' + address + '"? This will remove all associated emails and storage.')) {
      const row = document.getElementById(rowId);
      if (row) {
        row.style.transition = 'all 0.25s ease';
        row.style.opacity = '0';
        row.style.transform = 'translateX(20px)';
        setTimeout(() => row.remove(), 250);
      }
      const card = document.getElementById(cardId);
      if (card) {
        card.style.transition = 'all 0.25s ease';
        card.style.opacity = '0';
        card.style.transform = 'translateX(20px)';
        setTimeout(() => card.remove(), 250);
      }

      setTimeout(() => {
        const count = document.querySelectorAll('#mailboxCardList article').length;
        document.getElementById('statMailboxCount').textContent = count + ' Accounts';
      }, 300);

      alert('✓ Mailbox ' + address + ' deleted successfully.');
    }
  }

