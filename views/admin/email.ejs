      <tr>
        <td class="py-3 px-4 font-mono font-bold">${esc(m.qid)}<div class="text-[10px] text-slate-400">${esc(m.queue || '')} · ${esc(fmtBytes(m.size || 0))}</div></td>
        <td class="py-3 px-4 break-all"><div>${esc(m.sender)}</div><div class="text-[11px] text-slate-400">&rarr; ${esc((m.recipients || []).join(', '))}</div></td>
