  // ---- Import / Sync Jobs ----
  function populateImportMailboxes() {
    const sel = document.getElementById('importDestMailbox');
    const prev = sel.value;
    if (!cachedMailboxes.length) {
      sel.innerHTML = '<option value="">No mailboxes found</option>';
      return;
    }
    sel.innerHTML = cachedMailboxes.map(m => `<option value="${esc(m.username)}">${esc(m.username)}</option>`).join('');
    const preferred = cachedMailboxes.find(m => m.username === prev)?.username
      || cachedMailboxes.find(m => m.username === 'info@' + '<%= mailDomain %>')?.username
      || cachedMailboxes[0].username;
    sel.value = preferred;
    const srcEmail = document.getElementById('importSourceEmail');
    if (!srcEmail.value.trim()) srcEmail.value = preferred;
  }

  function syncStatusBadge(j) {
    if (j.isRunning) {
      return '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300">Running</span>';
    }
    if (!j.active) {
      return '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400">Paused</span>';
    }
    if (j.success === true) {
      return '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300">Completed</span>';
    }
    if (j.success === false) {
      return '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300">' + esc(j.exitStatus || 'Error') + '</span>';
    }
    return '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300">Queued</span>';
  }

  function syncJobButtons(j) {
    return `
      <button type="button" data-sync-action="run" data-id="${j.id}" title="Run now" aria-label="Run sync job now" class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 inline-flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">play_arrow</span></button>
      <button type="button" data-sync-action="toggle" data-id="${j.id}" data-active="${j.active ? '1' : '0'}" title="${j.active ? 'Pause schedule' : 'Resume schedule'}" aria-label="${j.active ? 'Pause sync job' : 'Resume sync job'}" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border inline-flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">${j.active ? 'pause' : 'play_circle'}</span></button>
      <button type="button" data-sync-action="log" data-id="${j.id}" title="View transfer log" aria-label="View import log" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border inline-flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">article</span></button>
      <button type="button" data-sync-action="delete" data-id="${j.id}" title="Delete job &amp; stored credential" aria-label="Delete sync job" class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900 inline-flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">delete</span></button>
    `;
  }

  async function loadImport() {
    if (!cachedMailboxes.length) {
      const mData = await api('mailboxes');
      cachedMailboxes = mData.mailboxes || [];
    }
    populateImportMailboxes();
    const d = await api('syncjobs');
    const jobs = d.jobs || [];
    const cards = document.getElementById('syncJobCards');
    const tbody = document.getElementById('syncJobTableBody');
    if (!jobs.length) {
      cards.innerHTML = '<div class="p-6 text-center text-xs text-slate-400">No import jobs configured yet.</div>';
      tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-xs text-slate-400">No import jobs configured yet.</td></tr>';
      return;
    }
    cards.innerHTML = jobs.map(j => `
      <article class="p-4 space-y-2.5 text-xs">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="font-mono font-bold text-slate-900 dark:text-white break-all">${esc(j.sourceEmail)} &rarr; ${esc(j.mailbox)}</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">${esc(j.sourceHost)}:${esc(j.sourcePort)} (${esc(j.sourceEnc)})</div>
          </div>
          ${syncStatusBadge(j)}
        </div>
        <div class="flex items-center justify-between gap-2 text-[11px] text-slate-400">
          <span>Last run: ${esc(j.lastRun ? fmtDate(j.lastRun) : 'Pending')}</span>
          <div class="flex items-center gap-1.5">${syncJobButtons(j)}</div>
        </div>
      </article>
    `).join('');
    tbody.innerHTML = jobs.map(j => `
      <tr class="hover:bg-slate-50 dark:hover:bg-brand-dark/40 transition">
        <td class="py-3 px-4 font-mono">
          <div class="font-bold text-slate-900 dark:text-white">${esc(j.sourceEmail)}</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">&rarr; ${esc(j.mailbox)}${j.automap ? ' · automap' : ''}</div>
        </td>
        <td class="py-3 px-4 font-mono text-[11px]">${esc(j.sourceHost)}:${esc(j.sourcePort)} <span class="text-slate-400">(${esc(j.sourceEnc)})</span></td>
        <td class="py-3 px-4 text-[11px] text-slate-500 dark:text-slate-400">${esc(j.lastRun ? fmtDate(j.lastRun) : 'Pending')}</td>
        <td class="py-3 px-4">${syncStatusBadge(j)}</td>
        <td class="py-3 px-4 text-right space-x-1 whitespace-nowrap">${syncJobButtons(j)}</td>
      </tr>
    `).join('');
  }

  // ---- Event Listeners ----
  document.getElementById('mailTabBar').addEventListener('click', e => {
    const btn = e.target.closest('[data-tab]');
    if (btn) switchTab(btn.dataset.tab);
  });

  document.addEventListener('click', async e => {
    const closeTarget = e.target.closest('[data-close-modal]');
    if (closeTarget) { closeModal(closeTarget.dataset.closeModal); return; }

    const genBtn = e.target.closest('[data-gen-pass]');
    if (genBtn) { document.getElementById(genBtn.dataset.genPass).value = genPassword(16); return; }

    const jumpBtn = e.target.closest('[data-jump-tab]');
    if (jumpBtn) { switchTab(jumpBtn.dataset.jumpTab); return; }

    const mbBtn = e.target.closest('[data-mb-action]');
    if (mbBtn) {
      const user = mbBtn.dataset.user;
      const mb = cachedMailboxes.find(x => x.username === user) || { username: user, name: '', quotaMb: 5120, active: true };
      const act = mbBtn.dataset.mbAction;
      if (act === 'edit') {
        document.getElementById('editMbUsername').value = mb.username;
        document.getElementById('editMbDisplay').textContent = mb.username;
        document.getElementById('editMbName').value = mb.name || '';
        document.getElementById('editMbQuota').value = mb.quotaMb || 5120;
        document.getElementById('editMbActive').checked = !!mb.active;
        const acc = mb.access || {};
        document.querySelectorAll('#formEditMailbox [data-edit-proto]').forEach(cb => {
          const k = cb.dataset.editProto;
          cb.checked = acc[k] !== undefined ? !!acc[k] : true;
        });
        openModal('modalEditMailbox');
      } else if (act === 'reset') {
        document.getElementById('resetPassUser').value = mb.username;
        document.getElementById('resetPassDisplay').textContent = mb.username;
        document.getElementById('resetPassInput').value = '';
        document.getElementById('resetPassForce').checked = true;
        openModal('modalResetPass');
      } else if (act === 'delete') {
        document.getElementById('deleteMbTarget').value = mb.username;
        document.getElementById('deleteMbConfirmLabel').textContent = mb.username;
        document.getElementById('deleteMbConfirmInput').value = '';
        openModal('modalDeleteMailbox');
      } else if (act === 'share') {
        openShareModal(mb.username, mb.name, '');
      }
      return;
    }

    const aliasBtn = e.target.closest('[data-alias-action]');
    if (aliasBtn) {
      const id = Number(aliasBtn.dataset.id);
      const alias = cachedAliases.find(a => Number(a.id) === id);
      if (!alias) return;
      if (aliasBtn.dataset.aliasAction === 'edit') {
        document.getElementById('modalAliasTitle').textContent = 'Edit Email Alias';
        document.getElementById('aliasEditId').value = alias.id;
        document.getElementById('aliasEditAddress').value = alias.address;
        document.getElementById('aliasLocalWrap').classList.add('hidden');
        document.getElementById('aliasAddressReadonly').textContent = alias.address;
        document.getElementById('aliasAddressReadonly').classList.remove('hidden');
        document.getElementById('aliasGoto').value = (alias.goto || []).join(', ');
        document.getElementById('aliasActiveWrap').classList.remove('hidden');
        document.getElementById('aliasActive').checked = !!alias.active;
        openModal('modalAlias');
      } else if (aliasBtn.dataset.aliasAction === 'delete') {
        if (!confirm('Delete alias ' + alias.address + '?')) return;
        try {
          await api('aliases/' + id, { method: 'DELETE', body: { address: alias.address } });
          toast('Alias deleted.');
          await loadAliases();
          loadedTabs.delete('overview');
        } catch (err) { toast(err.message, true); }
      }
      return;
    }

    const presetBtn = e.target.closest('[data-import-preset]');
    if (presetBtn) {
      if (presetBtn.dataset.importPreset === 'hostinger') {
        document.getElementById('importSourceHost').value = 'imap.hostinger.com';
        document.getElementById('importSourcePort').value = '993';
        document.getElementById('importSourceEnc').value = 'SSL';
      } else {
        document.getElementById('importSourceHost').value = '';
        document.getElementById('importSourceHost').focus();
      }
      return;
    }

    const syncBtn = e.target.closest('[data-sync-action]');
    if (syncBtn) {
      const id = Number(syncBtn.dataset.id);
      const act = syncBtn.dataset.syncAction;
      try {
        if (act === 'run') {
          const d = await api('syncjobs/' + id + '/run', { method: 'POST' });
          toast(d.message || 'Queued to run next.');
          await loadImport();
        } else if (act === 'toggle') {
          const nextActive = syncBtn.dataset.active !== '1';
          await api('syncjobs/' + id, { method: 'PATCH', body: { active: nextActive } });
          toast(nextActive ? 'Sync job resumed.' : 'Sync job paused.');
          await loadImport();
        } else if (act === 'log') {
          const d = await api('syncjobs/' + id + '/log');
          const j = d.job || {};
          document.getElementById('syncLogMeta').textContent =
            `${j.sourceEmail || ''} → ${j.mailbox || ''} · Status: ${j.isRunning ? 'Running' : (j.exitStatus || (j.success ? 'OK' : 'Pending'))}`;
          document.getElementById('syncLogContent').textContent = d.log || 'No transfer log output yet. Mailcow runs queued sync jobs automatically every minute.';
          openModal('modalSyncLog');
        } else if (act === 'delete') {
          if (!confirm('Delete this import job and remove the saved source password?')) return;
          await api('syncjobs/' + id, { method: 'DELETE' });
          toast('Import job deleted.');
          await loadImport();
        }
      } catch (err) { toast(err.message, true); }
      return;
    }

    const qBtn = e.target.closest('[data-q-action]');
    if (qBtn) {
      const { qid, qAction } = qBtn.dataset;
      if (qAction === 'delete' && !confirm('Delete queued message ' + qid + '?')) return;
      try {
        await api(`queue/${encodeURIComponent(qid)}/${encodeURIComponent(qAction)}`, { method: 'POST', body: {} });
        toast('Queue action "' + qAction + '" applied.');
        await loadQueue();
      } catch (err) { toast(err.message, true); }
      return;
    }

    const quarBtn = e.target.closest('[data-quar-action]');
    if (quarBtn) {
      const { id, quarAction } = quarBtn.dataset;
      try {
        await api(`quarantine/${encodeURIComponent(id)}/${encodeURIComponent(quarAction)}`, { method: 'POST', body: {} });
        toast('Quarantine item ' + quarAction + 'd.');
        await loadQuarantine();
      } catch (err) { toast(err.message, true); }
      return;
    }

    const unbanBtn = e.target.closest('[data-unban]');
    if (unbanBtn) {
      try {
        await api('security/unban', { method: 'POST', body: { network: unbanBtn.dataset.unban } });
        toast('Unban queued for ' + unbanBtn.dataset.unban);
        await loadSecurity();
      } catch (err) { toast(err.message, true); }
    }
  });

  function openShareModal(mailboxEmail, displayName, password) {
    document.getElementById('shareMailboxEmail').value = mailboxEmail;
    document.getElementById('shareDisplayName').value = displayName || '';
    document.getElementById('sharePreviewMailbox').textContent = mailboxEmail;
    document.getElementById('shareRecipientEmail').value = '';
    document.getElementById('shareOptionalPass').value = password || '';
    openModal('modalShareSetup');
  }

  function openCreateAliasModal() {
    document.getElementById('modalAliasTitle').textContent = 'Add Email Alias';
    document.getElementById('aliasEditId').value = '';
    document.getElementById('aliasEditAddress').value = '';
    document.getElementById('aliasLocal').value = '';
    document.getElementById('aliasLocalWrap').classList.remove('hidden');
    document.getElementById('aliasAddressReadonly').classList.add('hidden');
    document.getElementById('aliasGoto').value = '';
    document.getElementById('aliasActiveWrap').classList.add('hidden');
    openModal('modalAlias');
  }

  document.getElementById('btnHeaderAddMailbox').addEventListener('click', () => openModal('modalCreateMailbox'));
  document.getElementById('btnTabAddMailbox').addEventListener('click', () => openModal('modalCreateMailbox'));
  document.getElementById('btnHeaderAddAlias').addEventListener('click', openCreateAliasModal);
  document.getElementById('btnTabAddAlias').addEventListener('click', openCreateAliasModal);
  document.getElementById('btnHeaderRefresh').addEventListener('click', () => loadTab(activeTab));
  document.getElementById('btnAlertRetry').addEventListener('click', () => loadTab(activeTab));
  document.getElementById('btnRefreshDnsFresh').addEventListener('click', () => loadTab('dns', { fresh: true }));
  document.getElementById('btnFetchLogs').addEventListener('click', () => loadLogs().catch(e => toast(e.message, true)));
  document.getElementById('logServiceSelect').addEventListener('change', () => loadLogs().catch(e => toast(e.message, true)));
  document.getElementById('mailboxSearch').addEventListener('input', renderMailboxes);

  document.getElementById('btnFlushQueue').addEventListener('click', async () => {
    try {
      await api('queue/flush', { method: 'POST', body: {} });
      toast('Queue flush triggered.');
      await loadQueue();
    } catch (err) { toast(err.message, true); }
  });

  document.getElementById('btnCloseSecretBanner').addEventListener('click', () => {
    document.getElementById('oneTimeSecretBanner').classList.add('hidden');
  });
  document.getElementById('btnCopyOneTimeSecret').addEventListener('click', () => {
    const b = document.getElementById('oneTimeSecretBanner');
    navigator.clipboard?.writeText(`Email: ${b.dataset.user}\nPassword: ${b.dataset.pass}\nWebmail: ${WEBMAIL_URL}`)
      .then(() => toast('Credentials copied to clipboard.'))
      .catch(() => toast('Copy failed; please copy manually.', true));
  });
  document.getElementById('btnShareOneTimeSecret').addEventListener('click', () => {
    const b = document.getElementById('oneTimeSecretBanner');
    openShareModal(b.dataset.user, '', b.dataset.pass);
  });

  // ---- Form Submissions ----
  document.getElementById('formCreateMailbox').addEventListener('submit', async e => {
    e.preventDefault();
    try {
      const data = await api('mailboxes', {
        method: 'POST',
        body: {
          localPart: document.getElementById('createMbLocal').value.trim(),
          name: document.getElementById('createMbName').value.trim(),
          quotaMb: Number(document.getElementById('createMbQuota').value),
          password: document.getElementById('createMbPass').value || undefined,
          forcePasswordChange: document.getElementById('createMbForcePw').checked
        }
      });
      closeModal('modalCreateMailbox');
      e.target.reset();
      document.getElementById('createMbQuota').value = '5120';
      document.getElementById('createMbForcePw').checked = true;
      showOneTimeSecret('Mailbox created: ' + data.username, data.username, data.password, data.relayNote);
      toast('Mailbox created.');
      await loadMailboxes();
      loadedTabs.delete('overview');
    } catch (err) { toast(err.message, true); }
  });

  document.getElementById('formEditMailbox').addEventListener('submit', async e => {
    e.preventDefault();
    const user = document.getElementById('editMbUsername').value;
    const access = {};
    document.querySelectorAll('#formEditMailbox [data-edit-proto]').forEach(cb => {
      access[cb.dataset.editProto] = cb.checked;
    });
    try {
      await api('mailboxes/' + encodeURIComponent(user), {
        method: 'PATCH',
        body: {
          name: document.getElementById('editMbName').value.trim(),
          quotaMb: Number(document.getElementById('editMbQuota').value),
          active: document.getElementById('editMbActive').checked,
          access
        }
      });
      closeModal('modalEditMailbox');
      toast('Mailbox updated.');
      await loadMailboxes();
    } catch (err) { toast(err.message, true); }
  });

  document.getElementById('formResetPass').addEventListener('submit', async e => {
    e.preventDefault();
    const user = document.getElementById('resetPassUser').value;
    try {
      const data = await api(`mailboxes/${encodeURIComponent(user)}/password`, {
        method: 'POST',
        body: {
          password: document.getElementById('resetPassInput').value || undefined,
          forcePasswordChange: document.getElementById('resetPassForce').checked
        }
      });
      closeModal('modalResetPass');
      showOneTimeSecret('Password reset for ' + data.username, data.username, data.password);
      toast('Password updated.');
    } catch (err) { toast(err.message, true); }
  });

  document.getElementById('formDeleteMailbox').addEventListener('submit', async e => {
    e.preventDefault();
    const user = document.getElementById('deleteMbTarget').value;
    try {
      await api('mailboxes/' + encodeURIComponent(user), {
        method: 'DELETE',
        body: { confirm: document.getElementById('deleteMbConfirmInput').value.trim() }
      });
      closeModal('modalDeleteMailbox');
      toast('Mailbox deleted.');
      await loadMailboxes();
      loadedTabs.delete('overview');
    } catch (err) { toast(err.message, true); }
  });

  document.getElementById('formAlias').addEventListener('submit', async e => {
    e.preventDefault();
    const id = document.getElementById('aliasEditId').value;
    const goto = document.getElementById('aliasGoto').value;
    try {
      if (id) {
        await api('aliases/' + encodeURIComponent(id), {
          method: 'PATCH',
          body: {
            address: document.getElementById('aliasEditAddress').value,
            goto,
            active: document.getElementById('aliasActive').checked
          }
        });
        toast('Alias updated.');
      } else {
        await api('aliases', {
          method: 'POST',
          body: { localPart: document.getElementById('aliasLocal').value.trim(), goto }
        });
        toast('Alias created.');
      }
      closeModal('modalAlias');
      await loadAliases();
      loadedTabs.delete('overview');
    } catch (err) { toast(err.message, true); }
  });

  document.getElementById('formShareSetup').addEventListener('submit', async e => {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitShareSetup');
    btn.disabled = true;
    try {
      const d = await api('share-setup', {
        method: 'POST',
        body: {
          recipientEmail: document.getElementById('shareRecipientEmail').value.trim(),
          mailboxEmail: document.getElementById('shareMailboxEmail').value,
          displayName: document.getElementById('shareDisplayName').value,
          password: document.getElementById('shareOptionalPass').value || null
        }
      });
      closeModal('modalShareSetup');
      toast(d.message || 'Setup guide sent.');
    } catch (err) {
      toast(err.message, true);
    } finally {
      btn.disabled = false;
    }
  });

  document.getElementById('btnCopyGuideText').addEventListener('click', () => {
    const m = document.getElementById('shareMailboxEmail').value;
    const p = document.getElementById('shareOptionalPass').value;
    const lines = [
      'Embedded India Mail — Account Setup',
      'Email: ' + m,
      p ? 'Password: ' + p : 'Password: Use your existing mailbox password',
      'Webmail: ' + WEBMAIL_URL,
      'IMAP: ' + MAIL_HOST + ':993 (SSL/TLS)',
      'SMTP: ' + MAIL_HOST + ':465 (SSL/TLS) or 587 (STARTTLS)',
      'CalDAV/CardDAV: https://' + MAIL_HOST + '/dav/',
      'Exchange ActiveSync: https://' + MAIL_HOST + '/Microsoft-Server-ActiveSync'
    ].join('\n');
    navigator.clipboard?.writeText(lines)
      .then(() => toast('Setup guide copied to clipboard.'))
      .catch(() => toast('Copy failed; please copy manually.', true));
  });

  document.getElementById('importDestMailbox').addEventListener('change', e => {
    const src = document.getElementById('importSourceEmail');
    if (src && (!src.dataset.edited || !src.value.trim())) {
      src.value = e.target.value;
    }
  });
  document.getElementById('importSourceEmail').addEventListener('input', e => {
    e.target.dataset.edited = e.target.value.trim() ? '1' : '';
  });
  document.getElementById('importSourceEnc').addEventListener('change', e => {
    const port = document.getElementById('importSourcePort');
    if (e.target.value === 'SSL') port.value = '993';
    else if (e.target.value === 'TLS' || e.target.value === 'PLAIN') port.value = '143';
  });
  document.getElementById('btnRefreshSyncJobs').addEventListener('click', () => loadImport().catch(err => toast(err.message, true)));
  document.getElementById('formImportMail').addEventListener('submit', async e => {
    e.preventDefault();
    const btn = document.getElementById('btnStartImport');
    btn.disabled = true;
    try {
      const d = await api('import', {
        method: 'POST',
        body: {
          mailbox: document.getElementById('importDestMailbox').value,
          sourceEmail: document.getElementById('importSourceEmail').value.trim(),
          sourcePassword: document.getElementById('importSourcePass').value,
          sourceHost: document.getElementById('importSourceHost').value.trim(),
          sourcePort: Number(document.getElementById('importSourcePort').value) || 993,
          sourceEnc: document.getElementById('importSourceEnc').value,
          automap: document.getElementById('importAutomap').checked
        }
      });
      document.getElementById('importSourcePass').value = '';
      toast(d.message || 'Import job created and queued.');
      await loadImport();
    } catch (err) {
      toast(err.message, true);
    } finally {
      btn.disabled = false;
    }
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      ['modalCreateMailbox', 'modalEditMailbox', 'modalResetPass', 'modalDeleteMailbox', 'modalAlias', 'modalShareSetup', 'modalSyncLog'].forEach(closeModal);
    }
  });

  switchTab('overview', true);
})();
</script>

<%- include('layout_bottom') %>
