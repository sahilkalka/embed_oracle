        </div>
        <button type="button" id="btnRefreshSyncJobs" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-200 dark:border-brand-border text-xs font-bold text-slate-700 dark:text-slate-200 cursor-pointer shrink-0">
