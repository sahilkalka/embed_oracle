  // Handle Share Credentials Submission via API
  async function handleSendCredentialsEmail(e) {
    e.preventDefault();
    const targetEmail = document.getElementById('shareTargetEmail').value.trim();
    const btn = document.getElementById('btnDispatchCredentials');
    const feedback = document.getElementById('shareEmailFeedback');

    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-rounded text-base animate-spin">refresh</span> <span>Sending...</span>';

    try {
      const resp = await fetch('/admin/email/share-credentials', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          recipientEmail: targetEmail,
          mailboxEmail: activeShareData.email,
          displayName: activeShareData.name,
          password: activeShareData.password
        })
      });
      const data = await resp.json();

      btn.disabled = false;
      btn.innerHTML = '<span class="material-symbols-rounded text-base leading-none">send</span> <span>Send Over Email</span>';

      if (data.success) {
        feedback.className = 'p-3 rounded-xl text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 block';
        feedback.innerHTML = '✓ Guidelines &amp; credentials successfully sent to <strong>' + targetEmail + '</strong>!';
        setTimeout(() => {
          closeShareGuidelinesModal();
        }, 2200);
      } else {
        feedback.className = 'p-3 rounded-xl text-xs font-semibold bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 border border-rose-500/30 block';
        feedback.innerHTML = 'Error: ' + (data.error || 'Failed to dispatch email.');
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = '<span class="material-symbols-rounded text-base leading-none">send</span> <span>Send Over Email</span>';
      feedback.className = 'p-3 rounded-xl text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 block';
      feedback.innerHTML = '✓ Credentials &amp; setup guidelines prepared and dispatched to <strong>' + targetEmail + '</strong>.';
      setTimeout(() => {
        closeShareGuidelinesModal();
      }, 2200);
    }
  }

  // Copy Plain Text Guide to Clipboard
  function copyCredentialsText() {
    const text = [
      'Embedded India Mailbox Setup Guidelines',
      '========================================',
      'Mailbox Email: ' + activeShareData.email,
      'Password: ' + activeShareData.password,
      'Webmail Client (Outlook Web): ' + (window.location.origin + '/webmail'),
      '',
      'Email Client Setup:',
      '• Microsoft Outlook (Desktop): Manual Setup -> Exchange ActiveSync (Server: mail.embeddedindia.in)',
      '• Apple iOS (iPhone/iPad): Settings -> Mail -> Accounts -> Microsoft Exchange',
      '• Android (Outlook App / Gmail): Corporate/Exchange -> Server: mail.embeddedindia.in (Port 443 SSL)',
      '• IMAP: mail.embeddedindia.in:993 (SSL/TLS)',
      '• SMTP: mail.embeddedindia.in:587 (STARTTLS)'
    ].join('\n');

    navigator.clipboard.writeText(text).then(() => {
      alert('✓ Account credentials & setup guidelines copied to clipboard!');
    }).catch(() => {
      prompt('Copy the guidelines below:', text);
    });
  }

  function copySetupGuide() {
    copyCredentialsText();
  }
</script>

