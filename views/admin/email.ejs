            <span>Custom IMAP</span>
          </button>
        </div>
      </div>

      <form id="formImportMail" class="space-y-4 text-xs">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
          <div>
            <label class="block font-bold text-slate-700 dark:text-slate-200 mb-1" for="importDestMailbox">Destination Mailbox (Here)</label>
