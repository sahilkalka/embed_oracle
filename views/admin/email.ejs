              <%- include('partials/password-toggle-btn', { targetId: 'importSourcePass' }) %>
            </div>
          </div>
          <div>
            <label class="block font-bold text-slate-700 dark:text-slate-200 mb-1" for="importSourceHost">Source IMAP Server</label>
