        <h3 id="modalSyncLogTitle" class="text-base font-bold text-slate-900 dark:text-white truncate">Import Job Log</h3>
      </div>
      <button type="button" data-close-modal="modalSyncLog" aria-label="Close modal" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-white cursor-pointer">
        <span class="material-symbols-rounded text-lg" aria-hidden="true">close</span>
      </button>
    </div>
    <div id="syncLogMeta" class="text-[11px] font-mono text-slate-500 dark:text-slate-400 shrink-0"></div>
    <pre id="syncLogContent" class="flex-1 min-h-[240px] max-h-[60vh] overflow-auto p-3.5 rounded-xl bg-slate-950 text-slate-100 font-mono text-[11px] whitespace-pre-wrap break-words"></pre>
    <div class="flex justify-end shrink-0 pt-1">
      <button type="button" data-close-modal="modalSyncLog" class="inline-flex items-center gap-1 px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-200 text-xs font-bold border border-slate-200 dark:border-brand-border cursor-pointer">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">close</span>
        <span>Close</span>
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  const root = document.getElementById('mailConsoleRoot');
  const MAIL_HOST = root.dataset.host;
  const WEBMAIL_URL = root.dataset.webmail;
  let currentWebmailSkin = root.dataset.webmailSkin === 'default' ? 'default' : 'outlook';
  const loadedTabs = new Set();
  let activeTab = 'overview';
  let cachedMailboxes = [];
  let cachedAliases = [];

  function esc(v) {
    return String(v ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fmtBytes(bytes) {
    const n = Number(bytes) || 0;
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
    if (n < 1024 * 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + ' MB';
    return (n / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
  }

  function fmtDate(val) {
    if (!val) return 'Never';
    const d = typeof val === 'number' ? new Date(val * 1000) : new Date(val);
    if (Number.isNaN(d.getTime())) return String(val);
    return d.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
  }

  function toast(msg, isError) {
    const box = document.getElementById('mailToast');
    const icon = document.getElementById('mailToastIcon');
    const text = document.getElementById('mailToastMsg');
    text.textContent = msg;
    icon.textContent = isError ? 'error' : 'check_circle';
    box.className = 'fixed bottom-4 right-4 z-50 max-w-sm px-4 py-3 rounded-xl shadow-lg border text-xs font-semibold flex items-center gap-2 ' +
      (isError
        ? 'bg-rose-600 text-white border-rose-700'
        : 'bg-emerald-600 text-white border-emerald-700');
    clearTimeout(window._mailToastTimer);
    window._mailToastTimer = setTimeout(() => box.classList.add('hidden'), 3800);
  }

  function showGlobalAlert(msg) {
    const el = document.getElementById('mailGlobalAlert');
    document.getElementById('mailGlobalAlertMsg').textContent = msg;
    el.classList.remove('hidden');
  }
  function hideGlobalAlert() {
    document.getElementById('mailGlobalAlert').classList.add('hidden');
  }

  async function api(path, options) {
    const opts = options ? { ...options } : {};
    opts.headers = Object.assign({ 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, opts.headers || {});
    if (opts.body && typeof opts.body !== 'string') {
      opts.headers['Content-Type'] = 'application/json';
      opts.body = JSON.stringify(opts.body);
    }
    const res = await fetch('/admin/email/api/' + path, opts);
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.success === false) {
      throw new Error(data.error || data.message || ('Request failed (' + res.status + ')'));
    }
    hideGlobalAlert();
    return data;
  }

  function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
  function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

  function genPassword(len = 16) {
    const sets = ['ABCDEFGHJKLMNPQRSTUVWXYZ', 'abcdefghijkmnpqrstuvwxyz', '23456789', '!#%+-=?@'];
    const all = sets.join('');
    const out = sets.map(s => s[Math.floor(Math.random() * s.length)]);
    while (out.length < len) out.push(all[Math.floor(Math.random() * all.length)]);
    for (let i = out.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [out[i], out[j]] = [out[j], out[i]];
    }
    return out.join('');
  }

  function showOneTimeSecret(title, user, pass, hint) {
    document.getElementById('oneTimeSecretTitle').textContent = title;
    document.getElementById('oneTimeSecretUser').textContent = user;
    document.getElementById('oneTimeSecretPass').textContent = pass;
    document.getElementById('oneTimeSecretHint').textContent = hint || 'Copy or share this password now — it is not stored and will not be shown again.';
    const banner = document.getElementById('oneTimeSecretBanner');
    banner.dataset.user = user;
    banner.dataset.pass = pass;
    banner.classList.remove('hidden');
  }

  // ---- Tabs ----
  function switchTab(tab, forceReload) {
    activeTab = tab;
    document.querySelectorAll('.mail-tab-btn').forEach(btn => {
      const active = btn.dataset.tab === tab;
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
      btn.className = 'mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap ' +
        (active
          ? 'bg-emerald-600 text-white shadow-xs'
          : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-brand-dark');
    });
    document.querySelectorAll('.mail-tab-panel').forEach(p => {
      p.classList.toggle('hidden', p.id !== 'panel-' + tab);
    });
    if (forceReload || !loadedTabs.has(tab)) {
      loadTab(tab);
    }
  }

  async function loadTab(tab, extra) {
    try {
      if (tab === 'overview') await loadOverview();
      else if (tab === 'mailboxes') await loadMailboxes();
      else if (tab === 'aliases') await loadAliases();
      else if (tab === 'import') await loadImport();
      else if (tab === 'dns') await loadDns(!!(extra && extra.fresh));
      else if (tab === 'queue') await loadQueue();
      else if (tab === 'quarantine') await loadQuarantine();
      else if (tab === 'security') await loadSecurity();
      else if (tab === 'logs') await loadLogs();
      else if (tab === 'activity') await loadActivity();
      loadedTabs.add(tab);
    } catch (err) {
      showGlobalAlert(err.message);
    }
  }

  // ---- Webmail Skin Toggle ----
  function renderWebmailSkin(skin, syncNote) {
    currentWebmailSkin = skin === 'default' ? 'default' : 'outlook';
    const isOutlook = currentWebmailSkin === 'outlook';
    const badge = document.getElementById('webmailSkinActiveBadge');
    const btnOl = document.getElementById('btnSkinOutlook');
    const btnDef = document.getElementById('btnSkinDefault');
    const status = document.getElementById('webmailSkinStatus');

    if (badge) {
      badge.textContent = isOutlook ? 'Outlook' : 'Default';
      badge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ' +
        (isOutlook
          ? 'bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300'
          : 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300');
    }
    if (btnOl) {
      btnOl.setAttribute('aria-checked', isOutlook ? 'true' : 'false');
      btnOl.className = 'flex items-start gap-3 p-3.5 rounded-xl border-2 text-left transition cursor-pointer ' +
        (isOutlook
          ? 'border-sky-500 bg-sky-50 dark:bg-sky-950'
          : 'border-slate-200 dark:border-brand-border bg-slate-50 dark:bg-brand-dark hover:border-sky-400');
      const pill = btnOl.querySelector('.skin-check-pill');
      if (pill) pill.classList.toggle('hidden', !isOutlook);
    }
    if (btnDef) {
      btnDef.setAttribute('aria-checked', !isOutlook ? 'true' : 'false');
      btnDef.className = 'flex items-start gap-3 p-3.5 rounded-xl border-2 text-left transition cursor-pointer ' +
        (!isOutlook
          ? 'border-emerald-500 bg-emerald-50 dark:bg-emerald-950'
          : 'border-slate-200 dark:border-brand-border bg-slate-50 dark:bg-brand-dark hover:border-emerald-400');
      const pill = btnDef.querySelector('.skin-check-pill');
      if (pill) pill.classList.toggle('hidden', isOutlook);
    }
    if (status) {
      if (syncNote) {
        status.textContent = syncNote;
        status.classList.remove('hidden');
      } else {
        status.textContent = '';
        status.classList.add('hidden');
      }
    }
  }

  async function selectWebmailSkin(skin) {
    const btnOl = document.getElementById('btnSkinOutlook');
    const btnDef = document.getElementById('btnSkinDefault');
    if (btnOl) btnOl.disabled = true;
    if (btnDef) btnDef.disabled = true;
    try {
      const d = await api('webmail-skin', { method: 'POST', body: { skin } });
      renderWebmailSkin(d.skin, d.synced ? '' : d.syncNote);
      toast(d.message || 'Webmail skin updated.');
      loadedTabs.delete('activity');
    } catch (err) {
      toast(err.message, true);
    } finally {
      if (btnOl) btnOl.disabled = false;
      if (btnDef) btnDef.disabled = false;
    }
  }

  document.getElementById('btnSkinOutlook')?.addEventListener('click', () => selectWebmailSkin('outlook'));
  document.getElementById('btnSkinDefault')?.addEventListener('click', () => selectWebmailSkin('default'));
  renderWebmailSkin(currentWebmailSkin);

  // ---- Overview ----
  async function loadOverview() {
    const [d, skinData] = await Promise.all([
      api('overview'),
      api('webmail-skin').catch(() => null)
    ]);
    if (skinData && skinData.skin) {
      renderWebmailSkin(skinData.skin, skinData.synced === false && skinData.fileSkin ? ('Live file currently: ' + skinData.fileSkin) : '');
    }
    const svc = d.services || {};
    document.getElementById('ovServices').textContent = (svc.running || 0) + ' / ' + (svc.total || 0) + ' running';
    document.getElementById('ovVersion').textContent = (d.version ? 'Version ' + d.version : 'Mail server') + (svc.down && svc.down.length ? ' · Down: ' + svc.down.join(', ') : '');
    const c = d.counts || {};
    document.getElementById('ovAccounts').textContent = (c.mailboxes || 0) + ' mailboxes · ' + (c.aliases || 0) + ' aliases';
    const dom = d.domain || {};
    document.getElementById('ovQuotaInfo').textContent = 'Default quota ' + (dom.defaultQuotaMb || 0) + ' MB · Used ' + fmtBytes(dom.bytesUsed || 0);
    const vmail = d.storage || {};
    document.getElementById('ovStorage').textContent = vmail.used_percent ? vmail.used_percent + ' used' : fmtBytes(dom.bytesUsed || 0);
    document.getElementById('ovStorageDetail').textContent = vmail.used && vmail.total ? vmail.used + ' / ' + vmail.total : 'Mail volume';
    document.getElementById('ovQueue').textContent = (c.queued || 0) + ' queued';
    document.getElementById('ovRelay').textContent = dom.relayhost ? 'Relay: ' + dom.relayhost : 'Postfix relay active';

    const bMb = document.getElementById('badgeMailboxes');
    bMb.textContent = c.mailboxes || 0; bMb.classList.remove('hidden');
    const bAl = document.getElementById('badgeAliases');
    bAl.textContent = c.aliases || 0; bAl.classList.remove('hidden');
    const bQ = document.getElementById('badgeQueue');
    if (c.queued > 0) { bQ.textContent = c.queued; bQ.classList.remove('hidden'); } else { bQ.classList.add('hidden'); }

    const recent = d.recent || [];
    const wrap = document.getElementById('ovRecentActivity');
    if (!recent.length) {
      wrap.innerHTML = '<div class="text-xs text-slate-400 py-3">No recent admin changes recorded yet.</div>';
      return;
    }
    wrap.innerHTML = recent.map(r => `
      <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-100 dark:border-brand-border/60">
        <div class="min-w-0">
          <div class="font-bold text-slate-800 dark:text-slate-200 truncate">${esc(r.action)} ${r.target ? '· ' + esc(r.target) : ''}</div>
          <div class="text-[11px] text-slate-400 truncate">${esc(r.actor)} · ${esc(fmtDate(r.createdAt))}</div>
        </div>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold shrink-0 ${r.ok ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300' : 'bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300'}">${r.ok ? 'OK' : 'Failed'}</span>
      </div>
    `).join('');
  }

  // ---- Mailboxes ----
  async function loadMailboxes() {
    const d = await api('mailboxes');
    cachedMailboxes = d.mailboxes || [];
    renderMailboxes();
  }

  function protocolBadges(access) {
    const map = [['imap', 'IMAP'], ['smtp', 'SMTP'], ['pop3', 'POP3'], ['sieve', 'Sieve'], ['eas', 'EAS'], ['dav', 'DAV']];
    return map.filter(([k]) => access && access[k])
      .map(([, label]) => `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border">${label}</span>`)
      .join(' ');
  }

  function renderMailboxes() {
    const q = (document.getElementById('mailboxSearch').value || '').trim().toLowerCase();
    const list = cachedMailboxes.filter(m => !q || m.username.toLowerCase().includes(q) || (m.name || '').toLowerCase().includes(q));
    const cards = document.getElementById('mailboxCards');
    const tbody = document.getElementById('mailboxTableBody');

    if (!list.length) {
      cards.innerHTML = '<div class="p-6 text-center text-xs text-slate-400">No mailboxes match your filter.</div>';
      tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-xs text-slate-400">No mailboxes match your filter.</td></tr>';
      return;
    }

    cards.innerHTML = list.map(m => `
      <article class="p-4 space-y-3" data-mb="${esc(m.username)}">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="text-xs font-bold text-slate-900 dark:text-white truncate">${esc(m.username)}</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">${esc(m.name || '—')}</div>
          </div>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold shrink-0 ${m.active ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400'}">${m.active ? 'Active' : 'Disabled'}</span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark/50 border border-slate-100 dark:border-brand-border/50 space-y-1.5 text-[11px]">
          <div class="flex justify-between">
            <span class="text-slate-500">Storage (${esc(m.messages)} msgs)</span>
            <span class="font-bold">${esc(fmtBytes(m.usedBytes))} / ${esc(m.quotaMb)} MB (${esc(m.percent)}%)</span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-brand-dark rounded-full h-1.5 overflow-hidden">
            <div class="bg-emerald-500 h-1.5 rounded-full" style="width:${Math.min(100, Number(m.percent) || 0)}%"></div>
          </div>
          <div class="flex flex-wrap gap-1 pt-0.5">${protocolBadges(m.access)}</div>
        </div>
        <div class="flex items-center justify-end gap-1.5">
          <button type="button" data-mb-action="share" data-user="${esc(m.username)}" title="Share setup guide" aria-label="Share setup guide" class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">forward_to_inbox</span></button>
          <button type="button" data-mb-action="edit" data-user="${esc(m.username)}" title="Edit mailbox" aria-label="Edit mailbox" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">edit</span></button>
          <button type="button" data-mb-action="reset" data-user="${esc(m.username)}" title="Reset password" aria-label="Reset password" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">key</span></button>
          <button type="button" data-mb-action="delete" data-user="${esc(m.username)}" title="Delete mailbox" aria-label="Delete mailbox" class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900 flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">delete</span></button>
        </div>
      </article>
    `).join('');

    tbody.innerHTML = list.map(m => `
      <tr class="hover:bg-slate-50 dark:hover:bg-brand-dark/40 transition">
        <td class="py-3 px-4">
          <div class="font-bold text-slate-900 dark:text-white">${esc(m.username)}</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">${esc(m.name || '—')}</div>
        </td>
        <td class="py-3 px-4">
          <div class="w-32 bg-slate-200 dark:bg-brand-dark rounded-full h-1.5 mb-1 overflow-hidden">
            <div class="bg-emerald-500 h-1.5 rounded-full" style="width:${Math.min(100, Number(m.percent) || 0)}%"></div>
          </div>
          <div class="text-[11px]">${esc(fmtBytes(m.usedBytes))} / ${esc(m.quotaMb)} MB (${esc(m.percent)}%) · ${esc(m.messages)} msgs</div>
        </td>
        <td class="py-3 px-4"><div class="flex flex-wrap gap-1">${protocolBadges(m.access)}</div></td>
        <td class="py-3 px-4 text-[11px] text-slate-500 dark:text-slate-400">${esc(fmtDate(m.lastLogin))}</td>
        <td class="py-3 px-4">
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${m.active ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400'}">${m.active ? 'Active' : 'Disabled'}</span>
        </td>
        <td class="py-3 px-4 text-right">
          <div class="inline-flex items-center gap-1.5">
            <button type="button" data-mb-action="share" data-user="${esc(m.username)}" title="Share setup guide" aria-label="Share setup guide" class="p-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 hover:bg-emerald-100 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 cursor-pointer"><span class="material-symbols-rounded text-base leading-none">forward_to_inbox</span></button>
            <button type="button" data-mb-action="edit" data-user="${esc(m.username)}" title="Edit mailbox" aria-label="Edit mailbox" class="p-1.5 rounded-lg bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border cursor-pointer"><span class="material-symbols-rounded text-base leading-none">edit</span></button>
            <button type="button" data-mb-action="reset" data-user="${esc(m.username)}" title="Reset password" aria-label="Reset password" class="p-1.5 rounded-lg bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border cursor-pointer"><span class="material-symbols-rounded text-base leading-none">key</span></button>
            <button type="button" data-mb-action="delete" data-user="${esc(m.username)}" title="Delete mailbox" aria-label="Delete mailbox" class="p-1.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900 cursor-pointer"><span class="material-symbols-rounded text-base leading-none">delete</span></button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  // ---- Aliases ----
  async function loadAliases() {
    const d = await api('aliases');
    cachedAliases = d.aliases || [];
    const cards = document.getElementById('aliasCards');
    const tbody = document.getElementById('aliasTableBody');
    if (!cachedAliases.length) {
      cards.innerHTML = '<div class="p-6 text-center text-xs text-slate-400">No aliases configured.</div>';
      tbody.innerHTML = '<tr><td colspan="4" class="py-8 text-center text-xs text-slate-400">No aliases configured.</td></tr>';
      return;
    }
    cards.innerHTML = cachedAliases.map(a => `
      <article class="p-4 space-y-2.5">
        <div class="flex items-start justify-between gap-2">
          <div class="font-bold text-xs text-slate-900 dark:text-white break-all">${esc(a.address)}</div>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold shrink-0 ${a.active ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400'}">${a.active ? 'Active' : 'Disabled'}</span>
        </div>
        <div class="text-[11px] font-mono text-slate-500 dark:text-slate-400 break-all">&rarr; ${esc((a.goto || []).join(', '))}</div>
        <div class="flex justify-end gap-1.5">
          <button type="button" data-alias-action="edit" data-id="${esc(a.id)}" title="Edit alias" aria-label="Edit alias" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-brand-dark border border-slate-200 dark:border-brand-border flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">edit</span></button>
          <button type="button" data-alias-action="delete" data-id="${esc(a.id)}" title="Delete alias" aria-label="Delete alias" class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900 flex items-center justify-center cursor-pointer"><span class="material-symbols-rounded text-base">delete</span></button>
        </div>
      </article>
    `).join('');

    tbody.innerHTML = cachedAliases.map(a => `
      <tr class="hover:bg-slate-50 dark:hover:bg-brand-dark/40 transition">
        <td class="py-3 px-4 font-bold text-slate-900 dark:text-white">${esc(a.address)}</td>
        <td class="py-3 px-4 font-mono text-[11px] break-all">${esc((a.goto || []).join(', '))}</td>
        <td class="py-3 px-4"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${a.active ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400'}">${a.active ? 'Active' : 'Disabled'}</span></td>
        <td class="py-3 px-4 text-right">
          <div class="inline-flex items-center gap-1.5">
            <button type="button" data-alias-action="edit" data-id="${esc(a.id)}" title="Edit alias" aria-label="Edit alias" class="p-1.5 rounded-lg bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 border border-slate-200 dark:border-brand-border cursor-pointer"><span class="material-symbols-rounded text-base leading-none">edit</span></button>
