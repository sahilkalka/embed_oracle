      <button type="button" data-q-action="unhold" data-qid="${esc(qid)}" title="Unhold message" aria-label="Unhold message" class="p-1.5 rounded-lg bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border cursor-pointer"><span class="material-symbols-rounded text-base leading-none">play_arrow</span></button>
      <button type="button" data-q-action="delete" data-qid="${esc(qid)}" title="Delete from queue" aria-label="Delete from queue" class="p-1.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900 cursor-pointer"><span class="material-symbols-rounded text-base leading-none">delete</span></button>
