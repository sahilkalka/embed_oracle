<%- include('layout_top') %>

<div class="w-full max-w-full overflow-x-hidden min-w-0 space-y-5 sm:space-y-6"
     id="mailConsoleRoot"
     data-domain="<%= mailDomain %>"
     data-host="<%= mailHost %>"
     data-webmail="<%= webmailUrl %>"
     data-webmail-skin="<%= typeof webmailSkin !== 'undefined' ? webmailSkin : 'outlook' %>">

  <!-- Toast Banner -->
  <div id="mailToast" class="hidden fixed bottom-4 right-4 z-50 max-w-sm px-4 py-3 rounded-xl shadow-lg border text-xs font-semibold flex items-center gap-2" role="status" aria-live="polite">
    <span class="material-symbols-rounded text-base shrink-0" id="mailToastIcon" aria-hidden="true">check_circle</span>
    <span id="mailToastMsg" class="min-w-0 break-words"></span>
  </div>

  <!-- Header & Primary Icon Action Bar -->
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 bg-white dark:bg-brand-surface p-4 sm:p-5 lg:p-6 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs w-full max-w-full overflow-hidden">
    <div class="min-w-0 flex-1">
      <div class="flex items-start sm:items-center gap-3 min-w-0">
        <span class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 flex items-center justify-center shrink-0">
          <span class="material-symbols-rounded text-2xl leading-none" aria-hidden="true">mark_email_read</span>
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-1.5">
            <h1 class="text-base sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight truncate">
              Embedded India Mail Console
            </h1>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 uppercase tracking-wider shrink-0">
              <%= mailDomain %>
            </span>
          </div>
          <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-normal break-words">
            Live mail server management for mailboxes, aliases, DNS &amp; TLS health, queue, quarantine, fail2ban, and logs.
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 w-full lg:w-auto shrink-0 pt-2 lg:pt-0 border-t border-slate-100 dark:border-brand-border/60 lg:border-t-0">
      <a href="<%= webmailUrl %>" target="_blank" rel="noopener"
         class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border font-bold text-xs transition cursor-pointer">
        <span class="material-symbols-rounded text-base leading-none text-emerald-500" aria-hidden="true">open_in_new</span>
        <span>Open Webmail</span>
      </a>

      <button type="button" id="btnHeaderAddMailbox"
              class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition cursor-pointer">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">person_add</span>
        <span>Add Mailbox</span>
      </button>

      <button type="button" id="btnHeaderAddAlias"
              class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border font-bold text-xs transition cursor-pointer">
        <span class="material-symbols-rounded text-base leading-none text-emerald-500" aria-hidden="true">alternate_email</span>
        <span>Add Alias</span>
      </button>

      <button type="button" id="btnHeaderRefresh"
              title="Refresh active tab" aria-label="Refresh active tab"
              class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border font-bold text-xs transition cursor-pointer">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">refresh</span>
        <span>Refresh</span>
      </button>
    </div>
  </div>

  <!-- Global Error / Config Notice -->
  <div id="mailGlobalAlert" class="hidden rounded-2xl border border-rose-500/30 bg-rose-50 dark:bg-rose-950/40 p-4 text-xs text-rose-800 dark:text-rose-200 flex items-start justify-between gap-3">
    <div class="flex items-start gap-2.5 min-w-0">
      <span class="material-symbols-rounded text-lg shrink-0 text-rose-500" aria-hidden="true">error</span>
      <div class="min-w-0">
        <div class="font-bold">Mail server API notice</div>
        <p id="mailGlobalAlertMsg" class="mt-0.5 break-words opacity-90"></p>
      </div>
    </div>
    <button type="button" id="btnAlertRetry" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-bold text-[11px] shrink-0 cursor-pointer">
      <span class="material-symbols-rounded text-sm" aria-hidden="true">refresh</span>
      <span>Retry</span>
    </button>
  </div>

  <!-- One-time Created/Reset Password Banner -->
  <div id="oneTimeSecretBanner" class="hidden rounded-2xl border border-emerald-500/40 bg-emerald-50 dark:bg-emerald-950/40 p-4 text-xs text-emerald-900 dark:text-emerald-100 space-y-2.5">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <span class="material-symbols-rounded text-lg text-emerald-600 dark:text-emerald-400 shrink-0" aria-hidden="true">key</span>
        <span class="font-bold truncate" id="oneTimeSecretTitle">One-time password generated</span>
      </div>
      <button type="button" id="btnCloseSecretBanner" aria-label="Dismiss password notice" class="p-1 rounded-lg hover:bg-emerald-500/15 cursor-pointer shrink-0">
        <span class="material-symbols-rounded text-base" aria-hidden="true">close</span>
      </button>
    </div>
    <p class="text-[11px] opacity-90" id="oneTimeSecretHint">Copy or share this password now — it is not stored and will not be shown again.</p>
    <div class="flex flex-wrap items-center gap-2">
      <code id="oneTimeSecretUser" class="px-2.5 py-1.5 rounded-lg bg-white/80 dark:bg-brand-dark border border-emerald-500/30 font-mono font-bold break-all"></code>
      <code id="oneTimeSecretPass" class="px-2.5 py-1.5 rounded-lg bg-white/80 dark:bg-brand-dark border border-emerald-500/30 font-mono font-bold break-all"></code>
      <button type="button" id="btnCopyOneTimeSecret" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-white dark:bg-brand-dark border border-emerald-500/30 font-bold hover:bg-emerald-100 dark:hover:bg-slate-800 cursor-pointer">
        <span class="material-symbols-rounded text-sm" aria-hidden="true">content_copy</span>
        <span>Copy</span>
      </button>
      <button type="button" id="btnShareOneTimeSecret" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold cursor-pointer">
        <span class="material-symbols-rounded text-sm" aria-hidden="true">forward_to_inbox</span>
        <span>Share Setup Guide</span>
      </button>
    </div>
  </div>

  <!-- Responsive Tab Navigation -->
  <nav class="bg-white dark:bg-brand-surface rounded-2xl border border-slate-200 dark:border-brand-border p-1.5 shadow-xs overflow-x-auto thin-dark-scrollbar" aria-label="Mail Admin Sections">
    <div class="flex items-center gap-1 min-w-max" id="mailTabBar" role="tablist">
      <button type="button" role="tab" data-tab="overview" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">dashboard</span>
        <span>Overview</span>
      </button>
      <button type="button" role="tab" data-tab="mailboxes" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">inbox</span>
        <span>Mailboxes</span>
        <span id="badgeMailboxes" class="hidden px-1.5 py-0.5 rounded-full text-[10px] bg-slate-200 dark:bg-brand-dark"></span>
      </button>
      <button type="button" role="tab" data-tab="aliases" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">alternate_email</span>
        <span>Aliases</span>
        <span id="badgeAliases" class="hidden px-1.5 py-0.5 rounded-full text-[10px] bg-slate-200 dark:bg-brand-dark"></span>
      </button>
      <button type="button" role="tab" data-tab="import" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">cloud_download</span>
        <span>Import</span>
      </button>
      <button type="button" role="tab" data-tab="dns" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">verified_user</span>
        <span>DNS &amp; Certificates</span>
      </button>
      <button type="button" role="tab" data-tab="queue" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">schedule_send</span>
        <span>Queue</span>
        <span id="badgeQueue" class="hidden px-1.5 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-600 dark:text-amber-300"></span>
      </button>
      <button type="button" role="tab" data-tab="quarantine" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">report</span>
        <span>Quarantine</span>
      </button>
      <button type="button" role="tab" data-tab="security" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">shield</span>
        <span>Security</span>
      </button>
      <button type="button" role="tab" data-tab="logs" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">terminal</span>
        <span>Logs</span>
      </button>
      <button type="button" role="tab" data-tab="activity" class="mail-tab-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer whitespace-nowrap">
        <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">history</span>
        <span>Activity</span>
      </button>
    </div>
  </nav>

  <!-- TAB 1: OVERVIEW -->
  <section id="panel-overview" class="mail-tab-panel space-y-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" id="overviewMetrics">
      <div class="bg-white dark:bg-brand-surface rounded-2xl p-4 border border-slate-200 dark:border-brand-border shadow-xs">
        <div class="flex items-center justify-between text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <span>Services</span>
          <span class="material-symbols-rounded text-emerald-500 text-lg" aria-hidden="true">dns</span>
        </div>
        <div class="mt-2 text-lg font-extrabold text-slate-900 dark:text-white" id="ovServices">Loading…</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate" id="ovVersion">—</p>
      </div>
      <div class="bg-white dark:bg-brand-surface rounded-2xl p-4 border border-slate-200 dark:border-brand-border shadow-xs">
        <div class="flex items-center justify-between text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <span>Mailboxes &amp; Aliases</span>
          <span class="material-symbols-rounded text-emerald-500 text-lg" aria-hidden="true">group</span>
        </div>
        <div class="mt-2 text-lg font-extrabold text-slate-900 dark:text-white" id="ovAccounts">—</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate" id="ovQuotaInfo">—</p>
      </div>
      <div class="bg-white dark:bg-brand-surface rounded-2xl p-4 border border-slate-200 dark:border-brand-border shadow-xs">
        <div class="flex items-center justify-between text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <span>Mail Storage</span>
          <span class="material-symbols-rounded text-emerald-500 text-lg" aria-hidden="true">hard_drive</span>
        </div>
        <div class="mt-2 text-lg font-extrabold text-slate-900 dark:text-white" id="ovStorage">—</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate" id="ovStorageDetail">—</p>
      </div>
      <div class="bg-white dark:bg-brand-surface rounded-2xl p-4 border border-slate-200 dark:border-brand-border shadow-xs">
        <div class="flex items-center justify-between text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <span>Outbound Queue</span>
          <span class="material-symbols-rounded text-emerald-500 text-lg" aria-hidden="true">schedule_send</span>
        </div>
        <div class="mt-2 text-lg font-extrabold text-slate-900 dark:text-white" id="ovQueue">—</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate" id="ovRelay">—</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5">
      <div class="bg-white dark:bg-brand-surface rounded-2xl border border-slate-200 dark:border-brand-border p-4 sm:p-5 shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="material-symbols-rounded text-emerald-500 text-lg" aria-hidden="true">devices</span>
            <span>Client Connection Endpoints</span>
          </h2>
          <span class="text-[11px] font-mono text-slate-400"><%= mailHost %></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
          <div class="p-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border">
            <div class="text-[10px] font-bold uppercase text-slate-400">Webmail</div>
            <div class="font-mono font-bold text-slate-800 dark:text-slate-200 truncate mt-0.5"><%= webmailUrl %></div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border">
            <div class="text-[10px] font-bold uppercase text-slate-400">IMAP / SMTP</div>
            <div class="font-mono font-bold text-slate-800 dark:text-slate-200 truncate mt-0.5">993 (SSL) · 465 / 587</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border">
            <div class="text-[10px] font-bold uppercase text-slate-400">CardDAV / CalDAV</div>
            <div class="font-mono font-bold text-slate-800 dark:text-slate-200 truncate mt-0.5">https://<%= mailHost %>/dav/</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border">
            <div class="text-[10px] font-bold uppercase text-slate-400">Exchange ActiveSync</div>
            <div class="font-mono font-bold text-slate-800 dark:text-slate-200 truncate mt-0.5">/Microsoft-Server-ActiveSync</div>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-brand-surface rounded-2xl border border-slate-200 dark:border-brand-border p-4 sm:p-5 shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="material-symbols-rounded text-emerald-500 text-lg" aria-hidden="true">history</span>
            <span>Recent Admin Activity</span>
          </h2>
          <button type="button" data-jump-tab="activity" class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600 dark:text-accent hover:underline cursor-pointer">
            <span>View all</span>
            <span class="material-symbols-rounded text-sm" aria-hidden="true">arrow_forward</span>
          </button>
        </div>
        <div id="ovRecentActivity" class="space-y-2 text-xs text-slate-500 dark:text-slate-400">Loading…</div>
      </div>
    </div>

    <!-- Webmail Skin Switcher -->
    <div class="bg-white dark:bg-brand-surface rounded-2xl border border-slate-200 dark:border-brand-border p-4 sm:p-5 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="min-w-0">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="material-symbols-rounded text-emerald-500 text-lg" aria-hidden="true">palette</span>
            <span>Webmail Skin</span>
            <span id="webmailSkinActiveBadge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 uppercase tracking-wider">Outlook</span>
          </h2>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
            Switch <code class="font-mono"><%= webmailUrl %></code> between the responsive Outlook Fluent Blue skin and the Default Embedded India Emerald skin.
          </p>
        </div>
        <a href="<%= webmailUrl %>" target="_blank" rel="noopener"
           class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border font-bold text-xs shrink-0 transition cursor-pointer">
          <span class="material-symbols-rounded text-base leading-none text-sky-500" aria-hidden="true">open_in_new</span>
          <span>Preview Webmail</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Webmail skin selection">
        <button type="button" id="btnSkinOutlook" data-skin="outlook" role="radio" aria-checked="true"
                class="flex items-start gap-3 p-3.5 rounded-xl border-2 text-left transition cursor-pointer border-sky-500 bg-sky-50 dark:bg-sky-950">
          <span class="w-10 h-10 rounded-xl bg-[#0078d4] text-white flex items-center justify-center shrink-0 shadow-xs">
            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">mail</span>
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between gap-2">
              <span class="text-xs font-extrabold text-slate-900 dark:text-white">Outlook Skin</span>
              <span class="skin-check-pill px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#0078d4] text-white">Active</span>
            </span>
            <span class="block text-[11px] text-slate-600 dark:text-slate-300 mt-0.5">
              Outlook default blue (#0078d4), Fluent top bar, waffle launcher, responsive &amp; bouncy across all resolutions.
            </span>
          </span>
        </button>

        <button type="button" id="btnSkinDefault" data-skin="default" role="radio" aria-checked="false"
                class="flex items-start gap-3 p-3.5 rounded-xl border-2 text-left transition cursor-pointer border-slate-200 dark:border-brand-border bg-slate-50 dark:bg-brand-dark hover:border-emerald-400">
          <span class="w-10 h-10 rounded-xl bg-[#007f5f] text-white flex items-center justify-center shrink-0 shadow-xs">
            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">eco</span>
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between gap-2">
              <span class="text-xs font-extrabold text-slate-900 dark:text-white">Default Skin</span>
              <span class="skin-check-pill hidden px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-600 text-white">Active</span>
            </span>
            <span class="block text-[11px] text-slate-600 dark:text-slate-300 mt-0.5">
              Classic Embedded India Emerald (#007f5f) theme over the standard Elastic webmail layout.
            </span>
          </span>
        </button>
      </div>
      <div id="webmailSkinStatus" class="hidden text-[11px] text-amber-600 dark:text-amber-300"></div>
    </div>
  </section>

  <!-- TAB 2: MAILBOXES -->
  <section id="panel-mailboxes" class="mail-tab-panel hidden bg-white dark:bg-brand-surface rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-brand-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="min-w-0">
        <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="material-symbols-rounded text-emerald-500 text-lg" aria-hidden="true">manage_accounts</span>
          <span>Mailboxes</span>
        </h2>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">Create mailboxes, edit quotas/status, reset passwords, or email setup instructions.</p>
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto">
        <div class="relative flex-1 sm:w-56">
          <span class="material-symbols-rounded text-base text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" aria-hidden="true">search</span>
          <input type="search" id="mailboxSearch" placeholder="Filter mailboxes…" aria-label="Filter mailboxes" class="w-full pl-8 pr-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs text-slate-900 dark:text-white outline-none focus:border-emerald-500">
        </div>
        <button type="button" id="btnTabAddMailbox" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shrink-0 cursor-pointer">
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">person_add</span>
          <span class="hidden sm:inline">New</span>
        </button>
      </div>
    </div>

    <div id="mailboxCards" class="block md:hidden divide-y divide-slate-100 dark:divide-brand-border/60"></div>
    <div class="hidden md:block overflow-x-auto w-full">
      <table class="w-full text-left text-xs text-slate-600 dark:text-slate-300">
