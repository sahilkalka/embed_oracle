    </div>
    <form id="formCreateMailbox" class="space-y-3 text-xs">
      <div>
        <label class="block font-bold text-slate-700 dark:text-slate-200 mb-1" for="createMbLocal">Address</label>
        <div class="flex items-center">
          <input type="text" id="createMbLocal" required placeholder="e.g. rohit" class="w-full px-3 py-2 rounded-l-xl bg-slate-50 dark:bg-brand-dark border border-r-0 border-slate-200 dark:border-brand-border text-slate-900 dark:text-white outline-none focus:border-emerald-500">
          <span class="px-2.5 py-2 rounded-r-xl bg-slate-100 dark:bg-brand-dark/80 border border-slate-200 dark:border-brand-border font-mono text-slate-500 shrink-0">@<%= mailDomain %></span>
        </div>
      </div>
