      <article class="p-4 space-y-2 text-xs">
        <div class="flex justify-between gap-2"><span class="font-mono font-bold">${esc(m.qid)}</span><span class="text-[11px] text-slate-400">${esc(fmtDate(m.arrival))}</span></div>
        <div class="break-all"><strong>${esc(m.sender)}</strong> &rarr; ${esc((m.recipients || []).join(', '))}</div>
        ${m.reason ? `<div class="text-[11px] text-amber-600 dark:text-amber-300 break-words">${esc(m.reason)}</div>` : ''}
