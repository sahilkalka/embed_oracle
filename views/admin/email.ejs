        <td class="py-2.5 px-4 font-semibold">${esc(e.actor)}</td>
        <td class="py-2.5 px-4 font-mono text-[11px]">${esc(e.action)}</td>
        <td class="py-2.5 px-4 font-mono text-[11px] break-all">${esc(e.target || '—')}</td>
        <td class="py-2.5 px-4 font-mono text-[11px] text-slate-400">${esc(e.ip || '—')}</td>
        <td class="py-2.5 px-4"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${e.ok ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300' : 'bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300'}">${e.ok ? 'OK' : 'Failed'}</span></td>
