<section id="faq-manager" aria-labelledby="faq-manager-title" class="settings-section hidden">
  <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="Homepage FAQs" id="faqManagerForm">
    <%- csrfField %>
    <input type="hidden" name="_active_tab" value="faq-manager">
    <input type="hidden" id="custom_faqs" name="custom_faqs" value="<%= settings.custom_faqs || '[]' %>">
    <%- include('settings-module-header', {"sectionId":"faq-manager","title":"Homepage FAQs","icon":"quiz","description":"Add, edit, reorder, or remove additional homepage questions and answers.","saveLabel":"Save FAQs"}) %>
    <div class="settings-panel rounded-2xl bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-4 border-b border-slate-100 dark:border-brand-border">
        <div>
          <h3 class="settings-panel-title">Homepage FAQ entries</h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Add and organize the questions shown on your homepage.</p>
        </div>
        <button type="button" id="addFaqRow" class="inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl border border-brand-300 dark:border-brand-800 bg-white dark:bg-brand-surface text-xs font-bold text-brand-700 dark:text-accent hover:bg-brand-50 dark:hover:bg-brand-950/40 transition cursor-pointer shrink-0">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add FAQ</span>
        </button>
      </div>
      <p id="faqEditorStatus" class="text-[11px] text-slate-500 dark:text-slate-400" aria-live="polite"></p>
      <div id="faqEditorRows" class="space-y-4"></div>
    </div>
    <div class="settings-module-footer"><%- include('module-save-button', { label: 'Save FAQs' }) %></div>
  </form>
</section>
<script src="/js/faq-manager.js?v=<%= assetVersion %>" defer></script>
