<section id="faq-manager" aria-labelledby="faq-manager-title" class="settings-section hidden">
  <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="Homepage FAQs" id="faqManagerForm">
    <%- csrfField %>
    <input type="hidden" name="_active_tab" value="faq-manager">
    <input type="hidden" id="custom_faqs" name="custom_faqs" value="<%= settings.custom_faqs || '[]' %>">
    <%- include('settings-module-header', {"sectionId":"faq-manager","title":"Homepage FAQs","icon":"quiz","description":"Add, edit, reorder, or remove additional homepage questions and answers.","saveLabel":"Save FAQs"}) %>
    <div class="settings-panel rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h3 class="settings-panel-title">Homepage FAQ entries</h3>
          <p id="faqEditorStatus" class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5" aria-live="polite"></p>
        </div>
        <button type="button" id="addFaqRow" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-brand-border bg-white dark:bg-brand-surface text-xs font-bold text-brand-700 dark:text-accent hover:bg-brand-500/10 dark:hover:bg-accent/15 transition cursor-pointer">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add FAQ</span>
        </button>
      </div>
      <div id="faqEditorRows" class="space-y-3"></div>
    </div>
    <div class="settings-module-footer"><%- include('module-save-button', { label: 'Save FAQs' }) %></div>
  </form>
</section>
<script src="/js/faq-manager.js?v=20261026-settings-1" defer></script>
