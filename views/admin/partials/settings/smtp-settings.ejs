<section id="smtp-settings" aria-labelledby="smtp-settings-title" class="settings-section hidden">

      <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="SMTP &amp; Email Routing">
        <%- csrfField %>
        <input type="hidden" name="_active_tab" value="smtp-settings">

        <%- include('../settings-module-header', {"sectionId":"smtp-settings","title":"Email & routing","icon":"outgoing_mail","description":"Configure outgoing mail and the staff who receive inquiry and subscriber alerts.","saveLabel":"Save SMTP & Routing"}) %>

        <!-- 7A. RECIPIENT ROUTING (CUSTOMER INQUIRIES & NEWSLETTER LEADS) -->
        <div class="settings-panel p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-1.5">
            <h3 class="settings-panel-title">Notification recipients</h3>
            <span class="text-[11px] text-slate-400">Comma-separated email addresses supported</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">

            <!-- Customer Queries Recipient -->
            <div class="space-y-1.5">
              <label class="block font-bold text-slate-800 dark:text-slate-200" for="inquiry_recipient_emails">
                Customer Inquiries &amp; RFQ Quotes Recipient(s):
              </label>
              <input type="text" id="inquiry_recipient_emails" name="inquiry_recipient_emails" value="<%= settings.inquiry_recipient_emails || 'info@embeddedindia.in' %>" placeholder="info@embeddedindia.in, engineering@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-xs">

              <!-- Quick Select from Registered Staff Accounts -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                <span class="text-[10px] text-slate-400 font-bold uppercase">Staff Quick-Add:</span>
                <% (users || []).forEach(u => { %>
                  <button type="button" onclick="appendEmailTo('inquiry_recipient_emails', '<%= u.email %>')" class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-lg bg-slate-200 dark:bg-slate-800 hover:bg-brand-500 hover:text-white transition font-mono">
                    <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span><%= u.email %></span>
                  </button>
                <% }) %>
              </div>
            </div>

            <!-- Newsletter Alerts Recipient -->
            <div class="space-y-1.5">
              <label class="block font-bold text-slate-800 dark:text-slate-200" for="newsletter_recipient_emails">
                Newsletter Subscriber Leads Alert Recipient(s):
              </label>
              <input type="text" id="newsletter_recipient_emails" name="newsletter_recipient_emails" value="<%= settings.newsletter_recipient_emails || 'info@embeddedindia.in' %>" placeholder="newsletter@embeddedindia.in, info@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-xs">

              <!-- Quick Select from Registered Staff Accounts -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                <span class="text-[10px] text-slate-400 font-bold uppercase">Staff Quick-Add:</span>
                <% (users || []).forEach(u => { %>
                  <button type="button" onclick="appendEmailTo('newsletter_recipient_emails', '<%= u.email %>')" class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-lg bg-slate-200 dark:bg-slate-800 hover:bg-brand-500 hover:text-white transition font-mono">
                    <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span><%= u.email %></span>
                  </button>
                <% }) %>
              </div>
            </div>

          </div>
        </div>

        <!-- 7B. Outgoing SMTP Socket Settings -->
<div class="settings-panel space-y-4"><div class="settings-panel-intro"><h3>Outgoing mail server</h3><p>Choose a preset or enter the credentials supplied by your mail provider.</p></div>

        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Quick Presets:</span>
            <button type="button" onclick="setSmtpPreset('ses')" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">
              <span class="material-symbols-rounded text-sm text-emerald-500 shrink-0" aria-hidden="true">cloud_upload</span>
              <span>Amazon SES (587)</span>
            </button>
            <button type="button" onclick="setSmtpPreset('mailcow')" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">
              <span class="material-symbols-rounded text-sm text-emerald-500 shrink-0" aria-hidden="true">dns</span>
              <span>Local Mailcow (587)</span>
            </button>
            <button type="button" onclick="setSmtpPreset('gmail')" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">
              <span class="material-symbols-rounded text-sm text-emerald-500 shrink-0" aria-hidden="true">mail</span>
              <span>Gmail (587)</span>
            </button>
            <button type="button" onclick="setSmtpPreset('sendgrid')" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">
              <span class="material-symbols-rounded text-sm text-emerald-500 shrink-0" aria-hidden="true">send</span>
              <span>SendGrid (587)</span>
            </button>
            <button type="button" onclick="setSmtpPreset('mock')" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">
              <span class="material-symbols-rounded text-sm text-emerald-500 shrink-0" aria-hidden="true">terminal</span>
              <span>Local Dev Mock</span>
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="smtp_from_name">Sender Display Name</label>
              <input type="text" id="smtp_from_name" name="smtp_from_name" value="<%= settings.smtp_from_name || 'Embedded India' %>" placeholder="Embedded India" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 text-xs">
            </div>
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="smtp_from_email">Sender Email Address (Envelope From)</label>
              <input type="email" id="smtp_from_email" name="smtp_from_email" value="<%= settings.smtp_from_email || 'info@embeddedindia.in' %>" placeholder="info@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="sm:col-span-2">
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="smtp_host">SMTP Host</label>
              <input type="text" id="smtp_host" name="smtp_host" value="<%= settings.smtp_host || '' %>" placeholder="smtp.gmail.com" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
            </div>
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="smtp_port">SMTP Port</label>
              <input type="number" id="smtp_port" name="smtp_port" value="<%= settings.smtp_port || '587' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="smtp_secure">TLS / SSL Mode</label>
              <select id="smtp_secure" name="smtp_secure" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-semibold">
                <option value="false" <%= settings.smtp_secure !== 'true' ? 'selected' : '' %>>STARTTLS (Port 587 - Default)</option>
                <option value="true" <%= settings.smtp_secure === 'true' ? 'selected' : '' %>>SSL / TLS (Port 465)</option>
              </select>
            </div>
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="smtp_user">SMTP Username / Email</label>
              <input type="text" id="smtp_user" name="smtp_user" value="<%= settings.smtp_user || '' %>" placeholder="info@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
            </div>
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="smtp_pass">SMTP Password / App Secret</label>
              <div class="relative flex items-center">
                <input type="password" id="smtp_pass" name="smtp_pass" value="<%= settings.smtp_pass || '' %>" placeholder="••••••••••••" class="w-full pl-3 pr-10 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
                <%- include('../password-toggle-btn', { targetId: 'smtp_pass' }) %>
              </div>
            </div>
          </div>
        </div>


</div>
<!-- Test SMTP Dispatch Box -->
        <div class="settings-panel p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h3 class="settings-panel-title">Test email delivery</h3>
              <span class="text-[11px] text-slate-500">Test socket TLS handshake and verify direct delivery</span>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <input type="email" id="smtpTestRecipient" aria-label="Test email recipient" placeholder="info@embeddedindia.in" value="info@embeddedindia.in" class="flex-1 min-w-0 sm:w-52 px-3 py-1.5 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
              <button type="button" id="btnTestSmtp" class="settings-button py-1.5 px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs transition duration-200 active:scale-95 cursor-pointer flex-shrink-0 inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-brand-600 dark:text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                <span class="text-xs font-bold tracking-tight whitespace-nowrap leading-tight">Test SMTP</span>
              </button>
            </div>
          </div>
          <div id="smtpTestResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>
        </div>

        <div class="settings-module-footer">
          <%- include('../module-save-button', { label: "Save SMTP & Routing" }) %>
        </div>
      </form>
    </section>
