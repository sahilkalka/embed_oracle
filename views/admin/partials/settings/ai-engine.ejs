<%
// Tolerate old Passenger workers while an extracted release awaits restart.
const storedAi = locals.settings || {};
const schedulerView = locals.schedulerSettings || {
  enabled: ['true', '1'].includes(storedAi.ai_auto_gen_enabled),
  frequency: storedAi.ai_auto_gen_frequency || 'daily',
  maxPosts: parseInt(storedAi.ai_auto_gen_max_posts, 10) || 100,
  lastRun: storedAi.ai_auto_gen_last_run ? new Date(storedAi.ai_auto_gen_last_run) : null,
  rawTopics: storedAi.ai_auto_gen_topics || '',
  statusMode: storedAi.ai_auto_gen_status || 'published'
};
const totalPostCount = Number.isFinite(Number(locals.totalPosts)) ? Number(locals.totalPosts) : 0;
const currentTemp = parseFloat(settings.ai_temperature ?? 0.7);
const tempNumeric = Number.isFinite(currentTemp) ? currentTemp.toFixed(1) : '0.7';
const tempDescriptor = parseFloat(tempNumeric) <= 0.3 ? 'Strict / Deterministic' : (parseFloat(tempNumeric) >= 0.8 ? 'Creative / Exploratory' : 'Balanced Technical');
const initialTopicsList = (schedulerView.rawTopics || '')
  .split('\n')
  .map(t => t.trim())
  .filter(Boolean);
%>
<section id="ai-engine" aria-labelledby="ai-engine-title" class="settings-section">

  <%- include('../settings-module-header', {
    "sectionId": "ai-engine",
    "title": "AI Engine",
    "icon": "lightbulb",
    "description": "Configure model credentials, draft technical articles, and manage automated scheduled publishing.",
    "saveLabel": "Save Changes",
    "formId": "aiConfigForm"
  }) %>

  <% if (locals.saved) { %>
    <div class="p-3.5 rounded-xl bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 text-xs font-bold flex items-center space-x-2 shadow-sm">
      <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
      <span>AI configuration settings saved and activated successfully!</span>
    </div>
  <% } %>

  <!-- Unified AI Engine Form (Credentials + Scheduler Pipeline) -->
  <form id="aiConfigForm" action="/admin/ai" method="POST" class="space-y-6">
    <%- typeof csrfField !== 'undefined' ? csrfField : '' %>

    <!-- ============================================================== -->
    <!-- SECTION 1: PROVIDER & MODEL CREDENTIALS                        -->
    <!-- ============================================================== -->
    <div class="settings-panel bg-white dark:bg-[#111e26] rounded-2xl p-6 border border-slate-200 dark:border-[#1c2e38] space-y-5 shadow-sm">
      <!-- Card Header + Aligned Provider Docs Links -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-[#1c2e38] pb-3.5 gap-2">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 tracking-tight">Provider &amp; Model Credentials</h3>
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38]">Supports Cloud &amp; Local LLMs</span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Define runtime endpoint tokens, identifiers, and generation hyper-parameters.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
          <span class="text-slate-400 dark:text-slate-500 font-medium">Get API credentials:</span>
          <a href="https://build.nvidia.com" target="_blank" rel="noopener" class="hover:text-emerald-700 dark:hover:text-emerald-300 hover:underline inline-flex items-center gap-0.5">NVIDIA NIM (Free Credits) <span>&nearr;</span></a>
          <span class="text-slate-300 dark:text-slate-700">&middot;</span>
          <a href="https://aistudio.google.com" target="_blank" rel="noopener" class="hover:text-emerald-700 dark:hover:text-emerald-300 hover:underline inline-flex items-center gap-0.5">Google AI Studio <span>&nearr;</span></a>
          <span class="text-slate-300 dark:text-slate-700">&middot;</span>
          <a href="https://platform.openai.com" target="_blank" rel="noopener" class="hover:text-emerald-700 dark:hover:text-emerald-300 hover:underline inline-flex items-center gap-0.5">OpenAI Platform <span>&nearr;</span></a>
        </div>
      </div>

      <!-- 4-Card Provider Radio Selector Grid -->
      <div>
        <p id="ai-provider-label" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Select AI Model Provider</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3" id="providerCards" role="radiogroup" aria-labelledby="ai-provider-label">
          <% const activeProvider = settings.ai_provider || 'nvidia'; %>
          <label class="provider-card cursor-pointer border p-3.5 rounded-xl flex flex-col justify-between text-left transition-all <%= activeProvider === 'nvidia' ? 'border-emerald-500 bg-emerald-50/70 dark:bg-emerald-500/10 ring-1 ring-emerald-500' : 'border-slate-200 dark:border-[#1c2e38] bg-white dark:bg-[#0c161c] hover:border-slate-300 dark:hover:border-slate-600' %>">
            <input type="radio" name="ai_provider" value="nvidia" <%= activeProvider === 'nvidia' ? 'checked' : '' %> class="sr-only">
            <div class="flex items-center justify-between w-full mb-1">
              <span class="text-xs font-bold text-slate-900 dark:text-white">NVIDIA NIM</span>
              <svg class="provider-check w-4 h-4 text-emerald-500 dark:text-emerald-400 shrink-0 <%= activeProvider === 'nvidia' ? '' : 'hidden' %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            </div>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">Llama 3.1 70B</span>
          </label>

          <label class="provider-card cursor-pointer border p-3.5 rounded-xl flex flex-col justify-between text-left transition-all <%= activeProvider === 'openai' ? 'border-emerald-500 bg-emerald-50/70 dark:bg-emerald-500/10 ring-1 ring-emerald-500' : 'border-slate-200 dark:border-[#1c2e38] bg-white dark:bg-[#0c161c] hover:border-slate-300 dark:hover:border-slate-600' %>">
            <input type="radio" name="ai_provider" value="openai" <%= activeProvider === 'openai' ? 'checked' : '' %> class="sr-only">
            <div class="flex items-center justify-between w-full mb-1">
              <span class="text-xs font-bold text-slate-900 dark:text-white">OpenAI</span>
              <svg class="provider-check w-4 h-4 text-emerald-500 dark:text-emerald-400 shrink-0 <%= activeProvider === 'openai' ? '' : 'hidden' %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            </div>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">GPT-4o / Mini</span>
          </label>

          <label class="provider-card cursor-pointer border p-3.5 rounded-xl flex flex-col justify-between text-left transition-all <%= activeProvider === 'gemini' ? 'border-emerald-500 bg-emerald-50/70 dark:bg-emerald-500/10 ring-1 ring-emerald-500' : 'border-slate-200 dark:border-[#1c2e38] bg-white dark:bg-[#0c161c] hover:border-slate-300 dark:hover:border-slate-600' %>">
            <input type="radio" name="ai_provider" value="gemini" <%= activeProvider === 'gemini' ? 'checked' : '' %> class="sr-only">
            <div class="flex items-center justify-between w-full mb-1">
              <span class="text-xs font-bold text-slate-900 dark:text-white">Google Gemini</span>
              <svg class="provider-check w-4 h-4 text-emerald-500 dark:text-emerald-400 shrink-0 <%= activeProvider === 'gemini' ? '' : 'hidden' %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            </div>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">Gemini 1.5 / 2.0</span>
          </label>

          <label class="provider-card cursor-pointer border p-3.5 rounded-xl flex flex-col justify-between text-left transition-all <%= activeProvider === 'custom' ? 'border-emerald-500 bg-emerald-50/70 dark:bg-emerald-500/10 ring-1 ring-emerald-500' : 'border-slate-200 dark:border-[#1c2e38] bg-white dark:bg-[#0c161c] hover:border-slate-300 dark:hover:border-slate-600' %>">
            <input type="radio" name="ai_provider" value="custom" <%= activeProvider === 'custom' ? 'checked' : '' %> class="sr-only">
            <div class="flex items-center justify-between w-full mb-1">
              <span class="text-xs font-bold text-slate-900 dark:text-white">Custom / Ollama</span>
              <svg class="provider-check w-4 h-4 text-emerald-500 dark:text-emerald-400 shrink-0 <%= activeProvider === 'custom' ? '' : 'hidden' %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            </div>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">Local / vLLM</span>
          </label>
        </div>
      </div>

      <!-- Balanced 2-Column Credentials & Parameters Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Row 1 Left: API Key Input with Show/Hide Password Toggle -->
        <div>
          <div class="flex items-center justify-between mb-1.5 gap-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300" for="ai_api_key">API Key / Secret Token</label>
            <span class="text-[10px] text-slate-400 truncate">Leave empty or use 'demo-key' for simulation</span>
          </div>
          <div class="flex min-w-0 items-center gap-2">
            <input
              type="password"
              id="ai_api_key"
              name="ai_api_key"
              value="<%= settings.ai_api_key || '' %>"
              placeholder="Enter API key or 'demo-key' for simulation mode"
              class="min-w-0 flex-1 px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-xs font-mono text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-emerald-500 focus:outline-none"
            >
            <button
              type="button"
              id="btnToggleApiKey"
              aria-label="Toggle API key visibility"
              title="Toggle API key visibility"
              class="min-h-10 min-w-10 shrink-0 rounded-lg border border-slate-200 dark:border-[#1c2e38] text-slate-500 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white inline-flex items-center justify-center transition"
            >
              <svg id="iconApiKeyShow" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="iconApiKeyHide" class="w-4 h-4 shrink-0 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              <span id="labelApiKeyToggle" class="sr-only">Show</span>
            </button>
          </div>
        </div>

        <!-- Row 1 Right: Model Identifier -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="ai_model">Model Identifier</label>
          <input
            type="text"
            id="ai_model"
            name="ai_model"
            value="<%= settings.ai_model || 'meta/llama-3.1-70b-instruct' %>"
            placeholder="meta/llama-3.1-70b-instruct, gpt-4o-mini, gemini-1.5-flash"
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-xs font-mono font-semibold text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-emerald-500 focus:outline-none"
          >
        </div>

        <!-- Row 2 Left: Custom API Base URL -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="ai_base_url">Custom API Base URL <span class="text-slate-400 font-normal">(Optional)</span></label>
          <input
            type="text"
            id="ai_base_url"
            name="ai_base_url"
            value="<%= settings.ai_base_url || '' %>"
            placeholder="https://integrate.api.nvidia.com/v1 or http://localhost:11434/v1"
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-xs font-mono text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-emerald-500 focus:outline-none"
          >
        </div>

        <!-- Row 2 Right: Temperature Slider with Dynamic Label Display (0.0 strict to 1.0 creative) -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-semibold text-slate-700 dark:text-slate-300" for="ai-temperature">Temperature (Creativity)</label>
            <span id="aiTemperatureDisplay" class="text-[11px] font-mono font-bold text-emerald-600 dark:text-emerald-400">
              <%= tempNumeric %>
            </span>
          </div>
          <div class="flex items-center gap-3 py-1.5">
            <span class="text-[10px] font-mono text-slate-400 leading-tight shrink-0">0.0<br>(Strict)</span>
            <input
              id="ai-temperature"
              type="range"
              step="0.1"
              min="0"
              max="1"
              name="ai_temperature"
              value="<%= tempNumeric %>"
              class="w-full h-1.5 bg-slate-200 dark:bg-[#1c2e38] rounded-lg appearance-none cursor-pointer accent-emerald-600"
            >
            <span class="text-[10px] font-mono text-slate-400 leading-tight text-right shrink-0">1.0<br>(Creative)</span>
          </div>
        </div>
      </div>

      <!-- Test Result Box -->
      <div id="aiTestResult" class="ai-connection-result hidden" role="status" aria-live="polite" aria-atomic="true"></div>

      <!-- Right-Aligned Footer Bar within Card -->
      <div class="pt-3.5 border-t border-slate-100 dark:border-[#1c2e38] flex flex-wrap items-center justify-end gap-2.5">
        <button type="button" id="btnTestAi" class="px-4 py-2 bg-white dark:bg-[#0c161c] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-[#1c2e38] text-xs font-semibold rounded-lg transition inline-flex items-center justify-center gap-2 active:scale-95">
          <svg class="w-3.5 h-3.5 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <span>Test AI Model Connection</span>
        </button>
        <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg text-xs transition shadow-sm inline-flex items-center justify-center gap-2 active:scale-95">
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Save AI Configuration</span>
        </button>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- SECTION 2: TECHNICAL ARTICLE DRAFTING (WORKBENCH)              -->
    <!-- ============================================================== -->
    <div class="settings-panel bg-white dark:bg-[#111e26] rounded-2xl p-6 border border-slate-200 dark:border-[#1c2e38] space-y-5 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-[#1c2e38] pb-3.5 gap-2">
        <div>
          <div class="flex items-center gap-2.5 flex-wrap">
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 tracking-tight">Technical Article Drafting</h3>
            <span class="drafting-status shrink-0 whitespace-nowrap text-[10px] bg-emerald-50 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/30 font-bold px-2 py-0.5 rounded uppercase tracking-wider inline-flex items-center gap-1">
              <span>LIVE DRAFTING</span>
            </span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Produces in-depth embedded engineering guides with code snippets, schematics, and DFM rules.</p>
        </div>
      </div>

      <div class="space-y-4">
        <!-- Topic Input + Suggest Topics Button -->
        <div>
          <div class="flex items-center justify-between mb-1.5 gap-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300" for="aiTopic">Technical Article Topic / Prompt</label>
            <button
              type="button"
              id="btnRandomTopic"
              class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition whitespace-nowrap inline-flex items-center gap-1"
              title="Suggest trending topics via AI Agent"
            >
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
              <span>Suggest Topics</span>
            </button>
          </div>
          <textarea
            id="aiTopic"
            rows="2"
            placeholder="e.g. Design Considerations for Multi-Layer High-Speed DDR4 Routing on STM32MP157"
            class="w-full px-3.5 py-2.5 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 font-medium focus:border-emerald-500 focus:outline-none"
          ></textarea>
          <!-- Topic suggestions chip container -->
          <div id="aiTopicChips" class="mt-2.5 flex flex-wrap gap-1.5 hidden"></div>
        </div>

        <!-- Target Category & Target Audience Profile -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="aiCategory">Target Category</label>
            <select id="aiCategory" class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-slate-900 dark:text-white text-xs font-medium focus:border-emerald-500 focus:outline-none">
              <option value="Embedded Electronics">Embedded Electronics</option>
              <option value="Guides">Guides</option>
              <option value="Troubleshooting">Troubleshooting</option>
              <option value="Industry Info">Industry Info</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="aiAudience">Target Audience Profile</label>
            <input
              type="text"
              id="aiAudience"
              value="Hardware Layout Specialists &amp; Firmware Engineers"
              class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-slate-900 dark:text-white text-xs font-medium focus:border-emerald-500 focus:outline-none"
            >
          </div>
        </div>

        <!-- Workbench Action Footer -->
        <div class="pt-3.5 border-t border-slate-100 dark:border-[#1c2e38] flex flex-wrap items-center justify-end gap-2.5">
          <button type="button" id="btnGenerateOutline" class="px-4 py-2 bg-white dark:bg-[#0c161c] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-[#1c2e38] font-semibold rounded-lg text-xs transition inline-flex items-center gap-2 active:scale-95">
            <svg class="w-3.5 h-3.5 text-slate-500 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Generate Technical Outline &rarr;</span>
          </button>
          <button type="button" id="btnGenerateArticle" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg text-xs transition shadow-sm inline-flex items-center gap-2 active:scale-95">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <span>Generate Technical Article Now &rarr;</span>
          </button>
        </div>

        <div id="aiGenStatus" class="hidden p-3.5 rounded-xl text-xs font-mono"></div>

        <!-- Outline Output Container -->
        <div id="aiOutlineBox" class="hidden p-4 rounded-xl border border-[#1c2e38] bg-[#0c161c] space-y-3">
          <div class="flex items-center justify-between border-b border-[#1c2e38] pb-2">
            <div class="font-bold text-xs text-white flex items-center space-x-2">
              <span>Generated Technical Outline</span>
              <span id="aiOutlineSourceBadge" class="text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"></span>
            </div>
            <button type="button" id="btnCopyOutline" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#111e26] border border-[#1c2e38] text-[11px] font-bold text-emerald-400 hover:text-emerald-300">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy Markdown</span>
            </button>
          </div>
          <div class="text-xs font-semibold text-slate-200" id="aiOutlineTitle"></div>
          <div class="text-[11px] text-slate-400 italic" id="aiOutlineSummary"></div>
          <pre id="aiOutlineContent" class="text-xs font-mono text-slate-200 bg-[#070e12] p-3 rounded-lg border border-[#1c2e38] overflow-x-auto max-h-64 whitespace-pre-wrap"></pre>
          <div class="pt-2 flex items-center gap-3">
            <a id="btnOutlineCreatePost" href="/admin/posts/new" class="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 text-xs font-bold rounded-lg transition shadow">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              <span>Open in CMS Editor &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- SECTION 3: SCHEDULED PUBLISHING PIPELINE & QUEUE               -->
    <!-- ============================================================== -->
    <div class="settings-panel bg-white dark:bg-[#111e26] rounded-2xl p-6 border border-slate-200 dark:border-[#1c2e38] space-y-5 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between border-b border-slate-100 dark:border-[#1c2e38] pb-3.5 gap-3">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 tracking-tight">Scheduled Publishing Pipeline &amp; Queue</h3>
            <span class="scheduler-status shrink-0 whitespace-nowrap px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider <%= schedulerView.enabled ? 'bg-emerald-50 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/30' : 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-[#1c2e38]' %>">
              <%= schedulerView.enabled ? '● Active' : '○ Paused' %>
            </span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
            Automated background synthesis and publishing of engineering articles from your prioritized topic queue.
          </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button type="button" id="btnRunSchedulerNow" class="px-3.5 py-2 bg-white dark:bg-[#0c161c] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-[#1c2e38] rounded-lg text-xs font-semibold transition inline-flex items-center gap-1.5 active:scale-95">
            <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>Run Auto-Generation Now</span>
          </button>
        </div>
      </div>

      <!-- 3 KPI Metric Cards (Top) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- KPI 1: Total Blog Pages in CMS -->
        <div class="p-3.5 rounded-xl bg-slate-50/70 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38]">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 dark:text-slate-400">Total Blog Pages in CMS</span>
            <span class="text-[10px] font-mono font-bold text-emerald-600 dark:text-emerald-400"><%= Math.min(100, Math.round((totalPostCount / (schedulerView.maxPosts || 100)) * 100)) %>%</span>
          </div>
          <div class="text-base font-black text-slate-900 dark:text-white mt-1 font-mono">
            <%= totalPostCount %> <span class="text-xs font-normal text-slate-500 dark:text-slate-400">/ max <%= schedulerView.maxPosts %></span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-[#1c2e38] h-1.5 rounded-full mt-2.5 overflow-hidden">
            <div class="bg-emerald-500 h-full rounded-full transition-all" style="width: <%= Math.min(100, Math.round((totalPostCount / (schedulerView.maxPosts || 100)) * 100)) %>%"></div>
          </div>
        </div>

        <!-- KPI 2: Current Frequency -->
        <div class="p-3.5 rounded-xl bg-slate-50/70 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38]">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 dark:text-slate-400">Current Frequency</span>
            <span class="text-[10px] font-mono text-slate-500 dark:text-slate-400">CRON: */15 * * * *</span>
          </div>
          <div class="text-sm font-bold text-slate-900 dark:text-white mt-1 capitalize flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span><%= schedulerView.frequency.replace(/_/g, ' ') %></span>
          </div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-1.5">Background daemon checks queue every 15m</div>
        </div>

        <!-- KPI 3: Last Auto-Generated Article -->
        <div class="p-3.5 rounded-xl bg-slate-50/70 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38]">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 dark:text-slate-400">Last Auto-Generated Article</span>
            <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase <%= schedulerView.lastRun ? 'bg-emerald-50 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-300' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400' %>">
              <%= schedulerView.lastRun ? schedulerView.statusMode : 'Idle' %>
            </span>
          </div>
          <div class="text-xs font-bold text-slate-900 dark:text-white mt-1.5 truncate font-mono">
            <%= schedulerView.lastRun ? new Date(schedulerView.lastRun).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Never executed' %>
          </div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-1.5">Target mode: <span class="text-slate-700 dark:text-slate-200 font-semibold capitalize"><%= schedulerView.statusMode %></span></div>
        </div>
      </div>

      <!-- Scheduler Config Row -->
      <div class="space-y-4">
        <!-- Enable Automated Scheduled Blog Generation Toggle -->
        <div class="flex items-start sm:items-center justify-between p-3.5 rounded-xl bg-slate-50/70 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38]">
          <div>
            <div class="text-xs font-bold text-slate-900 dark:text-white">Enable Automated Scheduled Blog Generation</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">When turned on, the system synthesizes articles and adds them to the CMS at your specified frequency until max limit is reached.</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer ml-4 shrink-0">
            <input type="checkbox" id="ai_auto_gen_enabled" aria-label="Enable automatic article generation" name="ai_auto_gen_enabled" value="true" <%= schedulerView.enabled ? 'checked' : '' %> class="sr-only peer">
            <div class="w-10 h-5 bg-slate-300 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>

        <!-- 3-Column Input Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Col 1: Generation Frequency -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="ai-engine-ai_auto_gen_frequency">
              Generation Frequency
            </label>
            <select id="ai-engine-ai_auto_gen_frequency" aria-label="Generation frequency" name="ai_auto_gen_frequency" class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-xs font-semibold text-slate-900 dark:text-white focus:border-emerald-500 focus:outline-none">
              <option value="hourly" <%= schedulerView.frequency === 'hourly' ? 'selected' : '' %>>Every 1 Hour</option>
              <option value="every_6_hours" <%= schedulerView.frequency === 'every_6_hours' ? 'selected' : '' %>>Every 6 Hours (4 / day)</option>
              <option value="every_12_hours" <%= schedulerView.frequency === 'every_12_hours' ? 'selected' : '' %>>Every 12 Hours (2 / day)</option>
              <option value="daily" <%= schedulerView.frequency === 'daily' ? 'selected' : '' %>>Daily (1 article / day - Recommended)</option>
              <option value="every_2_days" <%= schedulerView.frequency === 'every_2_days' ? 'selected' : '' %>>Every 2 Days</option>
              <option value="weekly" <%= schedulerView.frequency === 'weekly' ? 'selected' : '' %>>Weekly (1 / week)</option>
            </select>
          </div>

          <!-- Col 2: Max Blog Pages Allowed -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="ai-engine-ai_auto_gen_max_posts">
              Max Blog Pages Allowed
            </label>
            <input
              id="ai-engine-ai_auto_gen_max_posts"
              type="number"
              name="ai_auto_gen_max_posts"
              aria-label="Maximum blog pages allowed"
              min="1"
              max="10000"
              value="<%= schedulerView.maxPosts %>"
              class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-xs font-mono font-semibold text-slate-900 dark:text-white focus:border-emerald-500 focus:outline-none"
            >
          </div>

          <!-- Col 3: Auto-Generated Status -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="ai-engine-ai_auto_gen_status">
              Auto-Generated Status
            </label>
            <select id="ai-engine-ai_auto_gen_status" aria-label="Auto-generated article status" name="ai_auto_gen_status" class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-xs font-semibold text-slate-900 dark:text-white focus:border-emerald-500 focus:outline-none">
              <option value="published" <%= schedulerView.statusMode === 'published' ? 'selected' : '' %>>Published (Live Immediately)</option>
              <option value="scheduled" <%= schedulerView.statusMode === 'scheduled' ? 'selected' : '' %>>Scheduled (Queued Release)</option>
              <option value="draft" <%= schedulerView.statusMode === 'draft' ? 'selected' : '' %>>Draft (Requires Manual Approval)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Structured Topic Queue Table -->
      <div class="space-y-3 pt-2">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <label class="block text-xs font-bold text-slate-800 dark:text-slate-200" for="newQueueTopicInput">
              Topic &amp; Keyword Queue <span id="topicQueueCountBadge" class="sr-only"><%= initialTopicsList.length %> queued</span>
            </label>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">The automated engine cycles through these topics in order.</p>
          </div>

          <div class="flex items-center gap-2">
            <button type="button" id="btnPopulateDefaultTopics" class="px-3 py-1.5 rounded-lg bg-white dark:bg-[#0c161c] hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-[#1c2e38] text-[11px] font-semibold text-slate-700 dark:text-slate-200 transition inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
              <span>Reset</span>
            </button>
            <button
              type="button"
              id="btnAddQueueTopic"
              class="px-3 py-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-500/15 hover:bg-emerald-100 dark:hover:bg-emerald-500/25 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30 text-[11px] font-semibold transition inline-flex items-center justify-center gap-1.5 whitespace-nowrap"
            >
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>Add Topic</span>
            </button>
          </div>
        </div>

        <!-- Add New Topic Input Row -->
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            type="text"
            id="newQueueTopicInput"
            placeholder="Add a new engineering topic to the publishing queue (e.g. CAN FD Bus Arbitration & Termination Layout)..."
            class="flex-1 px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-[#0c161c] border border-slate-200 dark:border-[#1c2e38] text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-emerald-500 focus:outline-none"
          >
        </div>

        <!-- Hidden synchronized textarea for backend/Prisma compatibility -->
        <textarea
          id="aiSchedulerTopics"
          name="ai_auto_gen_topics"
          rows="4"
          hidden
        ><%= schedulerView.rawTopics %></textarea>

        <!-- Structured Queue Table Container -->
        <div class="rounded-xl border border-slate-200 dark:border-[#1c2e38] bg-white dark:bg-[#0c161c] overflow-hidden">
          <div class="max-h-80 overflow-x-hidden overflow-y-auto">
            <table class="w-full min-w-0 table-fixed text-left border-collapse" id="topicQueueTable">
              <thead class="bg-slate-50 dark:bg-[#091217] border-b border-slate-200 dark:border-[#1c2e38] sticky top-0 z-10">
                <tr class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  <th class="py-2.5 px-2 sm:px-3.5 w-6 sm:w-12">#</th>
                  <th class="py-2.5 px-2 sm:px-3.5 min-w-0">Topic / Title</th>
                  <th class="py-2.5 px-2 sm:px-3.5 w-20 sm:w-36">Status</th>
                  <th class="py-2.5 px-1.5 sm:px-3.5 w-20 sm:w-44 text-center sm:text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="topicQueueTableBody" class="divide-y divide-slate-100 dark:divide-[#1c2e38] text-xs">
                <% if (initialTopicsList.length === 0) { %>
                  <tr>
                    <td colspan="4" class="py-6 px-4 text-center text-slate-400 text-xs">
                      No topics currently in queue. Click <strong>Add Topic</strong> or <strong>Reset</strong>.
                    </td>
                  </tr>
                <% } else { %>
                  <% initialTopicsList.forEach((topicItem, idx) => { %>
                    <tr class="hover:bg-slate-50 dark:hover:bg-[#111e26]/60 transition group" data-topic-index="<%= idx %>">
                      <td class="py-3 px-2 sm:px-3.5 font-mono text-[11px] text-slate-400"><%= String(idx + 1).padStart(2, '0') %></td>
                      <td class="py-3 px-2 sm:px-3.5 min-w-0 text-slate-800 dark:text-slate-100 font-semibold leading-snug break-words [overflow-wrap:anywhere]"><%= topicItem %></td>
                      <td class="py-3 px-2 sm:px-3.5 min-w-0">
                        <% if (idx === 0) { %>
                          <span class="inline-flex max-w-full items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded-full text-[9px] sm:text-[10px] text-center leading-tight font-bold bg-emerald-50 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/30 whitespace-normal">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
                            Next in Cycle
                          </span>
                        <% } else { %>
                          <span class="inline-flex max-w-full items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded-full text-[9px] sm:text-[10px] text-center leading-tight font-semibold bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-[#1c2e38] whitespace-normal">
                            Queued
                          </span>
                        <% } %>
                      </td>
                      <td class="py-3 px-1.5 sm:px-3.5 text-center sm:text-right">
                        <div class="flex items-center justify-center sm:justify-end gap-1">
                          <button type="button" title="Edit topic" aria-label="Edit topic" data-queue-action="edit" data-index="<%= idx %>" class="w-8 h-8 sm:w-auto sm:h-auto p-0 sm:px-2 sm:py-1 rounded-lg bg-white dark:bg-[#111e26] hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-[#1c2e38] text-[10px] font-semibold inline-flex items-center justify-center gap-1 transition">
                            <svg class="w-3 h-3 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            <span class="hidden sm:inline">Edit</span>
                          </button>
                          <button type="button" title="Remove topic" aria-label="Remove topic" data-queue-action="remove" data-index="<%= idx %>" class="w-8 h-8 sm:w-auto sm:h-auto p-0 sm:px-2 sm:py-1 rounded-lg bg-white dark:bg-[#111e26] hover:bg-red-50 dark:hover:bg-red-950/60 text-slate-600 dark:text-slate-300 hover:text-red-600 dark:hover:text-red-300 border border-slate-200 dark:border-[#1c2e38] text-[10px] font-semibold inline-flex items-center justify-center gap-1 transition">
                            <svg class="w-3 h-3 text-red-500 dark:text-red-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            <span class="hidden sm:inline">Remove</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Scheduler Run-Now Status Box -->
      <div id="schedulerRunStatus" class="hidden p-3.5 rounded-xl text-xs font-mono"></div>

      <!-- Save & Trigger Button Bar -->
      <div class="pt-4 border-t border-slate-100 dark:border-[#1c2e38] flex flex-col sm:flex-row items-center justify-between gap-3">
        <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 text-center sm:text-left">Settings are persisted in database and active across server reboots.</span>
        <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg text-xs transition shadow-sm inline-flex items-center justify-center gap-2 active:scale-95">
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Save Scheduler Settings</span>
        </button>
      </div>
    </div>
  </form>

</section>
