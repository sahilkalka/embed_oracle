<%
  const _btnClass = typeof buttonClass !== 'undefined' && buttonClass
    ? buttonClass
    : 'absolute inset-y-0 right-0 flex items-center justify-center px-3 text-slate-400 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-r-xl transition cursor-pointer';
  const _iconClass = typeof iconClass !== 'undefined' && iconClass ? iconClass : 'w-4 h-4 shrink-0';
%>
<button
  type="button"
  data-password-toggle="<%= targetId %>"
  aria-label="Show password"
  aria-pressed="false"
  title="Show password"
  class="<%= _btnClass %>"
>
  <svg data-password-icon="show" class="<%= _iconClass %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
    <circle cx="12" cy="12" r="3"/>
  </svg>
  <svg data-password-icon="hide" class="<%= _iconClass %> hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
    <line x1="1" y1="1" x2="23" y2="23"/>
  </svg>
  <span class="sr-only" data-password-label>Show password</span>
</button>
