<div id="<%= sectionId %>-title"
     hidden
     class="settings-module-header sr-only"
     data-section-id="<%= sectionId %>"
     data-section-title="<%= title %>"
     data-section-desc="<%= description %>"
     data-form-id="<%= typeof formId !== 'undefined' && formId ? formId : '' %>"
     data-save-label="<%= typeof saveLabel !== 'undefined' && saveLabel ? saveLabel : 'Save Changes' %>">
  <%= title %>
</div>
