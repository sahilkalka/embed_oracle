<%- include('layout_top', { title: 'Live Traffic & Visitor Telemetry', currentPath: '/admin/traffic' }) %>

<!-- Theme-Integrated Telemetry Header & Action Bar -->
<div class="mb-6 bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-5 sm:p-6 shadow-xs">
  <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2.5 mb-2">
        <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-[11px] font-mono font-bold uppercase tracking-wider">
          <span id="sseStatusDot" class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
          <span id="sseStatusLabel">SSE STREAM LIVE</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-700 dark:text-cyan-400 text-[11px] font-mono font-bold uppercase tracking-wider">
          <svg class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/></svg>
          <span>5-MIN SLIDING WINDOW</span>
        </span>
        <span id="lastHeartbeatBadge" class="text-[11px] font-mono text-slate-500 dark:text-slate-400">
          SYNC: <%= new Date().toISOString().slice(11, 19) %> UTC
        </span>
      </div>
      <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2.5">
        <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
        </svg>
        <span>Real-Time Traffic &amp; Visitor Telemetry</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
        Salted SHA-256 edge session tracking, geographic node distribution, client architecture, and live request wire log.
      </p>
    </div>

    <!-- Action Bar Controls (Unified Theme-Aware Icon Buttons) -->
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <!-- Date / Window Range Selector -->
      <div class="inline-flex items-center bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80 rounded-xl p-1 gap-1" role="group" aria-label="Telemetry time range">
        <% const ranges = [
          { key: '1h', label: '1H' },
          { key: '24h', label: '24H' },
          { key: '7d', label: '7D' },
          { key: '30d', label: '30D' }
        ]; %>
        <% ranges.forEach(r => { %>
          <a href="/admin/traffic?range=<%= r.key %><%= routeFilter ? '&route=' + encodeURIComponent(routeFilter) : '' %>"
             class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-mono font-bold uppercase tracking-wider transition-colors <%= selectedRange === r.key ? 'bg-white dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 shadow-2xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-white/60 dark:hover:bg-slate-800 border border-transparent' %>">
            <svg class="w-3.5 h-3.5 shrink-0 <%= selectedRange === r.key ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-400' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span><%= r.label %></span>
          </a>
        <% }) %>
      </div>

      <!-- Pause / Resume Stream Button -->
      <button type="button" id="btnPauseStream"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-colors cursor-pointer">
        <svg id="iconPauseStream" class="w-4 h-4 text-cyan-600 dark:text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
        </svg>
        <span id="labelPauseStream">Pause Stream</span>
      </button>

      <!-- Live Sync / Refresh Button -->
      <a href="/admin/traffic?range=<%= selectedRange %><%= routeFilter ? '&route=' + encodeURIComponent(routeFilter) : '' %>"
         class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-colors">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10"></polyline>
          <polyline points="1 20 1 14 7 14"></polyline>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
        </svg>
        <span>Live Sync</span>
      </a>

      <!-- Export CSV Button -->
      <a href="/admin/traffic/export"
         class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-bold transition-colors">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Export CSV</span>
      </a>

      <!-- Clear Wire Log Button -->
      <form action="/admin/traffic/clear" method="POST" class="inline" onsubmit="return confirm('Clear in-memory wire log entries?');">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button type="submit"
                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-bold transition-colors cursor-pointer">
          <svg class="w-4 h-4 text-rose-600 dark:text-rose-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            <line x1="10" y1="11" x2="10" y2="17"></line>
            <line x1="14" y1="11" x2="14" y2="17"></line>
          </svg>
          <span>Clear Log</span>
        </button>
      </form>
    </div>
  </div>
</div>

<!-- 4 KPI Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
  <!-- KPI 1: Active Sessions Now -->
  <div class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-5 shadow-xs flex flex-col justify-between">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Active Sessions Now</span>
      <span class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
        </svg>
      </span>
    </div>
    <div class="flex items-baseline gap-2.5">
      <span id="liveActiveCount" class="text-3xl font-black font-mono text-emerald-600 dark:text-emerald-400 transition-transform duration-200"><%= telemetry.activeCount %></span>
      <span class="text-xs font-mono font-bold text-emerald-600/80 dark:text-emerald-400/80 uppercase">Concurrent</span>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-mono">
      Active within last 300s window
    </p>
  </div>

  <!-- KPI 2: Total Visits Today vs Unique Visitor Hashes -->
  <div class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-5 shadow-xs flex flex-col justify-between">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Visits vs Unique Hashes</span>
      <span class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/25 flex items-center justify-center text-cyan-600 dark:text-cyan-400 shrink-0">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </span>
    </div>
    <div class="flex items-baseline gap-2">
      <span id="kpiTotalVisits" class="text-3xl font-black font-mono text-slate-900 dark:text-white"><%= telemetry.totalVisitsToday %></span>
      <span class="text-xs font-mono text-slate-400">/</span>
      <span id="kpiUniqueHashes" class="text-base font-mono font-bold text-cyan-600 dark:text-cyan-400 whitespace-nowrap"><%= telemetry.uniqueVisitors %> uniq</span>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-mono">
      SHA-256 salted IP anonymization
    </p>
  </div>

  <!-- KPI 3: Top Traffic Referrer -->
  <div class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-5 shadow-xs flex flex-col justify-between">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Top Traffic Referrer</span>
      <span class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/25 flex items-center justify-center text-indigo-600 dark:text-indigo-400 shrink-0">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </span>
    </div>
    <div class="flex items-center justify-between gap-2 min-w-0">
      <span class="text-lg font-black font-mono text-slate-900 dark:text-white truncate min-w-0" title="<%= telemetry.topReferrer.source %>"><%= telemetry.topReferrer.source %></span>
      <span class="px-2 py-0.5 rounded-md bg-indigo-500/10 border border-indigo-500/25 text-indigo-700 dark:text-indigo-300 text-xs font-mono font-bold shrink-0 whitespace-nowrap"><%= telemetry.topReferrer.share %>%</span>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-mono">
      <%= telemetry.topReferrer.count %> inbound hits in window
    </p>
  </div>

  <!-- KPI 4: Peak Traffic Tool -->
  <div class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-5 shadow-xs flex flex-col justify-between">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Peak Traffic Tool</span>
      <span class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-center justify-center text-amber-600 dark:text-amber-400 shrink-0">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
          <rect x="9" y="9" width="6" height="6"></rect>
          <line x1="9" y1="1" x2="9" y2="4"></line>
          <line x1="15" y1="1" x2="15" y2="4"></line>
          <line x1="9" y1="20" x2="9" y2="23"></line>
          <line x1="15" y1="20" x2="15" y2="23"></line>
          <line x1="20" y1="9" x2="23" y2="9"></line>
          <line x1="20" y1="14" x2="23" y2="14"></line>
          <line x1="1" y1="9" x2="4" y2="9"></line>
          <line x1="1" y1="14" x2="4" y2="14"></line>
        </svg>
      </span>
    </div>
    <div class="flex items-center justify-between gap-2 min-w-0">
      <span class="text-base font-black font-mono text-emerald-700 dark:text-emerald-400 truncate min-w-0" title="<%= telemetry.peakTool.name %>"><%= telemetry.peakTool.name %></span>
      <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-300 text-xs font-mono font-bold shrink-0 whitespace-nowrap"><%= telemetry.peakTool.hits %> runs</span>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-mono truncate">
      IPC-2221 vs UART vs Battery vs Blog
    </p>
  </div>
</div>

<!-- 3 Breakdown Grids -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  <!-- Grid 1: Top 10 Requested Routes with Pageview Meters -->
  <div class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-5 shadow-xs flex flex-col">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100 dark:border-brand-border">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
        </svg>
        <h2 class="text-xs sm:text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white">Top 10 Requested Routes</h2>
      </div>
      <span class="text-[10px] font-mono font-bold text-slate-400">PAGEVIEW METER</span>
    </div>

    <div class="space-y-3 flex-1">
      <% if (telemetry.topRoutes && telemetry.topRoutes.length > 0) { %>
        <% telemetry.topRoutes.forEach(item => { %>
          <div class="group">
            <div class="flex items-center justify-between gap-2 text-xs font-mono mb-1">
              <a href="/admin/traffic?range=<%= selectedRange %>&route=<%= encodeURIComponent(item.route) %>"
                 class="text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 truncate max-w-[72%] font-semibold transition-colors"
                 title="Filter wire log by <%= item.route %>">
                <%= item.route %>
              </a>
              <span class="text-emerald-700 dark:text-emerald-400 font-bold shrink-0 whitespace-nowrap"><%= item.count %> <span class="text-slate-400 dark:text-slate-500 font-normal">(<%= item.percent %>%)</span></span>
            </div>
            <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-900 rounded-full overflow-hidden border border-slate-200/70 dark:border-slate-800">
              <div class="h-full bg-gradient-to-r from-emerald-500 to-cyan-400 rounded-full" style="width: <%= Math.max(item.percent, 4) %>%"></div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-xs font-mono text-slate-500 py-6 text-center">No route hits recorded in current window.</p>
      <% } %>
    </div>
  </div>

  <!-- Grid 2: Geographic Distribution -->
  <div class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-5 shadow-xs flex flex-col">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100 dark:border-brand-border">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <h2 class="text-xs sm:text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white">Geographic Distribution</h2>
      </div>
      <span class="text-[10px] font-mono font-bold text-slate-400">GEOIP-LITE NODE</span>
    </div>

    <div class="space-y-2.5 flex-1">
      <% if (telemetry.geoDistribution && telemetry.geoDistribution.length > 0) { %>
        <% telemetry.geoDistribution.forEach(geo => { %>
          <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/70 border border-slate-200/80 dark:border-slate-800/80">
            <div class="flex items-center gap-2 min-w-0">
              <span class="text-base leading-none shrink-0" aria-hidden="true"><%= geo.flag %></span>
              <span class="px-1.5 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800 text-cyan-700 dark:text-cyan-400 text-[11px] font-mono font-bold shrink-0"><%= geo.countryCode %></span>
              <span class="text-xs font-mono font-semibold text-slate-700 dark:text-slate-200 truncate"><%= geo.city %>, <%= geo.country %></span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-400 text-xs font-mono font-bold whitespace-nowrap"><%= geo.count %> hits</span>
              <span class="text-[11px] font-mono text-slate-500 w-9 text-right"><%= geo.percent %>%</span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-xs font-mono text-slate-500 py-6 text-center">No geographic telemetry recorded yet.</p>
      <% } %>
    </div>
  </div>

  <!-- Grid 3: Client Architecture & Top Browsers -->
  <div class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-5 shadow-xs flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100 dark:border-brand-border">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <h2 class="text-xs sm:text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white">Client Architecture</h2>
        </div>
        <span class="text-[10px] font-mono font-bold text-slate-400">UA-PARSER</span>
      </div>

      <!-- Device Ratio Bars -->
      <div class="space-y-3 mb-5">
        <div>
          <div class="flex justify-between text-xs font-mono mb-1">
            <span class="text-slate-700 dark:text-slate-300 font-semibold">Desktop Workstations</span>
            <span class="text-emerald-700 dark:text-emerald-400 font-bold"><%= telemetry.clientArch.desktop.percent %>% (<%= telemetry.clientArch.desktop.count %>)</span>
          </div>
          <div class="w-full h-2 bg-slate-100 dark:bg-slate-900 rounded-full overflow-hidden border border-slate-200/70 dark:border-slate-800">
            <div class="h-full bg-emerald-500 rounded-full" style="width: <%= telemetry.clientArch.desktop.percent %>%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-mono mb-1">
            <span class="text-slate-700 dark:text-slate-300 font-semibold">Mobile / Field Devices</span>
            <span class="text-cyan-700 dark:text-cyan-400 font-bold"><%= telemetry.clientArch.mobile.percent %>% (<%= telemetry.clientArch.mobile.count %>)</span>
          </div>
          <div class="w-full h-2 bg-slate-100 dark:bg-slate-900 rounded-full overflow-hidden border border-slate-200/70 dark:border-slate-800">
            <div class="h-full bg-cyan-400 rounded-full" style="width: <%= telemetry.clientArch.mobile.percent %>%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-mono mb-1">
            <span class="text-slate-700 dark:text-slate-300 font-semibold">Embedded / CLI / Bot Agents</span>
            <span class="text-amber-700 dark:text-amber-400 font-bold"><%= telemetry.clientArch.embeddedBot.percent %>% (<%= telemetry.clientArch.embeddedBot.count %>)</span>
          </div>
          <div class="w-full h-2 bg-slate-100 dark:bg-slate-900 rounded-full overflow-hidden border border-slate-200/70 dark:border-slate-800">
            <div class="h-full bg-amber-400 rounded-full" style="width: <%= telemetry.clientArch.embeddedBot.percent %>%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Browsers Breakdown -->
    <div class="pt-3 border-t border-slate-100 dark:border-brand-border">
      <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5">Top Browsers &amp; Agents</div>
      <div class="grid grid-cols-2 gap-2">
        <% telemetry.clientArch.topBrowsers.forEach(b => { %>
          <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-xs font-mono">
            <span class="text-slate-700 dark:text-slate-300 font-semibold truncate"><%= b.name %></span>
            <span class="text-emerald-700 dark:text-emerald-400 font-bold"><%= b.percent %>%</span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<!-- Live Wire Log Table (Rolling 30 Hits) -->
<div class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl overflow-hidden shadow-xs">
  <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-brand-border flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-ping"></span>
      <h2 class="text-sm sm:text-base font-black uppercase tracking-wider text-slate-900 dark:text-white">Live Wire Log (Last 30 Requests)</h2>
      <% if (routeFilter) { %>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-cyan-500/10 border border-cyan-500/30 text-cyan-700 dark:text-cyan-300 text-xs font-mono font-bold">
          <span>Filter: <%= routeFilter %></span>
        </span>
      <% } %>
    </div>

    <!-- Route Filter Form -->
    <form action="/admin/traffic" method="GET" class="flex flex-wrap items-center gap-2">
      <input type="hidden" name="range" value="<%= selectedRange %>">
      <input type="text" name="route" id="wireRouteFilterInput" value="<%= routeFilter %>"
             placeholder="Filter route (e.g. /tools)"
             class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 text-xs font-mono focus:outline-none focus:border-emerald-500">
      <button type="submit"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition cursor-pointer">
        <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
        </svg>
        <span>Filter</span>
      </button>
      <% if (routeFilter) { %>
        <a href="/admin/traffic?range=<%= selectedRange %>"
           class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white text-xs font-bold transition">
          <svg class="w-3.5 h-3.5 text-rose-500 dark:text-rose-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span>Reset</span>
        </a>
      <% } %>
    </form>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 dark:bg-slate-900/90 border-b border-slate-200 dark:border-slate-800 text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          <th class="py-3 px-4">Time (UTC / IST)</th>
          <th class="py-3 px-4">Visitor Hash</th>
          <th class="py-3 px-4">Page Route</th>
          <th class="py-3 px-4">Location (City, Country)</th>
          <th class="py-3 px-4">Client (OS / Browser)</th>
          <th class="py-3 px-4">Referrer</th>
          <th class="py-3 px-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="liveWireTableBody" class="divide-y divide-slate-100 dark:divide-slate-800/80 text-xs font-mono">
        <% if (telemetry.recentHits && telemetry.recentHits.length > 0) { %>
          <% telemetry.recentHits.forEach(hit => { %>
            <tr data-hit-id="<%= hit.id %>" data-visitor-hash="<%= hit.visitorHash %>" class="hover:bg-slate-50 dark:hover:bg-slate-900/60 transition-colors <%= hit.flagged ? 'bg-rose-50 dark:bg-rose-950/30' : '' %>">
              <td class="py-3 px-4 whitespace-nowrap text-slate-600 dark:text-slate-300">
                <span class="text-emerald-700 dark:text-emerald-400 font-bold"><%= hit.timestamp.slice(11, 19) %></span>
                <span class="text-slate-400 dark:text-slate-500 text-[10px] ml-1">UTC</span>
              </td>
              <td class="py-3 px-4 whitespace-nowrap">
                <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-cyan-700 dark:text-cyan-300 font-semibold" title="Salted SHA-256 Visitor Hash: <%= hit.visitorHash %>">
                  <%= hit.maskedHash %>
                </span>
              </td>
              <td class="py-3 px-4">
                <a href="<%= hit.path %>" target="_blank" rel="noopener" class="text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 font-semibold break-all">
                  <%= hit.route %>
                </a>
              </td>
              <td class="py-3 px-4 whitespace-nowrap text-slate-700 dark:text-slate-300">
                <span class="mr-1"><%= hit.geo.flag %></span>
                <span><%= hit.geo.city %>, <%= hit.geo.countryCode %></span>
              </td>
              <td class="py-3 px-4 whitespace-nowrap">
                <span class="text-slate-700 dark:text-slate-200"><%= hit.client.os %></span>
                <span class="text-slate-400 dark:text-slate-500">·</span>
                <span class="text-cyan-700 dark:text-cyan-400 font-semibold"><%= hit.client.browser %></span>
                <span class="ml-1 px-1.5 py-0.5 rounded text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300"><%= hit.client.deviceType %></span>
              </td>
              <td class="py-3 px-4 whitespace-nowrap text-slate-500 dark:text-slate-400">
                <%= hit.referrer %>
              </td>
              <td class="py-3 px-4 whitespace-nowrap text-right">
                <div class="inline-flex items-center justify-end gap-1.5">
                  <!-- Copy Hash Button -->
                  <button type="button"
                          onclick="copyVisitorHash('<%= hit.visitorHash %>', this)"
                          title="Copy Visitor Hash"
                          aria-label="Copy Visitor Hash"
                          class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 text-[11px] font-mono cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    <span>Hash</span>
                  </button>

                  <!-- Filter Route Button -->
                  <button type="button"
                          onclick="filterByRoute('<%= hit.route %>')"
                          title="Filter by Route"
                          aria-label="Filter by Route"
                          class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:text-cyan-700 dark:hover:text-cyan-400 text-[11px] font-mono cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    <span>Route</span>
                  </button>

                  <!-- Flag / Block IP Hash Button -->
                  <button type="button"
                          onclick="toggleFlagHash('<%= hit.visitorHash %>', this)"
                          title="Flag or Block Visitor Hash"
                          aria-label="Flag or Block Visitor Hash"
                          class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-900 hover:bg-rose-50 dark:hover:bg-rose-950/60 border <%= hit.flagged ? 'border-rose-500/60 text-rose-600 dark:text-rose-400' : 'border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400' %> text-[11px] font-mono cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-rose-500 dark:text-rose-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                    </svg>
                    <span><%= hit.flagged ? 'Flagged' : 'Flag' %></span>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr id="emptyWireRow">
            <td colspan="7" class="py-8 text-center text-slate-500">
              No live wire requests matching current filter. Waiting for incoming telemetry...
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  (function () {
    let streamPaused = false;
    let lastRenderedHitId = null;
    const activeCountEl = document.getElementById('liveActiveCount');
    const totalVisitsEl = document.getElementById('kpiTotalVisits');
    const sseStatusDot = document.getElementById('sseStatusDot');
    const sseStatusLabel = document.getElementById('sseStatusLabel');
    const lastHeartbeatBadge = document.getElementById('lastHeartbeatBadge');
    const wireTableBody = document.getElementById('liveWireTableBody');
    const btnPauseStream = document.getElementById('btnPauseStream');
    const labelPauseStream = document.getElementById('labelPauseStream');
    const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    const firstRow = wireTableBody ? wireTableBody.querySelector('tr[data-hit-id]') : null;
    if (firstRow) {
      lastRenderedHitId = firstRow.getAttribute('data-hit-id');
    }

    if (btnPauseStream) {
      btnPauseStream.addEventListener('click', function () {
        streamPaused = !streamPaused;
        if (streamPaused) {
          labelPauseStream.textContent = 'Resume Stream';
          sseStatusDot.className = 'w-2 h-2 rounded-full bg-amber-400';
          sseStatusLabel.textContent = 'STREAM PAUSED';
        } else {
          labelPauseStream.textContent = 'Pause Stream';
          sseStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
          sseStatusLabel.textContent = 'SSE STREAM LIVE';
        }
      });
    }

    window.copyVisitorHash = function (hash, btn) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(hash);
      }
      const span = btn.querySelector('span');
      if (span) {
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => { span.textContent = orig; }, 1200);
      }
    };

    window.filterByRoute = function (route) {
      const url = new URL(window.location.href);
      url.searchParams.set('route', route);
      window.location.href = url.toString();
    };

    window.toggleFlagHash = async function (visitorHash, btn) {
      try {
        const res = await fetch('/admin/traffic/flag', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'CSRF-Token': csrfToken
          },
          body: JSON.stringify({ visitorHash })
        });
        const data = await res.json();
        if (data && data.success) {
          const span = btn.querySelector('span');
          if (span) span.textContent = data.flagged ? 'Flagged' : 'Flag';
          const row = btn.closest('tr');
          if (row) {
            row.classList.toggle('bg-rose-950/30', Boolean(data.flagged));
          }
        }
      } catch (_) {}
    };

    function escapeHtml(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function prependWireHit(hit) {
      if (!wireTableBody || !hit || !hit.id) return;
      if (hit.id === lastRenderedHitId) return;
      if (wireTableBody.querySelector('tr[data-hit-id="' + hit.id + '"]')) return;

      lastRenderedHitId = hit.id;

      const emptyRow = document.getElementById('emptyWireRow');
      if (emptyRow) emptyRow.remove();

      const timeStr = (hit.timestamp || new Date().toISOString()).slice(11, 19);
      const tr = document.createElement('tr');
      tr.setAttribute('data-hit-id', hit.id);
      tr.setAttribute('data-visitor-hash', hit.visitorHash);
      tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-900/60 transition-colors bg-emerald-50/70 dark:bg-emerald-950/20';

      tr.innerHTML =
        '<td class="py-3 px-4 whitespace-nowrap text-slate-600 dark:text-slate-300">' +
          '<span class="text-emerald-600 dark:text-emerald-400 font-semibold">' + escapeHtml(timeStr) + '</span>' +
          '<span class="text-slate-400 dark:text-slate-500 text-[10px] ml-1">UTC</span>' +
        '</td>' +
        '<td class="py-3 px-4 whitespace-nowrap">' +
          '<span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-cyan-700 dark:text-cyan-300 font-semibold" title="Salted SHA-256 Visitor Hash: ' + escapeHtml(hit.visitorHash) + '">' +
            escapeHtml(hit.maskedHash) +
          '</span>' +
        '</td>' +
        '<td class="py-3 px-4">' +
          '<a href="' + escapeHtml(hit.path) + '" target="_blank" rel="noopener" class="text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 font-semibold break-all">' +
            escapeHtml(hit.route) +
          '</a>' +
        '</td>' +
        '<td class="py-3 px-4 whitespace-nowrap text-slate-700 dark:text-slate-300">' +
          '<span class="mr-1">' + escapeHtml(hit.geo && hit.geo.flag ? hit.geo.flag : '🌐') + '</span>' +
          '<span>' + escapeHtml((hit.geo && hit.geo.city) || 'Bengaluru') + ', ' + escapeHtml((hit.geo && hit.geo.countryCode) || 'IN') + '</span>' +
        '</td>' +
        '<td class="py-3 px-4 whitespace-nowrap">' +
          '<span class="text-slate-800 dark:text-slate-200">' + escapeHtml(hit.client && hit.client.os) + '</span> ' +
          '<span class="text-slate-400 dark:text-slate-500">·</span> ' +
          '<span class="text-cyan-600 dark:text-cyan-400 font-semibold">' + escapeHtml(hit.client && hit.client.browser) + '</span>' +
          '<span class="ml-1 px-1.5 py-0.5 rounded text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">' + escapeHtml(hit.client && hit.client.deviceType) + '</span>' +
        '</td>' +
        '<td class="py-3 px-4 whitespace-nowrap text-slate-500 dark:text-slate-400">' +
          escapeHtml(hit.referrer || 'Direct') +
        '</td>' +
        '<td class="py-3 px-4 whitespace-nowrap text-right">' +
          '<div class="inline-flex items-center justify-end gap-1.5">' +
            '<button type="button" onclick="copyVisitorHash(\'' + escapeHtml(hit.visitorHash) + '\', this)" class="btn btn-secondary inline-flex items-center gap-1 px-2 py-1 rounded bg-slate-50 dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 text-[11px] font-mono">' +
              '<svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>' +
              '<span>Hash</span>' +
            '</button>' +
            '<button type="button" onclick="filterByRoute(\'' + escapeHtml(hit.route) + '\')" class="btn btn-secondary inline-flex items-center gap-1 px-2 py-1 rounded bg-slate-50 dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 text-[11px] font-mono">' +
              '<svg class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>' +
              '<span>Route</span>' +
            '</button>' +
          '</div>' +
        '</td>';

      wireTableBody.insertBefore(tr, wireTableBody.firstChild);
      setTimeout(() => {
        tr.classList.remove('bg-emerald-50/70', 'dark:bg-emerald-950/20');
      }, 1500);

      // Keep rolling 30 rows
      const rows = wireTableBody.querySelectorAll('tr[data-hit-id]');
      if (rows.length > 30) {
        for (let i = 30; i < rows.length; i++) {
          rows[i].remove();
        }
      }

      if (totalVisitsEl) {
        const currentTotal = parseInt(totalVisitsEl.textContent, 10) || 0;
        totalVisitsEl.textContent = String(currentTotal + 1);
      }
    }

    if (typeof window.EventSource !== 'undefined') {
      const source = new EventSource('/api/traffic/live');
      source.onmessage = function (event) {
        if (streamPaused) return;
        try {
          const payload = JSON.parse(event.data);
          if (typeof payload.activeCount === 'number' && activeCountEl) {
            if (activeCountEl.textContent !== String(payload.activeCount)) {
              activeCountEl.textContent = String(payload.activeCount);
              activeCountEl.classList.add('scale-110');
              setTimeout(() => activeCountEl.classList.remove('scale-110'), 200);
            }
          }
          if (payload.timestamp && lastHeartbeatBadge) {
            lastHeartbeatBadge.textContent = 'SYNC: ' + payload.timestamp.slice(11, 19) + ' UTC';
          }
          if (payload.latestHit) {
            prependWireHit(payload.latestHit);
          }
        } catch (_) {}
      };
      source.onerror = function () {
        if (!streamPaused && sseStatusLabel) {
          sseStatusLabel.textContent = 'RECONNECTING...';
        }
      };
    }
  })();
</script>

<%- include('layout_bottom') %>

