<%- include('../layout_top') %>

<%
  const totalProj = Array.isArray(projects) ? projects.length : 0;
  const featuredProj = Array.isArray(projects) ? projects.filter(p => p.featured).length : 0;
%>

<div class="w-full space-y-6 min-w-0 [overflow-wrap:anywhere] text-left mx-auto">
  
  <div class="space-y-4">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div class="min-w-0 lg:flex-1">
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight"><span>📁 Engineering Projects &amp; Case Studies</span></h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Manage portfolio projects, technical details, and featured case studies.</p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <div class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-semibold text-slate-600 dark:text-slate-300">
          Projects: <span class="font-extrabold font-mono text-slate-900 dark:text-white ml-1"><%= totalProj %></span>
        </div>
        <div class="px-3 py-1.5 rounded-xl bg-brand-500/10 dark:bg-accent/15 border border-brand-500/30 text-xs font-semibold text-brand-700 dark:text-accent">
          Featured: <span class="font-extrabold font-mono ml-1"><%= featuredProj %></span>
        </div>
        <a href="/admin/projects/new" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition shadow-xs inline-flex items-center gap-1.5 active:scale-95">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Add New Project</span>
        </a>
      </div>
    </div>

    <!-- Category Filter Pills (Wraps cleanly on mobile with zero horizontal scroll) -->
    <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-slate-100 dark:border-brand-border">
      <% (categories || ['All']).forEach(function(cat) { %>
        <a 
          href="/admin/projects?category=<%= encodeURIComponent(cat) %>" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition <%= selectedCategory === cat ? 'bg-brand-500 text-white shadow-2xs' : 'bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border hover:border-brand-500/40 hover:text-brand-600 dark:hover:text-accent' %>"
        >
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          <span><%= cat %></span>
        </a>
      <% }); %>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 bg-brand-500/10 dark:bg-accent/15 border border-brand-500/30 rounded-xl text-xs font-bold text-brand-700 dark:text-accent flex items-center space-x-2">
      <span>✓</span>
      <span>Project successfully saved and synchronized with public portfolio.</span>
    </div>
  <% } %>

  <div class="space-y-4">
    <% if (!projects || projects.length === 0) { %>
      <div class="bg-white dark:bg-brand-surface rounded-2xl p-10 sm:p-12 text-center border border-slate-200 dark:border-brand-border shadow-sm">
        <span class="mx-auto w-11 h-11 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7M12 11v10"/></svg>
        </span>
        <p class="mt-3 text-sm font-bold text-slate-900 dark:text-white">No projects found</p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Add a project to build out the public portfolio.</p>
        <a href="/admin/projects/new" class="mt-4 inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold transition">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Add a project</span>
        </a>
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% projects.forEach(function(p) { %>
          <article class="bg-white dark:bg-brand-surface rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-brand-border shadow-sm space-y-4">
            <div class="flex items-start justify-between gap-2 pb-4 border-b border-slate-100 dark:border-brand-border">
              <div class="min-w-0 flex-1">
                <a href="/admin/projects/<%= p.id %>/edit" class="hover:text-brand-600 dark:hover:text-accent transition block font-black text-slate-900 dark:text-white text-xs break-words">
                  <%= p.title %>
                </a>
                <span class="text-[10px] text-slate-400 font-mono font-normal break-all">/projects/<%= p.slug %></span>
              </div>
              <button 
                type="button" 
                onclick="toggleFeatured('<%= p.id %>', this)" 
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black transition shrink-0 cursor-pointer <%= p.featured ? 'admin-badge-featured' : 'admin-badge-standard' %>"
                aria-pressed="<%= p.featured ? 'true' : 'false' %>"
                title="Click to toggle featured status on homepage"
              >
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="<%= p.featured ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span><%= p.featured ? 'Featured' : 'Standard' %></span>
              </button>
            </div>
            <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold admin-badge-category"><%= p.category %></span>
              <% if (p.industry) { %>
                <span class="text-slate-500"><%= p.industry %></span>
              <% } %>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= p.status === 'completed' ? 'admin-badge-published' : 'admin-badge-draft' %>">
                <%= p.status %>
              </span>
            </div>
            <% if (p.techStack) { %>
              <p class="font-mono text-[10px] text-slate-600 dark:text-slate-400 break-words"><%= p.techStack %></p>
            <% } %>
            <div class="flex flex-wrap items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-brand-border text-xs">
              <a href="/projects/<%= p.slug %>" target="_blank" rel="noopener" aria-label="View project" title="View project" class="inline-flex min-h-9 items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-300 dark:border-brand-border text-slate-700 dark:text-slate-300 text-[11px] font-bold hover:bg-slate-50 dark:hover:bg-brand-dark transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <span>View</span>
              </a>
              <a href="/admin/projects/<%= p.id %>/edit" aria-label="Edit project" title="Edit project" class="inline-flex min-h-9 items-center gap-1.5 px-3 py-2 rounded-lg border border-brand-300 dark:border-brand-800 text-brand-700 dark:text-accent text-[11px] font-bold hover:bg-brand-50 dark:hover:bg-brand-950/40 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                <span>Edit</span>
              </a>
              <form action="/admin/projects/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this project permanently?')" class="inline">
                <%- csrfField %>
                <button type="submit" aria-label="Delete project" title="Delete project" class="inline-flex min-h-9 items-center gap-1.5 px-3 py-2 rounded-lg border border-rose-200 dark:border-rose-900/60 text-rose-600 dark:text-rose-400 text-[11px] font-bold hover:bg-rose-50 dark:hover:bg-rose-950/40 transition cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  <span>Delete</span>
                </button>
              </form>
            </div>
          </article>
        <% }); %>
      </div>

      <!-- Legacy table markup remains hidden; cards are used at every viewport. -->
      <div class="hidden">
        <table class="w-full text-left text-xs">
          <thead class="admin-table-head uppercase font-bold text-[11px] tracking-wider">
            <tr>
              <th class="p-4">Project Title</th>
              <th class="p-4">Category / Industry</th>
              <th class="p-4">Tech Stack</th>
              <th class="p-4 text-center">Featured</th>
              <th class="p-4">Status</th>
              <th class="p-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="admin-table-body divide-y divide-slate-200 dark:divide-brand-border">
            <% projects.forEach(function(p) { %>
              <tr class="transition">
                <td class="p-4 font-bold text-slate-900 dark:text-white max-w-xs">
                  <a href="/admin/projects/<%= p.id %>/edit" class="hover:text-brand-600 dark:hover:text-accent transition block font-black">
                    <%= p.title %>
                  </a>
                  <span class="text-[10px] text-slate-400 font-mono font-normal">/projects/<%= p.slug %></span>
                </td>
                <td class="p-4">
                  <span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold admin-badge-category block w-fit mb-1">
                    <%= p.category %>
                  </span>
                  <span class="text-[11px] text-slate-500 truncate block"><%= p.industry %></span>
                </td>
                <td class="p-4 font-mono text-[11px] text-slate-700 dark:text-slate-300 max-w-xs truncate">
                  <%= p.techStack || '—' %>
                </td>
                <td class="p-4 text-center">
                  <button 
                    type="button" 
                    onclick="toggleFeatured('<%= p.id %>', this)" 
                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black transition cursor-pointer <%= p.featured ? 'admin-badge-featured' : 'admin-badge-standard' %>"
                    title="Click to toggle featured status on homepage"
                  >
                    <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="<%= p.featured ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span><%= p.featured ? 'Featured' : 'Standard' %></span>
                  </button>
                </td>
                <td class="p-4">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= p.status === 'completed' ? 'admin-badge-published' : 'admin-badge-draft' %>">
                    <%= p.status %>
                  </span>
                </td>
                <td class="p-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center justify-end gap-1.5">
                    <a href="/projects/<%= p.slug %>" target="_blank" aria-label="View project" title="View Project" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-600 dark:text-slate-300 hover:border-brand-500/40 hover:text-brand-600 dark:hover:text-accent transition inline-flex items-center justify-center">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </a>
                    <a href="/admin/projects/<%= p.id %>/edit" aria-label="Edit project" title="Edit Project" class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 border border-brand-500/30 text-brand-700 dark:text-accent hover:bg-brand-500 hover:text-white transition inline-flex items-center justify-center">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </a>
                    <form action="/admin/projects/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this project permanently?')" class="inline">
                      <%- csrfField %>
                      <button type="submit" aria-label="Delete project" title="Delete Project" class="w-9 h-9 !min-h-0 !min-w-0 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 hover:bg-rose-500 hover:text-white transition inline-flex items-center justify-center cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</div>

<script>
  async function toggleFeatured(projectId, btn) {
    try {
      const res = await fetch(`/admin/projects/${projectId}/toggle-featured`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        btn.setAttribute('aria-pressed', String(Boolean(data.featured)));
        if (data.featured) {
          btn.innerHTML = '<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><span>Featured</span>';
          btn.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black transition cursor-pointer admin-badge-featured';
        } else {
          btn.innerHTML = '<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><span>Standard</span>';
          btn.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black transition cursor-pointer admin-badge-standard';
        }
      }
    } catch (e) {
      alert('Error updating featured status');
    }
  }
</script>

<%- include('../layout_bottom') %>
