<%- include('layout_top') %>

<%
  const totalSubs = Array.isArray(subscribers) ? subscribers.length : 0;
  const activeSubs = Array.isArray(subscribers) ? subscribers.filter(s => s.status === 'active').length : 0;
  const pendingSubs = Array.isArray(subscribers) ? subscribers.filter(s => s.status === 'pending').length : 0;
  const deliveredSubs = Array.isArray(subscribers) ? subscribers.filter(s => s.leadMagnetSent).length : 0;
%>

<div class="w-full space-y-6 min-w-0 [overflow-wrap:anywhere] mx-auto">
  
  <div class="bg-white dark:bg-brand-surface rounded-2xl p-4 sm:p-5 border border-slate-200 dark:border-brand-border shadow-xs flex flex-col 2xl:flex-row 2xl:items-start justify-between gap-4 min-w-0">
    <div class="min-w-0 2xl:flex-1">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-500/10 dark:bg-accent/15 border border-brand-500/20 text-brand-700 dark:text-accent text-[11px] font-extrabold uppercase tracking-wider mb-1.5">
        <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
        <span>Engineering Operations Console</span>
      </div>
      <h1 class="flex min-w-0 items-center gap-2 text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">
        <span class="material-symbols-rounded shrink-0 text-2xl text-brand-600 dark:text-accent" aria-hidden="true">mail</span>
        <span>Newsletter Leads &amp; Subscribers</span>
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Manage signups, approve subscribers, and export your campaign list.</p>
    </div>

    <div class="flex w-full 2xl:w-auto flex-wrap items-center gap-2 2xl:justify-end">
      <div class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-semibold text-slate-600 dark:text-slate-300">
        Total: <span class="font-extrabold font-mono text-slate-900 dark:text-white ml-1"><%= totalSubs %></span>
      </div>
      <div class="px-3 py-1.5 rounded-xl bg-brand-500/10 dark:bg-accent/15 border border-brand-500/30 text-xs font-semibold text-brand-700 dark:text-accent">
        Active: <span class="font-extrabold font-mono ml-1"><%= activeSubs %></span>
      </div>
      <% if (pendingSubs > 0) { %>
        <div class="px-3 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs font-semibold text-amber-700 dark:text-amber-300">
          Pending: <span class="font-extrabold font-mono ml-1"><%= pendingSubs %></span>
        </div>
      <% } %>
      <div class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-semibold text-slate-600 dark:text-slate-300">
        PDF Sent: <span class="font-extrabold font-mono text-brand-600 dark:text-accent ml-1"><%= deliveredSubs %></span>
      </div>

      <!-- Export CSV Button -->
      <a href="/admin/subscribers/export" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition shadow-xs inline-flex items-center justify-center gap-2 cursor-pointer">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        <span>Export CSV List</span>
      </a>
    </div>
  </div>

  <% if (message || deliveryError) { %>
  <div role="status" aria-live="polite" class="flex items-start gap-2.5 p-3.5 rounded-xl border text-xs font-semibold <%= deliveryError ? 'border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300' : 'border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300' %>">
    <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <% if (deliveryError) { %>
        <circle cx="12" cy="12" r="10"/><path d="M12 9v4m0 4h.01"/>
      <% } else { %>
        <path d="m5 12 4 4L19 6"/>
      <% } %>
    </svg>
    <span><%= deliveryError || message %></span>
  </div>
  <% } %>

  <div class="space-y-4">
    <% if (subscribers.length === 0) { %>
      <div class="bg-white dark:bg-brand-surface rounded-2xl p-10 sm:p-12 text-center border border-slate-200 dark:border-brand-border shadow-sm">
        <span class="mx-auto w-11 h-11 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v14H4zM4 7l8 6 8-6"/></svg>
        </span>
        <p class="mt-3 text-sm font-bold text-slate-900 dark:text-white">No subscribers yet</p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">New newsletter signups will appear here.</p>
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% subscribers.forEach(sub => { %>
          <article class="bg-white dark:bg-brand-surface rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-brand-border shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 dark:border-brand-border gap-3">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="w-2.5 h-2.5 rounded-full shrink-0 <%= sub.status === 'active' ? 'bg-emerald-500' : sub.status === 'pending' ? 'bg-amber-400' : 'bg-slate-400' %>"></span>
                  <h2 class="min-w-0 font-bold text-slate-900 dark:text-white text-sm break-all"><%= sub.email %></h2>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 ml-5">
                  Source: <span class="font-mono"><%= sub.source || 'website' %></span>
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= sub.status === 'active' ? 'bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300' : sub.status === 'pending' ? 'bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300' %>">
                  <%= sub.status %>
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= sub.leadMagnetSent ? 'bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400' %>">
                  <%= sub.leadMagnetSent ? 'PDF delivered' : 'PDF pending' %>
                </span>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
              <span class="text-xs text-slate-500 dark:text-slate-400">
                Added <%= new Date(sub.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
              </span>
              <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                <% if (sub.status !== 'active') { %>
                  <form action="/admin/subscribers/<%= sub.id %>/approve" method="POST" class="inline">
                    <%- csrfField %>
                    <button type="submit" aria-label="Approve subscriber and send Lead Magnet PDF" title="Approve &amp; Send PDF" class="inline-flex min-h-9 items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-emerald-300 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-[11px] font-bold hover:bg-emerald-50 dark:hover:bg-emerald-950/50 transition cursor-pointer">
                      <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      <span>Approve &amp; Send PDF</span>
                    </button>
                  </form>
                <% } else { %>
                  <form action="/admin/subscribers/<%= sub.id %>/approve" method="POST" class="inline">
                    <%- csrfField %>
                    <button type="submit" aria-label="Resend Lead Magnet PDF" title="Resend Lead Magnet PDF" class="inline-flex min-h-9 items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-slate-300 dark:border-brand-border text-slate-700 dark:text-slate-300 text-[11px] font-bold hover:bg-slate-50 dark:hover:bg-brand-dark transition cursor-pointer">
                      <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                      <span>Resend PDF</span>
                    </button>
                  </form>
                <% } %>
                <form action="/admin/subscribers/<%= sub.id %>/delete" method="POST" onsubmit="return confirm('Remove this subscriber?')" class="inline">
                  <%- csrfField %>
                  <button type="submit" aria-label="Delete subscriber" title="Delete Subscriber" class="inline-flex min-h-9 items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-rose-200 dark:border-rose-900/60 text-rose-600 dark:text-rose-400 text-[11px] font-bold hover:bg-rose-50 dark:hover:bg-rose-950/40 transition cursor-pointer">
                    <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m-11 0 1 14h12l1-14M10 11v5m4-5v5"/></svg>
                    <span>Delete</span>
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <div class="hidden">
        <table class="w-full text-left text-xs">
          <thead class="admin-table-head uppercase font-bold text-[11px] tracking-wider">
            <tr>
              <th class="p-4">Email</th>
              <th class="p-4">Status</th>
              <th class="p-4">Lead Magnet Sent</th>
              <th class="p-4">Source Page</th>
              <th class="p-4">Signup Date</th>
              <th class="p-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="admin-table-body divide-y divide-slate-200 dark:divide-brand-border">
            <% subscribers.forEach(sub => { %>
              <tr class="transition">
                <td class="p-4 font-bold text-slate-900 dark:text-white"><%= sub.email %></td>
                <td class="p-4">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase <%= sub.status === 'active' ? 'admin-badge-published' : sub.status === 'pending' ? 'admin-badge-scheduled' : 'admin-badge-draft' %>">
                    <%= sub.status %>
                  </span>
                </td>
                <td class="p-4 font-medium text-slate-700 dark:text-slate-300">
                  <%= sub.leadMagnetSent ? '✅ Delivered' : '⏳ Pending Delivery' %>
                </td>
                <td class="p-4 text-slate-500 dark:text-slate-400 font-mono"><%= sub.source %></td>
                <td class="p-4 text-slate-500 dark:text-slate-300 font-medium">
                  <%= new Date(sub.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </td>
                <td class="p-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center justify-end gap-1.5">
                    <% if (sub.status !== 'active') { %>
                      <form action="/admin/subscribers/<%= sub.id %>/approve" method="POST" class="inline">
                        <%- csrfField %>
                        <button type="submit" aria-label="Approve subscriber and send Lead Magnet PDF" title="Approve &amp; Send PDF" class="w-9 h-9 !min-h-0 !min-w-0 rounded-xl bg-brand-500/10 dark:bg-accent/15 border border-brand-500/30 text-brand-700 dark:text-accent hover:bg-brand-500 hover:text-white transition inline-flex items-center justify-center cursor-pointer">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        </button>
                      </form>
                    <% } else { %>
                      <form action="/admin/subscribers/<%= sub.id %>/approve" method="POST" class="inline">
                        <%- csrfField %>
                        <button type="submit" aria-label="Resend Lead Magnet PDF" title="Resend Lead Magnet PDF" class="w-9 h-9 !min-h-0 !min-w-0 rounded-xl bg-brand-500/10 dark:bg-accent/15 border border-brand-500/30 text-brand-700 dark:text-accent hover:bg-brand-500 hover:text-white transition inline-flex items-center justify-center cursor-pointer">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </button>
                      </form>
                    <% } %>
                    <form action="/admin/subscribers/<%= sub.id %>/delete" method="POST" onsubmit="return confirm('Remove subscriber <%= sub.email %>?')" class="inline">
                      <%- csrfField %>
                      <button type="submit" aria-label="Delete subscriber" title="Delete Subscriber" class="w-9 h-9 !min-h-0 !min-w-0 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 hover:bg-rose-500 hover:text-white transition inline-flex items-center justify-center cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</div>

<%- include('layout_bottom') %>
