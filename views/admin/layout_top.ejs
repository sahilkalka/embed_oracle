        padding-left: 0.5rem !important;
        padding-right: 0.5rem !important;
      }
      #adminLeftSidebar[data-collapsed="true"] #sidebarCollapseBtn,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar #sidebarCollapseBtn {
        width: 2.625rem !important;
        height: 2.625rem !important;
        padding: 0 !important;
        justify-content: center !important;
      }
      #adminLeftSidebar[data-collapsed="true"] #sidebarCollapseBtn svg,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar #sidebarCollapseBtn svg {
        width: 1.25rem !important;
        height: 1.25rem !important;
      }
      #adminLeftSidebar[data-collapsed="true"] nav a.sidebar-nav-item,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar nav a.sidebar-nav-item {
        width: 2.875rem !important;
        height: 2.875rem !important;
        min-height: 2.875rem !important;
        margin-left: auto !important;
        margin-right: auto !important;
        padding: 0 !important;
        justify-content: center !important;
      }
      #adminLeftSidebar[data-collapsed="true"] nav a.sidebar-nav-item svg,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar nav a.sidebar-nav-item svg {
        width: 1.4rem !important;
        height: 1.4rem !important;
      }
      #adminLeftSidebar[data-collapsed="true"] .sidebar-user-wrap,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar .sidebar-user-wrap {
        width: 100% !important;
        flex-direction: column !important;
        gap: 0.5rem !important;
        justify-content: center !important;
        padding: 0.35rem 0.25rem !important;
      }
      #adminLeftSidebar[data-collapsed="true"] .admin-signout,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar .admin-signout {
        width: 2.625rem !important;
        height: 2.625rem !important;
        min-height: 2.625rem !important;
        margin-left: auto !important;
        margin-right: auto !important;
        padding: 0 !important;
        justify-content: center !important;
      }
      #adminLeftSidebar[data-collapsed="true"] .admin-signout svg,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar .admin-signout svg {
        width: 1.25rem !important;
        height: 1.25rem !important;
      }
      #adminLeftSidebar[data-collapsed="true"] #sidebarCollapseChevron,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar #sidebarCollapseChevron {
        transform: rotate(180deg);
      }
    }
    .theme-dropdown-menu.hidden,
    #admin-palette-dropdown-menu.hidden {
      display: none !important;
    }
    .theme-dropdown-menu:not(.hidden),
    #admin-palette-dropdown-menu:not(.hidden) {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      gap: 6px !important;
      top: calc(100% + 8px) !important;
      right: 0 !important;
      width: auto !important;
      max-width: none !important;
      z-index: 999999 !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    .theme-dropdown-menu .palette-btn,
    #admin-palette-dropdown-menu .palette-btn {
      width: 15px !important;
      height: 15px !important;
      min-width: 15px !important;
      min-height: 15px !important;
      max-width: 15px !important;
      max-height: 15px !important;
      padding: 0 !important;
      border-radius: 9999px !important;
      flex-shrink: 0 !important;
    }
  </style>
</head>
<body class="ui-shell admin-shell bg-slate-50 dark:bg-brand-dark text-slate-900 dark:text-slate-100 font-sans min-h-screen flex antialiased thin-dark-scrollbar">

  <!-- Skip to main content link for accessibility -->
  <a href="#admin-main-content" class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-500 focus:text-white focus:rounded-lg focus:font-bold focus:text-xs">Skip to main content</a>

  <%
    const adminUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : { username: 'Administrator', email: 'admin@embeddedindia.in', role: 'admin' };
    const adminDisplayName = adminUser.username || (adminUser.email ? adminUser.email.split('@')[0] : 'Administrator');
    const adminEmail = adminUser.email || 'admin@embeddedindia.in';
    const adminInitials = (adminDisplayName.slice(0, 1) || 'A').toUpperCase();
    const navPath = typeof currentPath !== 'undefined' ? currentPath : '/admin';
    const counts = (typeof navCounts !== 'undefined' && navCounts) ? navCounts : {
      inquiries: 0,
      subscribers: 0,
      posts: 0,
      projects: 0,
      reviews: 0,
      assets: 0
    };
    const isSettingsPage = navPath.startsWith('/admin/settings') || navPath.startsWith('/admin/customizer') || navPath.startsWith('/admin/ai');
    const workspaceRoutes = [
      { label: 'Overview', headerLabel: 'Overview', href: '/admin', count: null, active: navPath === '/admin', icon: 'dashboard' },
      { label: 'Inquiries', headerLabel: 'Inquiries', href: '/admin/inquiries', count: counts.inquiries, active: navPath.startsWith('/admin/inquiries'), icon: 'inbox' },
      { label: 'Subscribers', headerLabel: 'Subscribers', href: '/admin/subscribers', count: counts.subscribers, active: navPath.startsWith('/admin/subscribers'), icon: 'groups' },
      { label: 'Blog Posts', headerLabel: 'Articles', href: '/admin/posts', count: counts.posts, active: navPath.startsWith('/admin/posts'), icon: 'article' },
      { label: 'Projects', headerLabel: 'Projects', href: '/admin/projects', count: counts.projects, active: navPath.startsWith('/admin/projects'), icon: 'inventory_2' },
      { label: 'Reviews', headerLabel: 'Reviews', href: '/admin/testimonials', count: counts.reviews, active: navPath.startsWith('/admin/testimonials'), icon: 'star' },
      { label: 'Assets', headerLabel: 'Assets', href: '/admin/assets', count: counts.assets, active: navPath.startsWith('/admin/assets'), icon: 'folder_open' }
    ];
    workspaceRoutes.splice(2, 0, {
      label: 'Traffic',
      headerLabel: 'Traffic',
      href: '/admin/traffic',
      count: null,
      active: navPath.startsWith('/admin/traffic'),
      icon: 'monitoring'
    });
    const systemRoutes = [
      { label: 'Settings', headerLabel: 'Settings', href: '/admin/settings', count: null, active: isSettingsPage, icon: 'settings' }
    ];
    const sidebarRoutes = [...workspaceRoutes, ...systemRoutes];
    const activeRouteObj = sidebarRoutes.find(r => r.active) || (navPath.startsWith('/admin/traffic') ? { label: 'Traffic', href: '/admin/traffic', active: true } : sidebarRoutes[0]);
  %>

  <!-- Mobile Sidebar Backdrop -->
  <div id="adminSidebarBackdrop" onclick="toggleMobileAdminSidebar(false)" class="fixed inset-0 z-40 bg-black/60 backdrop-blur-xs hidden lg:hidden"></div>

  <!-- Persistent Left Sidebar Rail (w-64, Collapsible, Theme-Aware) -->
  <aside id="adminLeftSidebar" aria-label="Primary Admin Navigation" class="fixed lg:sticky top-0 left-0 z-50 h-screen w-64 bg-white dark:bg-brand-surface border-r border-slate-200 dark:border-brand-border text-slate-700 dark:text-slate-200 flex flex-col justify-between shrink-0 transition-transform lg:transition-[width] duration-200 -translate-x-full lg:translate-x-0 select-none">
    
    <!-- Top: Embedded India Brand Block with Avatar / Initials & Collapse Button -->
    <div class="sidebar-brand-wrap h-auto min-h-16 px-3.5 py-2.5 border-b border-slate-200 dark:border-brand-border flex items-center justify-between gap-2 shrink-0">
      <a href="/admin" aria-label="Embedded India Admin" class="sidebar-brand-link flex items-center gap-2.5 min-w-0 group">
        <% if (settings && settings.site_logo) { %>
          <img src="<%= settings.site_logo %>" alt="<%= settings.site_name || 'Embedded India' %>" class="h-9 w-9 rounded-lg object-contain bg-slate-100 dark:bg-brand-dark p-1 border border-slate-200 dark:border-brand-border shrink-0">
        <% } else { %>
          <div class="w-9 h-9 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 font-black text-sm flex items-center justify-center shrink-0">
            EI
          </div>
        <% } %>
        <div class="sidebar-collapsible-text flex flex-col min-w-0">
          <div class="text-sm font-extrabold tracking-tight text-slate-900 dark:text-white truncate flex items-center gap-1">
            <span>Embedded</span>
            <span class="text-emerald-600 dark:text-emerald-400">India</span>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 leading-none mt-0.5">Admin Console</span>
        </div>
      </a>

      <!-- Desktop Collapse Rail Button -->
      <button type="button" id="sidebarCollapseBtn" onclick="toggleAdminSidebarCollapse()" title="Toggle sidebar width" aria-label="Toggle sidebar width" class="hidden lg:inline-flex items-center justify-center gap-1 p-1.5 rounded-lg bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-brand-border text-xs font-bold transition cursor-pointer shrink-0">
        <span id="sidebarCollapseChevron" class="material-symbols-rounded text-base transition-transform duration-200 shrink-0 leading-none" aria-hidden="true">chevron_left</span>
        <span class="sr-only">Collapse</span>
      </button>

      <!-- Mobile Close Drawer Button -->
      <button type="button" onclick="toggleMobileAdminSidebar(false)" title="Close navigation menu" aria-label="Close navigation menu" class="lg:hidden inline-flex w-10 h-10 items-center justify-center p-0 mt-1 rounded-lg bg-slate-100 dark:bg-brand-dark text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-brand-border shrink-0">
        <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- Middle: Unified Left-Aligned High-Level Routes with Settings Pinned at Bottom -->
    <nav aria-label="Admin workspace navigation" class="flex-1 flex flex-col overflow-y-auto thin-dark-scrollbar py-3.5 px-2.5">
      <div class="space-y-1">
        <div class="sidebar-collapsible-text px-2.5 pb-1.5 text-[11px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
          Workspace
        </div>
        <% workspaceRoutes.forEach((item) => { %>
          <a href="<%= item.href %>"
             title="<%= item.label %>"
             aria-label="<%= item.label %>"
             <% if (item.active) { %>aria-current="page"<% } %>
             class="sidebar-nav-item group flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-150 <%= item.active ? 'bg-emerald-500/10 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 font-bold shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-brand-dark border border-transparent' %>">
            <span class="material-symbols-rounded text-xl shrink-0 transition-transform duration-150 group-hover:scale-105 <%= item.active ? 'text-brand-600 dark:text-accent' : 'text-slate-500 dark:text-slate-400 group-hover:text-brand-600 dark:group-hover:text-accent' %>" aria-hidden="true"><%= item.icon %></span>
            <span class="sidebar-collapsible-text truncate"><%= item.label %></span>
            <% if (item.count !== null && item.count !== undefined) { %>
              <span class="sidebar-collapsible-text ml-auto px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-brand-dark text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-brand-border shrink-0"><%= item.count %></span>
            <% } else if (item.active) { %>
              <span class="sidebar-collapsible-text ml-auto w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
            <% } %>
          </a>
        <% }); %>
      </div>

      <div class="mt-auto pt-4 space-y-1">
        <div class="sidebar-collapsible-text px-2.5 pb-1.5 text-[11px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
          System
        </div>
        <% systemRoutes.forEach((item) => { %>
          <a href="<%= item.href %>"
             title="<%= item.label %>"
             aria-label="<%= item.label %>"
             <% if (item.active) { %>aria-current="page"<% } %>
             class="sidebar-nav-item group flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-150 <%= item.active ? 'bg-emerald-500/10 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 font-bold shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-brand-dark border border-transparent' %>">
            <span class="material-symbols-rounded text-xl shrink-0 transition-transform duration-150 group-hover:scale-105 <%= item.active ? 'text-brand-600 dark:text-accent' : 'text-slate-500 dark:text-slate-400 group-hover:text-brand-600 dark:group-hover:text-accent' %>" aria-hidden="true"><%= item.icon %></span>
            <span class="sidebar-collapsible-text truncate"><%= item.label %></span>
            <% if (item.active) { %>
              <span class="sidebar-collapsible-text ml-auto w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
            <% } %>
          </a>
        <% }); %>
      </div>
    </nav>

    <!-- Bottom: Logged-in Administrator Card + Compact Logout Icon Button -->
    <div class="p-2.5 border-t border-slate-200 dark:border-brand-border shrink-0">
      <div class="sidebar-user-wrap p-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border flex items-center justify-between gap-2 min-w-0">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-8 h-8 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-bold text-sm flex items-center justify-center shrink-0" title="<%= adminEmail %>">
            <%= adminInitials %>
          </div>
          <div class="sidebar-collapsible-text min-w-0 flex-1">
            <p class="text-xs font-bold text-slate-900 dark:text-white truncate leading-tight">Administrator</p>
            <p class="text-[10px] text-slate-500 dark:text-slate-400 truncate leading-tight mt-0.5">v1.0.0 &bull; Prisma</p>
          </div>
        </div>
        <a href="/admin/logout" class="admin-signout w-8 h-8 rounded-lg inline-flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 transition shrink-0" aria-label="Sign out" title="Sign out">
          <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">logout</span>
          <span class="sr-only">Sign out</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- Right Main Content Column -->
  <div class="flex-1 flex flex-col min-w-0 min-h-screen bg-slate-50 dark:bg-brand-dark">

    <!-- Compact Top Global Bar (+ Attached Settings Sub-Header when on Settings Page) -->
    <header id="adminTopHeader" class="sticky top-0 z-40 bg-white dark:bg-brand-surface border-b border-slate-200 dark:border-brand-border flex flex-col shrink-0 min-w-0 w-full">
      <div class="min-h-[3.5rem] sm:min-h-[4rem] px-3 sm:px-5 lg:px-6 py-2 flex items-center justify-between gap-2 sm:gap-3 w-full min-w-0 box-border">
        <div class="flex items-center gap-2 sm:gap-2.5 min-w-0">
          <!-- Mobile Sidebar Trigger -->
          <button type="button" onclick="toggleMobileAdminSidebar(true)" aria-label="Open navigation sidebar" title="Open navigation sidebar" class="lg:hidden inline-flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-xs font-bold shrink-0">
            <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">menu</span>
            <span class="sr-only">Menu</span>
          </button>

          <% if (isSettingsPage) { %>
            <!-- Settings Dynamic Section Title & Subtitle -->
            <div class="min-w-0">
              <div class="flex items-center gap-1 sm:gap-1.5 text-xs sm:text-base leading-tight min-w-0">
                <span id="adminHeaderSectionIcon" class="material-symbols-rounded text-base text-amber-400 shrink-0 hidden sm:inline-block leading-none" aria-hidden="true">lightbulb</span>
                <span class="font-extrabold text-slate-900 dark:text-white tracking-tight shrink-0">Settings</span>
                <span class="text-slate-400 dark:text-slate-500 font-normal shrink-0">/</span>
                <span id="adminHeaderActiveSection" class="font-bold text-brand-600 dark:text-accent truncate text-xs sm:text-sm">AI Engine</span>
              </div>
              <p id="adminHeaderActiveDesc" class="hidden md:block text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5">
                Configure model credentials, draft technical articles, and manage automated scheduled publishing.
              </p>
            </div>
          <% } else { %>
            <!-- Standard Route Context Breadcrumb -->
            <div class="flex items-center gap-2 text-xs min-w-0">
              <span class="text-slate-400 dark:text-slate-500 font-semibold hidden sm:inline">Embedded India</span>
              <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">/</span>
              <span class="font-extrabold text-slate-900 dark:text-white truncate text-sm"><%= activeRouteObj.label %></span>
            </div>
          <% } %>
        </div>

        <!-- Right Header Actions: Theme Button + Settings Save/Discard -->
        <div id="admin-header-actions" class="flex items-center gap-1.5 sm:gap-2 text-xs shrink-0">
          <%- include('../partials/theme-button', { showSearch: !isSettingsPage, searchLabel: 'Search admin pages and settings', wrapperId: 'admin-palette-dropdown-wrapper', btnId: 'admin-palette-dropdown-btn', menuId: 'admin-palette-dropdown-menu', chevronId: 'admin-palette-chevron', activeDotId: 'admin-active-scheme-dot', activeNameId: 'admin-active-palette-name' }) %>

          <% if (isSettingsPage) { %>
            <button type="button" id="adminHeaderDiscardBtn" aria-label="Discard unsaved edits in the current settings section" title="Reset unsaved edits to the last saved values" class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-xs font-semibold inline-flex items-center gap-1.5 transition cursor-pointer">
              <span class="material-symbols-rounded text-sm text-slate-400 shrink-0 leading-none" aria-hidden="true">restart_alt</span>
              <span>Discard</span>
            </button>
            <button type="button" id="adminHeaderSaveBtn" aria-label="Save the active settings section" title="Save the active settings section" class="px-2.5 sm:px-3.5 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold inline-flex items-center gap-1.5 transition shadow-xs cursor-pointer">
              <span class="material-symbols-rounded text-sm shrink-0 leading-none" aria-hidden="true">save</span>
              <span class="sm:hidden">Save</span>
              <span class="hidden sm:inline">Save Changes</span>
            </button>
          <% } else { %>
            <a href="/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-xs font-bold transition" title="Open live public website">
              <span class="material-symbols-rounded text-sm text-brand-600 dark:text-accent shrink-0 leading-none" aria-hidden="true">open_in_new</span>
              <span class="hidden sm:inline">Live Site</span>
            </a>
          <% } %>
        </div>
      </div>

      <% if (isSettingsPage) { %>
        <%- include('partials/settings-nav') %>
      <% } %>
    </header>

    <script>
      (function() {
        const sidebar = document.getElementById('adminLeftSidebar');
        if (sidebar && localStorage.getItem('admin-sidebar-collapsed') === 'true') {
          sidebar.setAttribute('data-collapsed', 'true');
          document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
        }
      })();
      window.toggleAdminSidebarCollapse = function() {
        const sidebar = document.getElementById('adminLeftSidebar');
        if (!sidebar) return;
        const next = sidebar.getAttribute('data-collapsed') !== 'true';
        sidebar.setAttribute('data-collapsed', String(next));
        if (next) {
          document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
        } else {
          document.documentElement.removeAttribute('data-sidebar-collapsed');
        }
        localStorage.setItem('admin-sidebar-collapsed', String(next));
      };
      window.toggleMobileAdminSidebar = function(open) {
        const sidebar = document.getElementById('adminLeftSidebar');
        const backdrop = document.getElementById('adminSidebarBackdrop');
        if (!sidebar || !backdrop) return;
        if (open) {
          sidebar.classList.remove('-translate-x-full');
          backdrop.classList.remove('hidden');
          const sidebarNavigation = sidebar.querySelector('nav');
          if (sidebarNavigation) sidebarNavigation.scrollTop = 0;
        } else {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        }
      };
      const mobileAdminSidebar = document.getElementById('adminLeftSidebar');
      if (mobileAdminSidebar) {
        mobileAdminSidebar.querySelectorAll('a.sidebar-nav-item').forEach(link => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 1023px)').matches) {
              window.toggleMobileAdminSidebar(false);
            }
          });
        });
      }
      window.addEventListener('pageshow', () => {
        if (window.matchMedia('(max-width: 1023px)').matches) {
          window.toggleMobileAdminSidebar(false);
        }
      });
    </script>

    <%- include('../partials/search-dialog', { adminSearch: true }) %>
    <main id="admin-main-content" class="admin-main-container flex-1 w-full max-w-none min-w-0 px-3.5 sm:px-5 lg:px-6 py-4 box-border thin-dark-scrollbar overflow-x-clip">
