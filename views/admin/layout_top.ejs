    html.dark .admin-shell :is(.dark\:border-brand-border, .dark\:border-slate-700, .dark\:border-slate-700\/80, .dark\:border-slate-800, .dark\:border-slate-800\/80, .dark\:border-\[\#1c2e38\], .dark\:border-\[\#1e3831\], .dark\:divide-slate-800\/80, .border-\[\#1c2e38\]) {
      border-color: var(--admin-border) !important;
    }
    .admin-shell :is(.text-emerald-500, .text-emerald-600, .text-emerald-700, .text-emerald-800, .dark\:text-emerald-300, .dark\:text-emerald-400, .text-brand-500, .text-brand-600, .text-brand-700, .dark\:text-accent, .hover\:text-emerald-300:hover, .hover\:text-emerald-400:hover, .hover\:text-emerald-500:hover, .hover\:text-emerald-600:hover, .hover\:text-emerald-700:hover, .dark\:hover\:text-emerald-300:hover, .dark\:hover\:text-emerald-400:hover),
    .admin-shell .group:hover :is(.group-hover\:text-emerald-400, .group-hover\:text-emerald-500, .group-hover\:text-emerald-600, .dark\:group-hover\:text-emerald-300, .dark\:group-hover\:text-emerald-400, .group-hover\:text-brand-500, .group-hover\:text-brand-600, .dark\:group-hover\:text-accent) {
      color: var(--admin-accent-text) !important;
    }
    .admin-shell :is(.bg-emerald-500, .bg-emerald-600, .dark\:bg-emerald-400, .dark\:bg-emerald-500, .bg-brand-500, .bg-brand-600):not([class*="/"]),
    .admin-shell .peer:checked ~ :is(.peer-checked\:bg-emerald-500, .peer-checked\:bg-emerald-600, .peer-checked\:bg-brand-500) {
      background-color: var(--admin-accent) !important;
      color: #ffffff !important;
    }
    .admin-shell :is(.hover\:bg-emerald-400:hover, .hover\:bg-emerald-500:hover, .hover\:bg-emerald-600:hover, .hover\:bg-emerald-700:hover, .hover\:bg-brand-600:hover):not([class*="/"]) {
      background-color: var(--admin-accent-hover) !important;
      color: #ffffff !important;
    }
    .admin-shell :is(.bg-emerald-50, .bg-emerald-50\/70, .bg-emerald-100, .bg-emerald-500\/10, .bg-emerald-500\/15, .bg-emerald-500\/20, .dark\:bg-emerald-500\/10, .dark\:bg-emerald-500\/15, .dark\:bg-emerald-500\/20, .dark\:bg-emerald-950, .dark\:bg-emerald-950\/50, .dark\:bg-emerald-950\/60, .bg-brand-50, .bg-brand-500\/10, .bg-brand-500\/20, .dark\:bg-brand-900\/30, .dark\:bg-brand-900\/40, .dark\:bg-accent\/15, .dark\:bg-accent\/20, .hover\:bg-emerald-50:hover, .hover\:bg-emerald-100:hover, .hover\:bg-emerald-500\/10:hover, .hover\:bg-emerald-500\/15:hover, .hover\:bg-emerald-500\/20:hover, .hover\:bg-emerald-500\/25:hover, .dark\:hover\:bg-emerald-500\/10:hover, .dark\:hover\:bg-emerald-500\/15:hover, .dark\:hover\:bg-emerald-500\/20:hover, .dark\:hover\:bg-emerald-500\/25:hover, .hover\:bg-brand-500\/10:hover, .dark\:hover\:bg-accent\/15:hover) {
      background-color: var(--admin-accent-soft) !important;
    }
    .admin-shell :is(.border-emerald-200, .border-emerald-300, .border-emerald-500\/25, .border-emerald-500\/30, .border-emerald-500\/40, .border-emerald-500, .dark\:border-emerald-800, .border-brand-200, .border-brand-500\/20, .border-brand-500\/30, .dark\:border-brand-800, .hover\:border-emerald-400:hover, .hover\:border-emerald-500:hover, .hover\:border-emerald-500\/40:hover, .focus\:border-emerald-500:focus) {
      border-color: var(--admin-accent-border) !important;
    }
    .admin-shell :is(.ring-emerald-500, .ring-brand-500, .focus\:ring-emerald-500:focus, .focus\:ring-brand-500:focus, .focus\:ring-accent:focus) {
      --tw-ring-color: var(--admin-accent) !important;
    }
    #providerCards label:has(input:checked) {
      background-color: var(--admin-accent-soft) !important;
      border-color: var(--admin-accent) !important;
      --tw-ring-color: var(--admin-accent) !important;
    }
    .admin-shell input[type="range"] {
      accent-color: var(--admin-accent) !important;
    }
    .admin-shell .from-emerald-500 {
      --tw-gradient-from: var(--admin-accent) var(--tw-gradient-from-position) !important;
      --tw-gradient-to: var(--admin-accent-text) var(--tw-gradient-to-position) !important;
      --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;
    }
    /* Admin Tables, Headers, Rows & Badges */
    .admin-shell .admin-table-container,
    html.dark .admin-shell .admin-table-container {
      background-color: var(--admin-bg-panel) !important;
      border-color: var(--admin-border) !important;
    }
    .admin-shell .admin-table-head {
      background-color: var(--admin-bg-subtle) !important;
      color: var(--text-secondary, #475569) !important;
      border-bottom: 1px solid var(--admin-border) !important;
    }
    html.dark .admin-shell .admin-table-head {
      background-color: var(--admin-bg-subtle) !important;
      color: #cbd5e1 !important;
      border-bottom: 1px solid var(--admin-border) !important;
    }
    .admin-shell .admin-table-body tr,
    html.dark .admin-shell .admin-table-body tr,
    .admin-shell .admin-table-body > div,
    html.dark .admin-shell .admin-table-body > div {
      border-color: var(--admin-border) !important;
    }
    .admin-shell .admin-table-body tr:hover,
    html.dark .admin-shell .admin-table-body tr:hover,
    .admin-shell table tbody tr:hover,
    html.dark .admin-shell table tbody tr:hover {
      background-color: var(--admin-accent-soft) !important;
    }
    .admin-shell .admin-badge-published,
    .admin-shell .admin-badge-featured {
      background-color: var(--admin-accent-soft) !important;
      color: var(--admin-accent-text) !important;
      border: 1px solid var(--admin-accent-border) !important;
    }
    .admin-shell .admin-badge-category {
      background-color: var(--admin-bg-subtle) !important;
      color: var(--admin-accent-text) !important;
      border: 1px solid var(--admin-border) !important;
    }
    .admin-shell .admin-badge-scheduled {
      background-color: rgba(245, 158, 11, 0.14) !important;
      color: #d97706 !important;
      border: 1px solid rgba(245, 158, 11, 0.32) !important;
    }
    html.dark .admin-shell .admin-badge-scheduled {
      color: #fbbf24 !important;
    }
    .admin-shell .admin-badge-draft,
    .admin-shell .admin-badge-standard {
      background-color: var(--admin-bg-subtle) !important;
      color: #64748b !important;
      border: 1px solid var(--admin-border) !important;
    }
    html.dark .admin-shell .admin-badge-draft,
    html.dark .admin-shell .admin-badge-standard {
      color: #94a3b8 !important;
    }
    /* Header Search & Theme Trigger Buttons + Form Controls */
    .admin-shell .appearance-trigger,
    .admin-shell .appearance-search,
    html.dark .admin-shell .appearance-trigger,
    html.dark .admin-shell .appearance-search {
      background-color: var(--admin-bg-subtle) !important;
      border-color: var(--admin-border) !important;
      color: var(--admin-accent-text) !important;
    }
    .admin-shell .appearance-trigger:hover,
    .admin-shell .appearance-search:hover,
    html.dark .admin-shell .appearance-trigger:hover,
    html.dark .admin-shell .appearance-search:hover {
      background-color: var(--admin-accent-soft) !important;
      border-color: var(--admin-accent-border) !important;
    }
    .admin-shell .appearance-panel,
    html.dark .admin-shell .appearance-panel {
      background-color: var(--admin-bg-panel) !important;
      border-color: var(--admin-border) !important;
    }
    html.dark .admin-shell .appearance-current-color {
      border-color: var(--admin-bg-subtle) !important;
    }
    .admin-shell input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
    .admin-shell select,
    .admin-shell textarea,
    html.dark .admin-shell input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
    html.dark .admin-shell select,
    html.dark .admin-shell textarea {
      background-color: var(--admin-bg-subtle) !important;
      border-color: var(--border-strong, #64748b) !important;
    }
    /* Sidebar Left-Aligned Horizontal Item Layout (Enlarged Font & Icons) */
    #adminLeftSidebar nav a.sidebar-nav-item {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-start !important;
      text-align: left !important;
      gap: 0.85rem !important;
      min-height: 44px !important;
      font-size: 0.9375rem !important;
      line-height: 1.35rem !important;
    }
    #adminLeftSidebar nav a.sidebar-nav-item svg {
      width: 1.25rem !important;
      height: 1.25rem !important;
    }
    /* Collapsible Left Sidebar State (Desktop >= 1024px) */
    @media (min-width: 1024px) {
      #adminLeftSidebar[data-collapsed="true"],
      html[data-sidebar-collapsed="true"] #adminLeftSidebar {
        width: 4.75rem !important;
      }
