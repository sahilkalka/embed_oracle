      #adminLeftSidebar[data-collapsed="true"] .sidebar-brand-link,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar .sidebar-collapsible-text,
      html[data-sidebar-collapsed="true"] #adminLeftSidebar .sidebar-brand-link {
        display: none !important;
