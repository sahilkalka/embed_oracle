<!DOCTYPE html>
<html lang="en" class="<%= (typeof settings !== 'undefined' && settings && settings.default_theme_mode === 'light') ? '' : 'dark' %>" data-palette="<%= theme.paletteKey %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Embedded India</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <style>
    html:not(.dark) { background-color: #f8fafc; color-scheme: light; }
    html.dark { background-color: #0b1412; color-scheme: dark; }
  </style>
  <script>
    (function() {
      var configuredThemeMode = '<%= (typeof settings !== "undefined" && settings && settings.default_theme_mode === "light") ? "light" : "dark" %>';
      var storedTheme = null;
      try { storedTheme = localStorage.getItem('color-theme'); } catch (e) {}
      var isDark = storedTheme === 'dark' || (!storedTheme && configuredThemeMode === 'dark');
      if (isDark) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      try {
        if (localStorage.getItem('admin-sidebar-collapsed') === 'true') {
          document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
        }
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0,0&amp;display=block" rel="stylesheet">
  <%- include('../partials/palette-boot') %>
  <link href="https://fonts.googleapis.com/css2?<%= Array.from(new Set([theme.headingFont, theme.bodyFont])).map(f => 'family=' + f.replace(/\s+/g, '+') + ':wght@400;500;600;700;800;900').join('&') %>&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
  <link rel="stylesheet" href="/css/admin-settings.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <% if (theme && theme.cssString) { %>
    <style id="dynamic-theme-vars"><%- theme.cssString %></style>
  <% } %>
  <script>
    window.csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
    window.getCsrfToken = function() {
      if (window.csrfToken) return window.csrfToken;
      const meta = document.querySelector('meta[name="csrf-token"]');
      if (meta && meta.content) return meta.content;
      const input = document.querySelector('input[name="_csrf"]');
      if (input && input.value) return input.value;
      return '';
    };

    (function() {
      const origFetch = window.fetch;
      window.fetch = function(input, init) {
        init = init || {};
        const method = (init.method || 'GET').toUpperCase();
        if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) {
          const token = window.getCsrfToken();
          if (token) {
            if (!init.headers) {
              init.headers = { 'X-CSRF-Token': token };
            } else if (typeof Headers !== 'undefined' && init.headers instanceof Headers) {
              if (!init.headers.has('X-CSRF-Token') && !init.headers.has('x-csrf-token')) {
                init.headers.set('X-CSRF-Token', token);
              }
            } else if (Array.isArray(init.headers)) {
              const has = init.headers.some(([k]) => k.toLowerCase() === 'x-csrf-token');
              if (!has) init.headers.push(['X-CSRF-Token', token]);
            } else if (typeof init.headers === 'object') {
              if (!init.headers['X-CSRF-Token'] && !init.headers['x-csrf-token']) {
                init.headers['X-CSRF-Token'] = token;
              }
            }
          }
        }
        return origFetch.call(this, input, init);
      };
    })();
  </script>

  <style id="admin-header-styles">
    <%
      const rawOp = (settings && (settings.header_opacity || settings.header_transparency)) || '95';
      const numOp = Number(rawOp);
      const headerAlpha = !isNaN(numOp) ? (numOp > 1 ? (numOp / 100).toFixed(2) : numOp.toFixed(2)) : '0.95';
      const cMaxWidth = (settings && settings.container_max_width) || '90rem';
    %>
    :root {
      --header-opacity: <%= headerAlpha %>;
      --container-max-width: <%= cMaxWidth %>;
    }
    /* Theme-aware thin scrollbar */
    .thin-dark-scrollbar::-webkit-scrollbar,
    body.admin-shell::-webkit-scrollbar,
    #admin-main-content::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .thin-dark-scrollbar::-webkit-scrollbar-track,
    body.admin-shell::-webkit-scrollbar-track,
    #admin-main-content::-webkit-scrollbar-track {
      background: var(--bg-surface, #f1f5f9);
    }
    .dark .thin-dark-scrollbar::-webkit-scrollbar-track,
    .dark body.admin-shell::-webkit-scrollbar-track,
    .dark #admin-main-content::-webkit-scrollbar-track {
      background: var(--bg-primary, #0b1412);
    }
    .thin-dark-scrollbar::-webkit-scrollbar-thumb,
    body.admin-shell::-webkit-scrollbar-thumb,
    #admin-main-content::-webkit-scrollbar-thumb {
      background: var(--border-color, #cbd5e1);
      border-radius: 9999px;
    }
    .dark .thin-dark-scrollbar::-webkit-scrollbar-thumb,
    .dark body.admin-shell::-webkit-scrollbar-thumb,
    .dark #admin-main-content::-webkit-scrollbar-thumb {
      background: var(--border-color, #334155);
      border-radius: 9999px;
    }
    .thin-dark-scrollbar::-webkit-scrollbar-thumb:hover,
    body.admin-shell::-webkit-scrollbar-thumb:hover,
    #admin-main-content::-webkit-scrollbar-thumb:hover {
      background: var(--primary-color, #059669);
    }
    .w-60 { width: 15rem; }
    .accent-emerald-500,
    .admin-shell input[type="range"],
    .admin-shell input[type="checkbox"],
    .admin-shell input[type="radio"] {
      accent-color: var(--primary-color, #059669);
    }
    /* Full-width admin workspace & strict theme variable synchronization */
    .admin-shell main,
    #admin-main-content {
      max-width: 100% !important;
      width: 100% !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
    /* --admin-* aliases are defined once in src/public/css/input.css from the universal tokens. */
    body.admin-shell,
    .admin-shell > div.flex-1,
    html.dark .admin-shell :is(.dark\:bg-\[\#0d1715\], .dark\:bg-\[\#0b1412\], .dark\:bg-\[\#0b1411\], .dark\:bg-\[\#0c1614\], .bg-\[\#0d1715\], .bg-\[\#0b1412\]) {
      background-color: var(--admin-bg-canvas) !important;
    }
    .admin-shell #adminLeftSidebar,
    .admin-shell > div.flex-1 > header,
    .admin-shell > div.flex-1 > footer,
    .admin-shell .bg-brand-surface,
    .admin-shell .dark\:bg-brand-surface,
    html.dark .admin-shell :is(.dark\:bg-slate-900, .dark\:bg-\[\#111e26\], .dark\:bg-\[\#13221f\], .dark\:bg-\[\#13221e\], .dark\:bg-\[\#0f1c18\], .dark\:bg-\[\#182c27\], .bg-\[\#111e26\]) {
      background-color: var(--admin-bg-panel) !important;
      border-color: var(--admin-border) !important;
    }
    html.dark .admin-shell :is(.dark\:bg-brand-dark, .dark\:bg-slate-800, .dark\:bg-slate-800\/80, .dark\:bg-slate-900\/70, .dark\:bg-slate-900\/90, .dark\:bg-slate-950, .dark\:bg-slate-950\/40, .dark\:bg-slate-950\/50, .dark\:bg-\[\#0c161c\], .dark\:bg-\[\#091217\], .dark\:bg-\[\#070e12\], .dark\:bg-\[\#070e12\]\/60, .bg-\[\#0c161c\], .bg-\[\#070e12\]) {
      background-color: var(--admin-bg-subtle) !important;
    }
    .admin-shell :is(.bg-slate-800, .bg-slate-900):not(body) {
