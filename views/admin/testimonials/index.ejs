<%- include('../layout_top') %>

<div class="w-full space-y-6 min-w-0 [overflow-wrap:anywhere] mx-auto">
  
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="min-w-0 flex-1 basis-96">
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">
        <span>⭐ Client Testimonials &amp; Customer Reviews</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">Manage client social proof displayed on the homepage. Customer-submitted reviews remain pending until approved by an admin.</p>
    </div>

    <div class="flex items-center flex-wrap gap-2">
      <a href="/admin/testimonials/new" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center gap-1.5 active:scale-95 whitespace-nowrap">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Add Testimonial</span>
      </a>
      <a href="/submit-review" target="_blank" class="px-4 py-2 bg-slate-100 dark:bg-brand-surface hover:bg-slate-200 dark:hover:bg-brand-dark text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-brand-border rounded-xl text-xs font-bold transition shadow-sm flex items-center gap-1.5">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        <span>View Public Review Form</span>
      </a>
    </div>
  </div>

  <% if (!testimonials || testimonials.length === 0) { %>
    <div class="bg-white dark:bg-brand-surface rounded-2xl p-12 text-center border border-slate-200 dark:border-brand-border">
      <p class="text-slate-500 text-sm">No testimonials added yet. Click "+ Add Testimonial" above or share the public review link.</p>
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% testimonials.forEach(t => { %>
        <div class="bg-white dark:bg-brand-surface rounded-2xl p-6 border border-slate-200 dark:border-brand-border shadow-sm space-y-4">
          
          <div class="flex flex-wrap items-center justify-between pb-4 border-b border-slate-100 dark:border-brand-border gap-2">
            <div class="flex items-center space-x-3">
              <span class="w-3 h-3 rounded-full <%= t.isApproved ? 'bg-emerald-500' : 'bg-amber-400 animate-pulse' %>"></span>
              <div>
                <span class="text-sm font-bold text-slate-900 dark:text-white"><%= t.name %></span>
                <span class="text-xs text-slate-500 ml-1"><%= t.role %><% if (t.company) { %> · <strong class="text-slate-700 dark:text-slate-300"><%= t.company %></strong><% } %></span>
              </div>
            </div>

            <div class="flex items-center space-x-2">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= t.isApproved ? 'bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300' : 'bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300' %>">
                <%= t.isApproved ? 'Published' : 'Pending Moderation' %>
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 uppercase">
                <%= t.source || 'admin' %>
              </span>
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex items-center space-x-1 text-yellow-400">
              <% for (let i = 0; i < (t.rating || 5); i++) { %>
                <span>★</span>
              <% } %>
              <span class="text-xs font-bold text-slate-500 ml-1">(<%= t.rating || 5 %>/5)</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-200 italic leading-relaxed">
              "<%= t.quote %>"
            </p>
          </div>

          <div class="flex flex-wrap items-center justify-between pt-3 border-t border-slate-100 dark:border-brand-border text-xs text-slate-400 gap-2">
            <span>Added on <%= t.createdAt ? new Date(t.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Recent' %></span>

            <div class="flex items-center space-x-2">
              <form action="/admin/testimonials/<%= t.id %>/toggle-approve" method="POST" class="inline">
                <%- csrfField %>
                <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-bold transition <%= t.isApproved ? 'border-amber-300 text-amber-600 hover:bg-amber-50' : 'border-emerald-500 text-emerald-600 hover:bg-emerald-50' %>">
                  <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><%= t.isApproved ? 'Unpublish' : 'Approve & Publish' %></span>
                </button>
              </form>

              <a href="/admin/testimonials/<%= t.id %>/edit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-brand-border text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-brand-dark transition">
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                <span>Edit</span>
              </a>

              <form action="/admin/testimonials/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Permanently delete this testimonial?')" class="inline">
                <%- csrfField %>
                <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-red-200 text-xs font-bold text-red-600 hover:bg-red-50 transition">
                  <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  <span>Delete</span>
                </button>
              </form>
            </div>
          </div>

        </div>
      <% }) %>
    </div>
  <% } %>

</div>

<%- include('../layout_bottom') %>
