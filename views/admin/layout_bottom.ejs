    </main>

    <footer class="bg-white dark:bg-brand-surface border-t border-slate-200 dark:border-brand-border py-2.5 px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] font-mono text-slate-500 dark:text-slate-400 transition-colors shrink-0">
      <p>Embedded India Administration Console &bull; Node.js &amp; Prisma ORM &bull; Version 1.0.0</p>
      <div class="inline-flex items-center gap-1.5 text-[10px] text-slate-400 dark:text-slate-400">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        <span>Connected to Production DB</span>
      </div>
    </footer>
  </div>

  <script src="/assets/js/header-search.js"></script>
  <script>
    if (document.getElementById('header-search-btn')) window.HeaderSearch.init([
      { title: 'Overview', url: '/admin', type: 'Admin', desc: 'Dashboard metrics and quick actions' },
      { title: 'Inquiries', url: '/admin/inquiries', type: 'Admin', desc: 'Lead and RFQ pipeline' },
      { title: 'Subscribers', url: '/admin/subscribers', type: 'Admin', desc: 'Newsletter leads and subscribers' },
      { title: 'Blog Posts', url: '/admin/posts', type: 'Admin', desc: 'Manage technical articles' },
      { title: 'Projects', url: '/admin/projects', type: 'Admin', desc: 'Engineering portfolio and case studies' },
      { title: 'Server Assets', url: '/admin/assets', type: 'Admin', desc: 'Upload, preview, copy linking paths, and delete server assets' },
      { title: 'AI Engine', url: '/admin/ai', type: 'Admin', desc: 'Article generation and scheduling' },
      { title: 'Customizer', url: '/admin/customizer', type: 'Admin', desc: 'Homepage content and section visibility' },
      { title: 'Embedded UI for Industrial & Medical HMI', url: '/services/embedded-ui-hmi-development', type: 'Service', desc: 'TouchGFX on STM32 MCUs & Qt 6 / QML on Embedded Linux MPUs' },
      <% const searchSettingsSections = [
        ['Theme and palettes', 'theme-engine'], ['Branding and customizer', 'site-customizer'],
        ['SEO', 'seo-scripts'], ['Newsletter', 'newsletter-config'],
        ['SMTP and routing', 'smtp-settings'], ['Staff accounts', 'team-accounts']
      ]; %>
      <% searchSettingsSections.forEach(([title, section]) => { %>
        { title: <%- JSON.stringify(title) %>, url: '/admin/settings#<%= section %>', type: 'Settings', desc: 'Admin settings navigation' },
      <% }); %>
    ]);
  </script>

  <script src="/assets/js/theme-manager.js?v=<%= assetVersion %>"></script>
  <script src="/assets/js/admin-asset-localizer.js?v=<%= assetVersion %>"></script>
</body>
</html>
