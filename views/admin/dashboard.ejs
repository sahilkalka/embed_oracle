<%- include('layout_top') %>

<%
  const totalCalcRuns = Array.isArray(calculatorStats)
    ? calculatorStats.reduce((sum, s) => sum + (Number(s.executionCount) || 0), 0)
    : 0;
  const maxCalcRuns = Array.isArray(calculatorStats) && calculatorStats.length > 0
    ? Math.max(...calculatorStats.map(s => Number(s.executionCount) || 0), 1)
    : 1;
  const totalArticleViews = Array.isArray(topPosts)
    ? topPosts.reduce((sum, p) => sum + (Number(p.views) || 0), 0)
    : 0;
  const isPhoneVisible = !(typeof settings !== 'undefined' && settings && settings.show_phone_section === 'false');
  const isHeroVisible = !(typeof settings !== 'undefined' && settings && settings.show_hero_section === 'false');
  const isPortfolioVisible = !(typeof settings !== 'undefined' && settings && settings.show_portfolio_section === 'false');
%>

<div class="w-full space-y-5 sm:space-y-6">
  
  <!-- Command Center Header + Quick Action Bar (Utilizes full horizontal width) -->
  <div class="bg-white dark:bg-brand-surface rounded-2xl p-4 sm:p-5 border border-slate-200 dark:border-brand-border shadow-xs flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-500/10 dark:bg-accent/15 border border-brand-500/20 text-brand-700 dark:text-accent text-[11px] font-extrabold uppercase tracking-wider mb-1.5">
        <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
        <span>Engineering Operations Console</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Admin Command Center</h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">Unified workspace for RFQ leads, portfolio publishing, calculator telemetry, and system configuration.</p>
    </div>

    <!-- Quick-Action Icon Toolbar (Balanced 2-col grid on mobile, inline flex row on tablet/desktop) -->
    <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 shrink-0">
      <a href="/admin/posts/new" class="col-span-2 sm:col-span-1 inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 sm:py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold shadow-xs transition">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/></svg>
        <span>New Article</span>
      </a>
      <a href="/admin/projects/new" class="inline-flex items-center justify-center sm:justify-start gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-xs font-bold transition">
        <svg class="w-3.5 h-3.5 text-brand-600 dark:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        <span class="truncate">New Case Study</span>
      </a>
      <a href="/admin/settings#ai-engine" class="inline-flex items-center justify-center sm:justify-start gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-xs font-bold transition">
        <svg class="w-3.5 h-3.5 text-brand-600 dark:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        <span class="truncate">AI Studio</span>
      </a>
      <a href="/admin/traffic" class="inline-flex items-center justify-center sm:justify-start gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-xs font-bold transition">
        <svg class="w-3.5 h-3.5 text-brand-600 dark:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        <span class="truncate">Traffic Stream</span>
      </a>
      <a href="/admin/settings#site-customizer" class="inline-flex items-center justify-center sm:justify-start gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-xs font-bold transition">
        <svg class="w-3.5 h-3.5 text-brand-600 dark:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
        <span class="truncate">Site Customizer</span>
      </a>
    </div>
  </div>

  <!-- ZONE 1: Compact KPI Pulse Ribbon (2-col on mobile, 3-col on tablet, 5-col on desktop) -->
  <section aria-label="Key Performance Indicators">
    <div class="flex items-center justify-between gap-2 mb-3">
      <h2 class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5 min-w-0 truncate">
        <svg class="w-4 h-4 shrink-0 text-brand-500 dark:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        <span class="truncate">Platform Telemetry</span>
      </h2>
      <div class="flex items-center gap-3 shrink-0">
        <span class="hidden sm:inline-flex items-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400 font-semibold">
          <span>Tool Executions:</span>
          <strong class="font-mono text-slate-800 dark:text-slate-200"><%= totalCalcRuns %></strong>
        </span>
        <span class="text-[11px] text-brand-600 dark:text-accent font-bold inline-flex items-center gap-1.5 shrink-0 whitespace-nowrap">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
          <span>Live Sync</span>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
      
      <!-- KPI 1: Consultation Inquiries -->
      <div class="bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div>
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">RFQ Inquiries</span>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white"><%= totalInquiries %></span>
              <% if (newInquiries > 0) { %>
                <span class="px-1.5 py-0.5 bg-red-100 dark:bg-red-950/60 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 text-[10px] font-bold rounded-full"><%= newInquiries %> New</span>
              <% } else { %>
                <span class="px-1.5 py-0.5 bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent text-[10px] font-bold rounded-full">Reviewed</span>
              <% } %>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
        </div>
        <a href="/admin/inquiries" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span>Open Inbox</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- KPI 2: Active Subscribers -->
      <div class="bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div>
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Subscribers</span>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white"><%= activeSubscribers %></span>
              <span class="text-[10px] text-slate-400 font-semibold">/ <%= totalSubscribers %> Active</span>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
        </div>
        <a href="/admin/subscribers" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span>Manage List</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- KPI 3: Portfolio Projects -->
      <div class="bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div>
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Case Studies</span>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white"><%= typeof totalProjects !== 'undefined' ? totalProjects : 0 %></span>
              <span class="px-1.5 py-0.5 bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent text-[10px] font-black rounded-full"><%= typeof featuredProjects !== 'undefined' ? featuredProjects : 0 %> Featured</span>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
        </div>
        <a href="/admin/projects" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span>Manage Portfolio</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- KPI 4: Published Articles -->
      <div class="bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div>
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Tech Guides</span>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white"><%= totalPosts %></span>
              <span class="px-1.5 py-0.5 bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent text-[10px] font-bold rounded-full"><%= totalArticleViews %> Reads</span>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
          </div>
        </div>
        <a href="/admin/posts" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span>Manage Blogs</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- KPI 5: Total Page Views -->
      <div class="col-span-2 sm:col-span-1 bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div>
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Page Views</span>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white"><%= pageViews %></span>
              <span class="px-1.5 py-0.5 bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent text-[10px] font-bold rounded-full">24h</span>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
        </div>
        <a href="/admin/traffic" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
            <span>Live Traffic Active</span>
          </span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ZONE 2: Balanced 2x2 Operations Workspace Grid -->
  <section aria-label="Operations Workspace" class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 items-stretch">
    
    <!-- Card 1 (Row 1, Left): Lead & Audience Pipeline Hub -->
    <div class="bg-white dark:bg-brand-surface rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-brand-border shadow-xs h-full flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between gap-3 pb-3.5 mb-4 border-b border-slate-100 dark:border-brand-border">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 shrink-0 rounded-lg bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div class="min-w-0">
              <h2 class="text-sm font-black text-slate-900 dark:text-white truncate">Lead &amp; Audience Pipeline</h2>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">RFQs, subscribers, reviews &amp; public visibility</p>
            </div>
          </div>
          <a href="/admin/inquiries" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-slate-100 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 text-brand-700 dark:text-accent border border-slate-200/80 dark:border-brand-border shrink-0 whitespace-nowrap transition">
            <svg class="w-3.5 h-3.5 text-brand-600 dark:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>CRM Hub</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="/admin/inquiries" class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 border border-slate-200/80 dark:border-brand-border transition group">
            <div class="flex items-center gap-3 min-w-0">
              <svg class="w-4 h-4 text-brand-600 dark:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-accent truncate">Review RFQ Inbox</span>
                <span class="block text-[10px] text-slate-500"><%= totalInquiries %> total &bull; <%= newInquiries %> unread</span>
              </div>
            </div>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>

          <a href="/admin/subscribers" class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 border border-slate-200/80 dark:border-brand-border transition group">
            <div class="flex items-center gap-3 min-w-0">
              <svg class="w-4 h-4 text-brand-600 dark:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-accent truncate">Newsletter Leads</span>
                <span class="block text-[10px] text-slate-500"><%= activeSubscribers %> active subscribers</span>
              </div>
            </div>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>

