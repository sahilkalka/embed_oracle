<%- include('layout_top') %>

<%
  const totalCalcRuns = Array.isArray(calculatorStats)
    ? calculatorStats.reduce((sum, s) => sum + (Number(s.executionCount) || 0), 0)
    : 0;
  const maxCalcRuns = Array.isArray(calculatorStats) && calculatorStats.length > 0
    ? Math.max(...calculatorStats.map(s => Number(s.executionCount) || 0), 1)
    : 1;
  const totalArticleViews = Array.isArray(topPosts)
    ? topPosts.reduce((sum, p) => sum + (Number(p.views) || 0), 0)
    : 0;
  const isPhoneVisible = !(typeof settings !== 'undefined' && settings && settings.show_phone_section === 'false');
  const isHeroVisible = !(typeof settings !== 'undefined' && settings && settings.show_hero_section === 'false');
  const isPortfolioVisible = !(typeof settings !== 'undefined' && settings && settings.show_portfolio_section === 'false');
  const attentionCount = (Number(newInquiries) || 0) + (Number(draftPostCount) || 0) + (Number(scheduledPostCount) || 0);
%>

<div class="w-full space-y-5 sm:space-y-6">
  
  <%- include('partials/admin-command-center', { isDashboard: true }) %>

  <section aria-labelledby="needs-attention-title" class="space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-1">
      <div>
        <h2 id="needs-attention-title" class="flex items-center gap-2 text-sm font-black text-slate-900 dark:text-white">
          <span class="material-symbols-rounded text-base text-amber-500 shrink-0 leading-none" aria-hidden="true">warning</span>
          <span>Needs attention</span>
        </h2>
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
          <%= attentionCount %> item<%= attentionCount === 1 ? '' : 's' %> to review or monitor.
        </p>
      </div>
      <span class="text-[10px] font-bold uppercase tracking-wider <%= attentionCount > 0 ? 'text-amber-700 dark:text-amber-300' : 'text-emerald-700 dark:text-emerald-300' %>">
        <%= attentionCount > 0 ? 'Action queue' : 'All caught up' %>
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <article class="min-w-0 bg-white dark:bg-brand-surface rounded-2xl p-4 border border-slate-200 dark:border-brand-border shadow-xs">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-300 flex items-center justify-center shrink-0">
              <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">mail</span>
            </span>
            <div class="min-w-0">
              <h3 class="text-xs font-black text-slate-900 dark:text-white">New RFQs</h3>
              <p class="text-[10px] text-slate-500 dark:text-slate-400"><%= newInquiries %> awaiting first review</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-black <%= newInquiries > 0 ? 'bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300' : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400' %>"><%= newInquiries %></span>
        </div>
        <% if (!Array.isArray(newInquiryLeads) || newInquiryLeads.length === 0) { %>
          <p class="mt-3 text-[11px] text-slate-500 dark:text-slate-400">No new inquiries are waiting.</p>
        <% } else { %>
          <ul class="mt-3 space-y-2">
            <% newInquiryLeads.forEach(inquiry => { %>
              <li>
                <a href="/admin/inquiries?status=new" class="flex items-center justify-between gap-2 rounded-lg p-2 -mx-2 hover:bg-slate-50 dark:hover:bg-brand-dark transition group">
                  <span class="min-w-0">
                    <span class="block text-[11px] font-bold text-slate-800 dark:text-slate-200 truncate group-hover:text-brand-600 dark:group-hover:text-accent"><%= inquiry.name %></span>
                    <span class="block text-[10px] text-slate-500 dark:text-slate-400 truncate"><%= inquiry.subject || inquiry.serviceCategory || 'General inquiry' %></span>
                  </span>
                  <span class="text-[10px] text-slate-400 shrink-0"><%= new Date(inquiry.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                </a>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <a href="/admin/inquiries?status=new" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-[11px] text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center gap-1.5">
          <span>Review new RFQs</span>
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">arrow_forward</span>
        </a>
      </article>

      <article class="min-w-0 bg-white dark:bg-brand-surface rounded-2xl p-4 border border-slate-200 dark:border-brand-border shadow-xs">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-300 flex items-center justify-center shrink-0">
              <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">edit_note</span>
            </span>
            <div class="min-w-0">
              <h3 class="text-xs font-black text-slate-900 dark:text-white">Draft articles</h3>
              <p class="text-[10px] text-slate-500 dark:text-slate-400"><%= draftPostCount %> not public yet</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= draftPostCount %></span>
        </div>
        <% if (!Array.isArray(draftPostQueue) || draftPostQueue.length === 0) { %>
          <p class="mt-3 text-[11px] text-slate-500 dark:text-slate-400">No drafts are waiting for review.</p>
        <% } else { %>
          <ul class="mt-3 space-y-2">
            <% draftPostQueue.forEach(post => { %>
              <li>
                <a href="/admin/posts/<%= post.id %>/edit" class="flex items-center justify-between gap-2 rounded-lg p-2 -mx-2 hover:bg-slate-50 dark:hover:bg-brand-dark transition group">
                  <span class="min-w-0">
                    <span class="block text-[11px] font-bold text-slate-800 dark:text-slate-200 truncate group-hover:text-brand-600 dark:group-hover:text-accent"><%= post.title %></span>
                    <span class="block text-[10px] text-slate-500 dark:text-slate-400">Updated <%= new Date(post.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                  </span>
                  <span class="material-symbols-rounded text-base text-slate-400 shrink-0 leading-none group-hover:text-brand-600 dark:group-hover:text-accent" aria-hidden="true">arrow_forward</span>
                </a>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <a href="/admin/posts" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-[11px] text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center gap-1.5">
          <span>Manage articles</span>
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">arrow_forward</span>
        </a>
      </article>

      <article class="min-w-0 bg-white dark:bg-brand-surface rounded-2xl p-4 border border-slate-200 dark:border-brand-border shadow-xs">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-8 h-8 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-300 flex items-center justify-center shrink-0">
              <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">schedule</span>
            </span>
            <div class="min-w-0">
              <h3 class="text-xs font-black text-slate-900 dark:text-white">Scheduled articles</h3>
              <p class="text-[10px] text-slate-500 dark:text-slate-400"><%= scheduledPostCount %> queued to publish</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-sky-100 text-sky-700 dark:bg-sky-950/60 dark:text-sky-300"><%= scheduledPostCount %></span>
        </div>
        <% if (!Array.isArray(scheduledPostQueue) || scheduledPostQueue.length === 0) { %>
          <p class="mt-3 text-[11px] text-slate-500 dark:text-slate-400">No articles are scheduled.</p>
        <% } else { %>
          <ul class="mt-3 space-y-2">
            <% scheduledPostQueue.forEach(post => { %>
              <li>
                <a href="/admin/posts/<%= post.id %>/edit" class="flex items-center justify-between gap-2 rounded-lg p-2 -mx-2 hover:bg-slate-50 dark:hover:bg-brand-dark transition group">
                  <span class="min-w-0">
                    <span class="block text-[11px] font-bold text-slate-800 dark:text-slate-200 truncate group-hover:text-brand-600 dark:group-hover:text-accent"><%= post.title %></span>
                    <span class="block text-[10px] <%= post.scheduledAt ? 'text-slate-500 dark:text-slate-400' : 'text-amber-700 dark:text-amber-300 font-semibold' %>"><%= post.scheduledAt ? new Date(post.scheduledAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : 'Schedule time missing' %></span>
                  </span>
                  <span class="material-symbols-rounded text-base text-slate-400 shrink-0 leading-none group-hover:text-brand-600 dark:group-hover:text-accent" aria-hidden="true">arrow_forward</span>
                </a>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <a href="/admin/posts" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-[11px] text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center gap-1.5">
          <span>Review schedule</span>
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">arrow_forward</span>
        </a>
      </article>
    </div>
  </section>

  <!-- ZONE 1: Compact KPI Pulse Ribbon (2-col on mobile, 3-col on tablet, 5-col on desktop) -->
  <section aria-label="Key Performance Indicators">
    <div class="flex items-center justify-between gap-2 mb-3">
      <h2 class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5 min-w-0 truncate">
        <span class="material-symbols-rounded text-base shrink-0 text-brand-500 dark:text-accent leading-none" aria-hidden="true">monitoring</span>
        <span class="truncate">Platform Telemetry</span>
      </h2>
      <div class="flex items-center gap-3 shrink-0">
        <span class="hidden sm:inline-flex items-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400 font-semibold">
          <span>Tool Executions:</span>
          <strong class="font-mono text-slate-800 dark:text-slate-200"><%= totalCalcRuns %></strong>
        </span>
        <span class="text-[11px] text-brand-600 dark:text-accent font-bold inline-flex items-center gap-1.5 shrink-0 whitespace-nowrap">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
          <span>Live Sync</span>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
      
      <!-- KPI 1: Consultation Inquiries -->
      <div class="bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">RFQ Inquiries</span>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mt-1 min-w-0">
              <span class="text-2xl 2xl:text-3xl font-black text-slate-900 dark:text-white"><%= totalInquiries %></span>
              <% if (newInquiries > 0) { %>
                <span class="max-w-full px-1.5 py-0.5 bg-red-100 dark:bg-red-950/60 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 text-[10px] font-bold leading-tight rounded-full"><%= newInquiries %> New</span>
              <% } else { %>
                <span class="max-w-full px-1.5 py-0.5 bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent text-[10px] font-bold leading-tight rounded-full">Reviewed</span>
              <% } %>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">mail</span>
          </div>
        </div>
        <a href="/admin/inquiries" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span>Open Inbox</span>
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <!-- KPI 2: Active Subscribers -->
      <div class="bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Subscribers</span>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mt-1 min-w-0">
              <span class="text-2xl 2xl:text-3xl font-black text-slate-900 dark:text-white"><%= activeSubscribers %></span>
              <span class="text-[10px] text-slate-400 font-semibold">/ <%= totalSubscribers %> Active</span>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">group</span>
          </div>
        </div>
        <a href="/admin/subscribers" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span>Manage List</span>
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <!-- KPI 3: Portfolio Projects -->
      <div class="bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Case Studies</span>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mt-1 min-w-0">
              <span class="text-2xl 2xl:text-3xl font-black text-slate-900 dark:text-white"><%= typeof totalProjects !== 'undefined' ? totalProjects : 0 %></span>
              <span class="max-w-full px-1.5 py-0.5 bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent text-[10px] font-black leading-tight rounded-full"><%= typeof featuredProjects !== 'undefined' ? featuredProjects : 0 %> Featured</span>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">inventory_2</span>
          </div>
        </div>
        <a href="/admin/projects" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span>Manage Portfolio</span>
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <!-- KPI 4: Published Articles -->
      <div class="bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Tech Guides</span>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mt-1 min-w-0">
              <span class="text-2xl 2xl:text-3xl font-black text-slate-900 dark:text-white"><%= totalPosts %></span>
              <span class="max-w-full px-1.5 py-0.5 bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent text-[10px] font-bold leading-tight rounded-full"><%= totalArticleViews %> Reads</span>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">article</span>
          </div>
        </div>
        <a href="/admin/posts" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span>Manage Blogs</span>
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <!-- KPI 5: Total Page Views -->
      <div class="col-span-2 sm:col-span-1 bg-white dark:bg-brand-surface p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-brand-border shadow-xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Page Views</span>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mt-1 min-w-0">
              <span class="text-2xl 2xl:text-3xl font-black text-slate-900 dark:text-white break-all"><%= pageViews %></span>
              <span class="px-1.5 py-0.5 bg-brand-500/10 dark:bg-accent/15 text-brand-700 dark:text-accent text-[10px] font-bold leading-tight rounded-full shrink-0">24h</span>
            </div>
          </div>
          <div class="w-9 h-9 rounded-xl bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center shrink-0">
            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">visibility</span>
          </div>
        </div>
        <a href="/admin/traffic" class="mt-3 pt-2.5 border-t border-slate-100 dark:border-brand-border text-xs text-brand-700 dark:text-accent hover:underline font-bold inline-flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
            <span>Live Traffic Active</span>
          </span>
          <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ZONE 2: Balanced 2x2 Operations Workspace Grid -->
  <section aria-label="Operations Workspace" class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 items-stretch">
    
    <!-- Card 1 (Row 1, Left): Lead & Audience Pipeline Hub -->
    <div class="bg-white dark:bg-brand-surface rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-brand-border shadow-xs h-full flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between gap-3 pb-3.5 mb-4 border-b border-slate-100 dark:border-brand-border">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 shrink-0 rounded-lg bg-brand-500/10 dark:bg-accent/15 text-brand-600 dark:text-accent flex items-center justify-center">
              <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">groups</span>
            </div>
            <div class="min-w-0">
              <h2 class="text-sm font-black text-slate-900 dark:text-white truncate">Lead &amp; Audience Pipeline</h2>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">RFQs, subscribers, reviews &amp; public visibility</p>
            </div>
          </div>
          <a href="/admin/inquiries" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-slate-100 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 text-brand-700 dark:text-accent border border-slate-200/80 dark:border-brand-border shrink-0 whitespace-nowrap transition">
            <span class="material-symbols-rounded text-base text-brand-600 dark:text-accent shrink-0 leading-none" aria-hidden="true">mail</span>
            <span>CRM Hub</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="/admin/inquiries" class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 border border-slate-200/80 dark:border-brand-border transition group">
            <div class="flex items-center gap-3 min-w-0">
              <span class="material-symbols-rounded text-base text-brand-600 dark:text-accent shrink-0 leading-none" aria-hidden="true">inbox</span>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-accent truncate">Review RFQ Inbox</span>
                <span class="block text-[10px] text-slate-500"><%= totalInquiries %> total &bull; <%= newInquiries %> unread</span>
              </div>
            </div>
            <span class="material-symbols-rounded text-base text-slate-400 group-hover:text-brand-600 dark:group-hover:text-accent shrink-0 leading-none" aria-hidden="true">arrow_forward</span>
          </a>

          <a href="/admin/subscribers" class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 border border-slate-200/80 dark:border-brand-border transition group">
            <div class="flex items-center gap-3 min-w-0">
              <span class="material-symbols-rounded text-base text-brand-600 dark:text-accent shrink-0 leading-none" aria-hidden="true">mail</span>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-accent truncate">Newsletter Leads</span>
                <span class="block text-[10px] text-slate-500"><%= activeSubscribers %> active subscribers</span>
              </div>
            </div>
            <span class="material-symbols-rounded text-base text-slate-400 group-hover:text-brand-600 dark:group-hover:text-accent shrink-0 leading-none" aria-hidden="true">arrow_forward</span>
          </a>

          <a href="/admin/testimonials" class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-brand-dark hover:bg-brand-500/10 dark:hover:bg-accent/15 border border-slate-200/80 dark:border-brand-border transition group">
            <div class="flex items-center gap-3 min-w-0">
              <span class="material-symbols-rounded text-base text-brand-600 dark:text-accent shrink-0 leading-none" aria-hidden="true">star</span>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-accent truncate">Client Testimonials</span>
                <span class="block text-[10px] text-slate-500">Manage social proof</span>
              </div>
            </div>
