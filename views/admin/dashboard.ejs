            </div>
            <div class="min-w-0">
              <h2 class="text-sm font-black text-slate-900 dark:text-white truncate">Calculator Telemetry</h2>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate"><%= totalCalcRuns %> total hardware &amp; firmware tool runs</p>
            </div>
          </div>
          <a href="/tools" target="_blank" aria-label="Open Tools Hub" title="Open Tools Hub" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-brand-dark text-brand-700 dark:text-accent hover:bg-brand-500/10 dark:hover:bg-accent/15 border border-slate-200/80 dark:border-brand-border text-[11px] font-bold transition shrink-0">
            <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">open_in_new</span>
            <span>Tools Hub</span>
          </a>
        </div>

        <% 
          const toolLabels = {
            'pcb-trace': 'PCB Trace Width (IPC-2221)',
            '555-timer': '555 Timer Astable',
            'led-resistor': 'LED Series Resistor',
            'uart-baud': 'UART Baud Rate Error',
            'smd-code': 'SMD Resistor Code',
            'battery-life': 'IoT Battery Life',
            'trace-impedance': 'Microstrip Impedance',
            'mcu-pinout': 'MCU Pinout Guide'
          };
        %>
        <% if (calculatorStats.length === 0) { %>
          <p class="py-4 text-xs text-slate-400 text-center">No telemetry recorded yet.</p>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <% calculatorStats.slice(0, 6).forEach(stat => { 
              const count = Number(stat.executionCount) || 0;
              const barPct = Math.max(8, Math.min(100, Math.round((count / maxCalcRuns) * 100)));
              const sharePct = totalCalcRuns > 0 ? Math.round((count / totalCalcRuns) * 100) : 0;
            %>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200/80 dark:border-brand-border flex flex-col justify-between gap-2 text-xs">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-mono font-bold text-slate-800 dark:text-slate-200 truncate">
                    <%= toolLabels[stat.toolName] || stat.toolName.toUpperCase() %>
                  </span>
                  <span class="px-2 py-0.5 bg-white dark:bg-brand-surface text-brand-700 dark:text-accent border border-slate-200 dark:border-brand-border font-mono font-bold rounded-md shrink-0 whitespace-nowrap">
                    <%= count %> runs
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="flex-1 h-1.5 rounded-full bg-slate-200 dark:bg-brand-surface overflow-hidden">
                    <div class="h-full rounded-full bg-brand-500" style="width: <%= barPct %>%"></div>
                  </div>
                  <span class="text-[10px] font-mono text-slate-500 dark:text-slate-400 shrink-0"><%= sharePct %>%</span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-100 dark:border-brand-border flex items-center justify-between gap-2 text-xs">
