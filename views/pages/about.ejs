<%- include('../layouts/header') %>

<!-- Hero Header (2-Column Grid with Hairline Rapid Prototyping Bench) -->
<section class="py-16 lg:py-20 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border spaceship-ambient-mesh circuit-grid relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Copy & Identity -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/90 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-100 text-xs font-bold uppercase tracking-wider shadow-sm backdrop-blur-md animate-float-slow">
          <span class="w-2 h-2 rounded-full bg-brand-500 dark:bg-accent animate-ping flex-shrink-0"></span>
          <span class="font-extrabold text-slate-800 dark:text-slate-100">Who We Are</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 dark:text-white mt-4 tracking-tight leading-tight">
          A Freelance Embedded Engineering Collective
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-700 dark:text-slate-200 leading-relaxed font-normal">
          We are a collective of specialized freelance embedded hardware, firmware, UI/HMI, and prototype testing experts. We focus on design, development, testing, and prototyping on flexible fixed-bid and hourly/daily rates.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4 text-xs font-semibold text-slate-600 dark:text-slate-300">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-brand-surface border border-slate-200 dark:border-brand-border">
            <span class="material-symbols-rounded text-sm text-brand-500 dark:text-accent">verified</span>
            <span>No Corporate Overhead</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-brand-surface border border-slate-200 dark:border-brand-border">
            <span class="material-symbols-rounded text-sm text-brand-500 dark:text-accent">memory</span>
            <span>Hardware + Firmware Co-Design</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-brand-surface border border-slate-200 dark:border-brand-border">
            <span class="material-symbols-rounded text-sm text-brand-500 dark:text-accent">speed</span>
            <span>Rapid Prototype Bring-Up</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Hairline Turntable Inspection Visualizer -->
      <div class="lg:col-span-5">
        <div class="w-full h-64 sm:h-72 rounded-3xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3 relative overflow-hidden shadow-xl">
          <div class="absolute top-3 left-4 text-[10px] font-mono font-bold text-emerald-600 dark:text-accent tracking-wider flex items-center gap-1.5 z-10 pointer-events-none">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span>PROTOTYPE BRING-UP BENCH</span>
          </div>
          <hairline-figure figure="turntable-inspection" intensity="0.85" play="true" class="w-full h-full"></hairline-figure>
          <div class="absolute bottom-2.5 right-4 text-[10px] font-mono text-slate-500 dark:text-slate-400 z-10 pointer-events-none">
            Precision 360° Rotary Inspection
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Vision & Mission Statement -->
<section id="vision" class="py-20 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-14 border border-slate-200 dark:border-brand-border shadow-xl">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Our Mission</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mt-2">
          Design, Development, Testing &amp; Prototyping
        </h2>
        <p class="mt-6 text-lg sm:text-xl text-slate-700 dark:text-slate-200 leading-relaxed font-normal">
          Our mission is to give you direct access to senior embedded engineering talent without corporate overhead or agency markups. We deliver precision hardware schematics, deterministic RTOS firmware, responsive TouchGFX and Qt HMIs, rapid prototyping, and rigorous bench testing.
        </p>
      </div>
    </div>

    <!-- 3 Core Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      
      <!-- Pillar 1 -->
      <div class="spotlight-card reveal-on-scroll bg-white dark:bg-brand-surface p-8 rounded-3xl border border-slate-200 dark:border-brand-border shadow-md">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-900/60 flex items-center justify-center mb-6 icon-bounce-container">
          <img src="/assets/images/mission1.svg" alt="Precision Engineering" class="w-10 h-10" loading="lazy" decoding="async" onerror="this.src='/favicon.svg'">
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Precision Prototype Testing</h3>
        <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
          We bring up physical prototype hardware on our benches, execute signal integrity tests, and build automated Hardware-in-the-Loop (HIL) test rigs to catch bugs before external manufacturing.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="spotlight-card reveal-on-scroll delay-100 bg-white dark:bg-brand-surface p-8 rounded-3xl border border-slate-200 dark:border-brand-border shadow-md">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-900/60 flex items-center justify-center mb-6 icon-bounce-container">
          <img src="/assets/images/mission2.svg" alt="Direct Senior Access" class="w-10 h-10" loading="lazy" decoding="async" onerror="this.src='/favicon.svg'">
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Direct Senior Access</h3>
        <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
          You communicate directly with the senior freelance engineer designing your circuits, coding your BSP, or programming your TouchGFX/Qt GUI. No middlemen, no miscommunication.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="spotlight-card reveal-on-scroll delay-200 bg-white dark:bg-brand-surface p-8 rounded-3xl border border-slate-200 dark:border-brand-border shadow-md">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-900/60 flex items-center justify-center mb-6 icon-bounce-container">
          <img src="/assets/images/mission3.svg" alt="Flexible Contracts" class="w-10 h-10" loading="lazy" decoding="async" onerror="this.src='/favicon.svg'">
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Fixed Bid or Hourly/Daily Rates</h3>
        <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
          Transparent contracts aligned with your budget: choose fixed-bid milestone projects with clear deliverables, or hire senior engineers by the hour or day for agile R&amp;D.
        </p>
      </div>

    </div>

<%- include('../partials/counter-metrics') %>

    <!-- Offices & Engineering Presence -->
    <section id="presence" class="mt-12 bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-10 border border-slate-200 dark:border-brand-border shadow-md">
      <div id="lab" class="flex flex-col md:flex-row md:items-center justify-between gap-6 scroll-mt-28">
        <div>
          <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Freelance Collective Hub</span>
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mt-1">Headquarters &amp; Lab</h3>
          <p class="text-sm text-slate-700 dark:text-slate-300 mt-2 font-medium flex items-center space-x-2">
            <span>📍</span>
            <span><%= settings.contact_address || 'Hyderabad, India' %></span>
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-xs font-semibold">
          <a href="mailto:<%= settings.contact_email || 'info@embeddedindia.in' %>" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl font-bold transition shadow-md inline-flex items-center gap-2">
            <span class="material-symbols-rounded text-base" aria-hidden="true">mail</span>
            <span><%= settings.contact_email || 'info@embeddedindia.in' %></span>
          </a>
          <% if (settings.contact_phone && (settings.phone_visible !== '0' && settings.phone_visible !== 'false' && settings.phone_visible !== false && settings.phone_visible !== 0)) { %>
            <a href="tel:<%= settings.contact_phone.replace(/[^0-9+]/g, '') %>" class="px-5 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-xl font-bold transition border border-slate-300 dark:border-slate-700 inline-flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span><%= settings.contact_phone %></span>
            </a>
          <% } %>
        </div>
      </div>
    </section>

  </div>
</section>

<section class="py-16 bg-white dark:bg-brand-dark">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<h2 class="text-3xl font-black text-slate-900 dark:text-white text-center">Freelance Engineering Disciplines</h2>
<p class="text-center text-sm text-slate-600 dark:text-slate-300 mt-3">Specialized embedded hardware, firmware, UI/HMI, and prototype testing disciplines working together seamlessly.</p>
<div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
<% [
  ['HW', 'Embedded Hardware', 'Schematic capture, high-speed multi-layer PCB layout, component sourcing, and prototype DFM reviews.'],
  ['FW', 'Firmware & BSP', 'Microcontroller bare-metal C/C++, FreeRTOS/Zephyr integration, board bring-up, and fail-safe FOTA.'],
  ['UI', 'Embedded UI & HMI', 'TouchGFX on STM32 MCUs (core specialty), Qt 6 / QML on Linux MPUs, and clinical/industrial displays.'],
  ['QA', 'Prototype Testing & HIL', 'Bench bring-up, automated Hardware-in-the-Loop test rigs, fault injection, and signal integrity validation.']
].forEach(member => { %>
<div class="p-6 rounded-2xl border border-slate-200 dark:border-brand-border bg-slate-50 dark:bg-brand-surface"><span aria-hidden="true" class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-brand-50 dark:bg-brand-900 text-brand-700 dark:text-accent font-bold"><%= member[0] %></span><h3 class="mt-4 font-bold text-slate-900 dark:text-white"><%= member[1] %></h3><p class="mt-2 text-sm text-slate-600 dark:text-slate-300"><%= member[2] %></p></div>
<% }); %>
</div></div></section>
<%- include('../partials/cta-banner') %>

<script src="/js/counters.js" defer></script>

<%- include('../layouts/footer') %>
