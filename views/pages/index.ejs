<%- include('../layouts/header') %>

<% if (settings.section_hero_enabled !== "false") { %>
<!-- Spaceship-Inspired Ambient Hero Section with Interactive Canvas -->
<section class="relative overflow-hidden spaceship-ambient-mesh circuit-grid py-16 lg:py-24 border-b border-slate-200/80 dark:border-[#1e3831] transition-colors">
  
  

  <!-- Animated Glowing Ambient Orbs -->
  <div class="absolute -top-32 left-1/4 w-[450px] h-[450px] bg-brand-500/15 dark:bg-brand-500/25 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
  <div class="absolute top-1/2 -right-20 w-[450px] h-[450px] bg-accent/15 dark:bg-accent/25 rounded-full blur-3xl pointer-events-none animate-pulse-glow" style="animation-delay: 2.5s;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Copy, Animated Typewriter, Category Pills & Live Spec Estimator -->
      <div class="w-full space-y-6 text-left">
        
        <!-- Live Status Pill with Floating Levitation Animation (High Contrast) -->
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-white dark:bg-brand-surface border border-slate-300 dark:border-brand-border text-slate-900 dark:text-white text-xs sm:text-sm font-black shadow-md backdrop-blur-md animate-float-slow">
          <span class="w-2.5 h-2.5 rounded-full bg-accent animate-ping"></span>
          <span>Freelance Embedded Hardware, Firmware, UI/HMI &amp; Prototype Testing Collective</span>
        </div>

        <!-- Big Punchy Title with Animated Rotating Typewriter Text -->
        <div class="space-y-2 text-left">
          <h1 class="text-4xl sm:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-none">
            <%= settings.hero_title || 'Think Big.' %> <br>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 via-brand-600 to-accent">
              <%= settings.hero_subtitle || 'We Engineer:' %>
            </span>
          </h1>
          <!-- Animated Typewriter Display (Left Aligned & High Contrast) -->
          <div class="min-h-[2.5rem] sm:min-h-[3rem] flex flex-wrap items-center justify-start text-2xl sm:text-4xl leading-[1.2] sm:leading-[1.2] font-extrabold text-slate-900 dark:text-white font-mono">
            <span id="typewriterTarget" class="text-brand-500 dark:text-accent font-black">High-Speed PCB Hardware</span>
            <span class="animate-cursor-blink text-brand-500 dark:text-accent ml-1 font-black">_</span>
          </div>
        </div>

        <p class="text-base sm:text-lg text-slate-700 dark:text-slate-200 max-w-2xl font-semibold leading-relaxed text-left">
          <%= settings.hero_description || 'We are a collective of freelance embedded specialists delivering end-to-end design, development, testing, and prototyping. Hardware design, deterministic RTOS firmware, TouchGFX & Qt UI/HMI, and bench verification on fixed-bid or hourly/daily billing.' %>
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-start gap-3 pt-1">
          <a href="/contact" class="btn-shimmer w-full sm:w-auto px-7 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-black rounded-xl shadow-lg shadow-brand-500/25 border border-white/20 transition transform hover:-translate-y-0.5 text-center text-sm active:scale-95 inline-flex items-center justify-center gap-2">
            <span class="material-symbols-rounded shrink-0 text-base leading-none" aria-hidden="true">call</span>
            <span>Request a free discovery call</span>
          </a>
          <a href="/services" class="w-full sm:w-auto px-7 py-3.5 bg-white dark:bg-brand-surface hover:bg-slate-100 dark:hover:bg-brand-dark text-slate-900 dark:text-white font-extrabold rounded-xl border border-slate-300 dark:border-brand-border transition shadow-sm text-center inline-flex items-center justify-center gap-2 text-sm active:scale-95">
            <span class="material-symbols-rounded shrink-0 text-base leading-none" aria-hidden="true">memory</span>
            <span>Explore Services</span>
          </a>
        </div>

        <!-- Hairline Silicon Lattice Kinetic Badge -->
        <div class="p-3.5 rounded-2xl bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border shadow-md backdrop-blur-sm flex items-center gap-4">
          <div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 relative overflow-hidden">
            <hairline-figure figure="silicon-lattice" intensity="0.85" play="true" class="w-full h-full"></hairline-figure>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 text-brand-600 dark:text-accent text-[11px] font-mono font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-ping"></span>
              <span>SILICON CORE KINETICS</span>
            </div>
            <p class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white mt-0.5 truncate">
              Interactive Isometric IC Bring-Up
            </p>
            <p class="text-[11px] text-slate-600 dark:text-slate-300 font-sans mt-0.5 line-clamp-1">
              Tracks cursor vector in real-time. Automatically adapts to active theme.
            </p>
          </div>
        </div>

        <!-- Animated Numerical Counter Metrics (Left Aligned) -->
        <div class="pt-6 border-t border-slate-200 dark:border-brand-border grid grid-cols-3 gap-4 text-left max-w-lg">
          <div>
            <p class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">
              <span class="count-up" data-target="100">0</span>+
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5 font-semibold">Delivered Systems</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-black text-brand-500 dark:text-accent font-mono">
              <span class="count-up" data-target="99.8" data-decimal="1">0</span>%
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5 font-semibold">First-Pass HIL Rate</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">
              &lt; <span class="count-up" data-target="24">0</span>h
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5 font-semibold">Architect Response</p>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Bring-Up Console (kept clear of the hero particle field) -->
      <div class="relative w-full" data-particles="off">

        <div id="hero-console" class="relative mx-auto w-full max-w-lg md:max-w-xl lg:max-w-none min-w-0 bg-white dark:bg-brand-surface rounded-3xl p-5 sm:p-6 shadow-2xl border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white flex flex-col">
          
          <!-- Window Titlebar -->
          <div class="hero-console-titlebar flex items-center justify-between pb-3 border-b border-slate-200 dark:border-brand-border">
            <div class="flex items-center space-x-2 min-w-0">
              <div class="w-3 h-3 rounded-full bg-red-500 shrink-0"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500 shrink-0"></div>
              <div class="w-3 h-3 rounded-full bg-green-500 shrink-0"></div>
              <span class="text-xs font-mono font-bold text-slate-700 dark:text-slate-300 ml-1.5 truncate">prototype_bringup.c</span>
            </div>
            <div class="flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[10px] font-mono font-bold tracking-wider shrink-0">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
              <span>BENCH ONLINE</span>
            </div>
          </div>

          <!-- Segmented Tab Navigation Bar (2x2 on Mobile, Full-width 4-across on Tablet & Desktop) -->
          <div class="mt-3.5 p-1 bg-slate-100 dark:bg-slate-900/90 rounded-xl border border-slate-200 dark:border-brand-border grid grid-cols-2 md:flex md:items-center w-full gap-1.5 md:gap-1" id="consoleTabs" role="tablist">
            <button id="tabBtnCode" type="button" role="tab" aria-selected="true" aria-controls="tabContentCode" data-tab="code" title="firmware.c (C Source Code)" class="console-tab-btn w-full md:flex-1 min-h-[38px] py-1.5 px-2 rounded-lg bg-white dark:bg-brand-surface text-brand-600 dark:text-accent font-black text-xs shadow-xs border border-slate-200/80 dark:border-white/10 inline-flex items-center justify-center gap-1.5 transition whitespace-nowrap overflow-hidden">
              <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">code</span>
              <span class="whitespace-nowrap truncate">firmware.c</span>
            </button>
            <button id="tabBtnScope" type="button" role="tab" aria-selected="false" aria-controls="tabContentScope" data-tab="scope" title="Oscilloscope (Live Waveform)" class="console-tab-btn w-full md:flex-1 min-h-[38px] py-1.5 px-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/50 dark:hover:bg-white/5 font-bold text-xs inline-flex items-center justify-center gap-1.5 transition whitespace-nowrap overflow-hidden">
              <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">show_chart</span>
              <span class="whitespace-nowrap truncate"><span class="hidden xl:inline">Oscilloscope</span><span class="xl:hidden">Scope</span></span>
            </button>
            <button id="tabBtnTerm" type="button" role="tab" aria-selected="false" aria-controls="tabContentTerminal" data-tab="terminal" title="Serial Monitor (UART 115200)" class="console-tab-btn w-full md:flex-1 min-h-[38px] py-1.5 px-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/50 dark:hover:bg-white/5 font-bold text-xs inline-flex items-center justify-center gap-1.5 transition whitespace-nowrap overflow-hidden">
              <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">terminal</span>
              <span class="whitespace-nowrap truncate">Serial</span>
            </button>
            <button id="tabBtnLogic" type="button" role="tab" aria-selected="false" aria-controls="tabContentLogic" data-tab="logic" title="Logic Probe (Digital Analyzer)" class="console-tab-btn w-full md:flex-1 min-h-[38px] py-1.5 px-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/50 dark:hover:bg-white/5 font-bold text-xs inline-flex items-center justify-center gap-1.5 transition whitespace-nowrap overflow-hidden">
              <span class="material-symbols-rounded text-base shrink-0 leading-none" aria-hidden="true">polyline</span>
              <span class="whitespace-nowrap truncate"><span class="hidden xl:inline">Logic Probe</span><span class="xl:hidden">Logic</span></span>
            </button>
          </div>

          <!-- IDE / Terminal Body (High Contrast Dark Slate Console) -->
          <div class="console-bench relative mt-3 rounded-2xl bg-[#030712] border border-slate-800 text-slate-200 shadow-inner overflow-hidden flex flex-col min-h-[240px]" style="background-color: #030712 !important; border-color: #1e293b !important;">
            <!-- Terminal Internal Status Bar -->
            <div class="console-bench-header px-4 py-2 bg-[#0b1117] border-b border-slate-800 flex items-center justify-between text-[11px] font-mono text-slate-400" style="background-color: #0b1117 !important; border-color: #1e293b !important; color: #94a3b8 !important;">
              <div class="flex items-center gap-2 min-w-0">
                <span class="material-symbols-rounded text-sm text-brand-400 shrink-0" style="color: #38bdf8 !important;">terminal</span>
                <span id="consoleActiveFilename" class="font-bold text-slate-300 truncate" style="color: #e2e8f0 !important;">src/bringup/main.c</span>
              </div>
              <span class="text-[10px] text-slate-400 font-semibold shrink-0" style="color: #94a3b8 !important;">GCC 13.2 • ARM Cortex-M</span>
            </div>

            <!-- Tab Content 1: Code View -->
            <div id="tabContentCode" class="p-4 font-mono text-xs leading-relaxed overflow-x-auto flex-1" style="background-color: #030712 !important;">
              <pre class="whitespace-pre-wrap break-words" style="margin: 0;"><code id="liveCodeSnippet" class="text-emerald-400 font-semibold" style="color: #34d399 !important; text-shadow: 0 0 10px rgba(52, 211, 153, 0.3); display: block;">// Embedded India Hardware & Firmware Core
void init_embedded_system(void) {
    power_rail_config(RAIL_3V3, ULTRA_LOW_NOISE);
    uart_baud_init(115200, OVERSAMPLE_16);
    lora_mesh_join(CHANNEL_915MHZ);
    hil_fault_injection_guard();
    start_freertos_scheduler();
}
// Status: Ready for Bring-up</code></pre>
            </div>

            <!-- Tab Content 2: Live HTML5 Canvas Oscilloscope with Multi-Signal Switcher -->
            <div id="tabContentScope" class="p-4 hidden flex-1 flex flex-col justify-between" style="background-color: #030712 !important;">
              <div class="text-[11px] font-mono text-slate-200 mb-2.5 font-bold flex flex-col min-[520px]:flex-row min-[520px]:items-center justify-between gap-2">
                <div class="flex items-center gap-1.5 text-brand-400 min-w-0">
                  <span class="material-symbols-rounded text-sm shrink-0 text-brand-400" aria-hidden="true">insights</span>
                  <span id="scopeSignalLabel" class="truncate">Signal: Clock PWM (10.0 MHz)</span>
                </div>
                <!-- Signal Selectors (Consistent Right-Aligned on Desktop/Tablet, Full Width Segmented on Mobile) -->
                <div class="flex items-center gap-1.5 w-full min-[520px]:w-auto shrink-0 justify-end" role="group" aria-label="Waveform">
                  <button type="button" data-wave="square" onclick="setWaveform('square')" class="waveform-btn min-h-[32px] px-2.5 py-1 flex-1 min-[520px]:flex-initial inline-flex items-center justify-center gap-1 bg-brand-500 text-white rounded-lg text-xs font-bold border border-brand-500 shadow-xs transition">
                    <span class="material-symbols-rounded text-xs shrink-0 leading-none" aria-hidden="true">graphic_eq</span>
                    <span>Square</span>
                  </button>
                  <button type="button" data-wave="sine" onclick="setWaveform('sine')" class="waveform-btn min-h-[32px] px-2.5 py-1 flex-1 min-[520px]:flex-initial inline-flex items-center justify-center gap-1 bg-slate-800/90 hover:bg-slate-700 text-slate-300 hover:text-white rounded-lg text-xs font-bold border border-slate-700 transition">
                    <span class="material-symbols-rounded text-xs shrink-0 leading-none" aria-hidden="true">waves</span>
                    <span>Sine</span>
                  </button>
                  <button type="button" data-wave="burst" onclick="setWaveform('burst')" class="waveform-btn min-h-[32px] px-2.5 py-1 flex-1 min-[520px]:flex-initial inline-flex items-center justify-center gap-1 bg-slate-800/90 hover:bg-slate-700 text-slate-300 hover:text-white rounded-lg text-xs font-bold border border-slate-700 transition">
                    <span class="material-symbols-rounded text-xs shrink-0 leading-none" aria-hidden="true">electric_bolt</span>
                    <span>Burst</span>
                  </button>
                </div>
              </div>
              <canvas id="scopeCanvas" width="400" height="130" class="w-full h-32 bg-black rounded-xl border border-slate-800"></canvas>
              <span class="text-[10px] text-slate-500 font-mono mt-2 text-center block font-medium">Synthesizing live hardware frequency domain</span>
            </div>

            <!-- Tab Content 3: Serial Monitor Boot Logs -->
            <div id="tabContentTerminal" class="p-4 hidden font-mono text-xs overflow-y-auto space-y-1.5 flex-1 max-h-[220px]" style="background-color: #030712 !important;">
              <div class="text-slate-400 font-bold mb-2" style="color: #94a3b8 !important;">// Connected to /dev/ttyUSB0 (115200 8N1)</div>
              <div id="terminalLogs" class="space-y-1">
                <div class="font-medium" style="color: #34d399 !important;"><span class="text-slate-500" style="color: #64748b !important;">[0.001s]</span> <span class="font-bold" style="color: #38bdf8 !important;">[POWER]</span> VDD_3V3 rail nominal: 3.302V &plusmn;0.01V... <span class="font-bold" style="color: #6ee7b7 !important;">OK</span></div>
                <div class="font-medium" style="color: #34d399 !important;"><span class="text-slate-500" style="color: #64748b !important;">[0.015s]</span> <span class="font-bold" style="color: #38bdf8 !important;">[CLOCK]</span> 72MHz PLL locked, jitter &lt; 5ps... <span class="font-bold" style="color: #6ee7b7 !important;">OK</span></div>
                <div class="font-medium" style="color: #34d399 !important;"><span class="text-slate-500" style="color: #64748b !important;">[0.045s]</span> <span class="font-bold" style="color: #38bdf8 !important;">[FLASH]</span> SPI NOR Winbond 16MB verified... <span class="font-bold" style="color: #6ee7b7 !important;">OK</span></div>
                <div class="font-medium" style="color: #34d399 !important;"><span class="text-slate-500" style="color: #64748b !important;">[0.092s]</span> <span class="font-bold" style="color: #fbbf24 !important;">[HIL]</span> Automated CAN bus fault loopback test... <span class="font-bold" style="color: #6ee7b7 !important;">PASS</span></div>
                <div class="font-bold" style="color: #38bdf8 !important;"><span class="text-slate-500" style="color: #64748b !important;">[0.120s]</span> <span class="font-bold" style="color: #34d399 !important;">[RTOS]</span> FreeRTOS kernel started. 4 tasks active.</div>
              </div>
            </div>

            <!-- Tab Content 4: Hairline Isometric Logic Analyzer -->
            <div id="tabContentLogic" class="p-3 hidden flex-1 flex flex-col justify-between" style="background-color: #030712 !important;">
              <div class="text-[11px] font-mono text-slate-200 mb-2 font-bold flex flex-wrap items-center justify-between gap-1">
                <div class="flex items-center gap-1.5 text-brand-400 min-w-0">
                  <span class="material-symbols-rounded text-sm shrink-0 text-brand-400" aria-hidden="true">insights</span>
                  <span>SPI / I2C Dual Phosphor Analyzer (60 FPS)</span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono">Cursor-Responsive Sweep</span>
              </div>
              <div class="h-44 w-full rounded-xl bg-slate-900/60 border border-slate-800 relative overflow-hidden" style="background-color: #030712 !important; border-color: #1e293b !important;">
                <hairline-figure figure="phosphor-analyzer" intensity="0.85" play="true" class="w-full h-full"></hairline-figure>
              </div>
            </div>
          </div>

          <!-- Interactive Action Bar: Run Virtual Bring-up -->
          <div class="mt-4 pt-3 border-t border-slate-200 dark:border-brand-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <button type="button" id="btnRunBringUp" class="min-h-[44px] w-full sm:w-auto shrink-0 px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-mono text-xs font-black rounded-xl transition flex items-center justify-center space-x-2 shadow-lg shadow-brand-500/20 border border-white/20 active:scale-95">
              <span class="material-symbols-rounded text-base leading-none" aria-hidden="true">play_arrow</span>
              <span>Run Virtual Bring-Up</span>
            </button>
            <div class="flex items-center justify-center sm:justify-end space-x-2 text-xs font-mono font-bold text-slate-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <span id="bringUpStatus">Board Status: ONLINE</span>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
<% } %>
<%- include('../partials/trust-bar') %>

<!-- Interactive Reference Architecture & Spec Inspector Section -->
<section class="py-16 bg-slate-50 dark:bg-[#0c1613] border-b border-slate-200/80 dark:border-brand-border/60 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-500/10 text-brand-600 dark:text-accent font-mono text-xs font-bold uppercase tracking-wider mb-2">
        <span class="material-symbols-rounded text-sm" aria-hidden="true">schema</span>
        <span>Reference Architectures</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
        Inspect Real-World Prototype Engineering Specs
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 font-medium max-w-2xl mx-auto">
        Select a real-world discipline below to examine typical microcontroller silicon, multi-layer PCB stackups, low-power sleep budgets, and fast-track turnaround schedules.
      </p>
    </div>

    <!-- 5 Archetype Selector Pills (Centered, Clean, High Contrast) -->
    <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-bold mb-6" id="archetypePills" role="group" aria-label="Engineering architecture examples">
      <button type="button" data-type="iot" aria-pressed="true" class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 text-white font-black border border-white/20 shadow-md transition transform hover:scale-105 archetype-btn">
        <span class="material-symbols-rounded shrink-0 text-base leading-none" aria-hidden="true">sensors</span>
        <span>IoT &amp; Wireless</span>
      </button>
      <button type="button" data-type="automotive" aria-label="Automotive CAN-FD" aria-pressed="false" class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-brand-surface text-slate-900 dark:text-white border border-slate-300 dark:border-brand-border hover:border-brand-500 transition archetype-btn font-bold">
        <span class="material-symbols-rounded shrink-0 text-base leading-none" aria-hidden="true">directions_car</span>
        <span>Automotive CAN-FD</span>
      </button>
      <button type="button" data-type="edgeai" aria-label="TinyML Edge AI" aria-pressed="false" class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-brand-surface text-slate-900 dark:text-white border border-slate-300 dark:border-brand-border hover:border-brand-500 transition archetype-btn font-bold">
        <span class="material-symbols-rounded shrink-0 text-base leading-none" aria-hidden="true">psychology</span>
        <span>TinyML Edge AI</span>
      </button>
      <button type="button" data-type="hmi" aria-pressed="false" class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-brand-surface text-slate-900 dark:text-white border border-slate-300 dark:border-brand-border hover:border-brand-500 transition archetype-btn font-bold">
        <span class="material-symbols-rounded shrink-0 text-base leading-none" aria-hidden="true">devices</span>
        <span>TouchGFX / Qt HMI</span>
      </button>
      <button type="button" data-type="highspeed" aria-label="High-Speed PCB" aria-pressed="false" class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-brand-surface text-slate-900 dark:text-white border border-slate-300 dark:border-brand-border hover:border-brand-500 transition archetype-btn font-bold">
        <span class="material-symbols-rounded shrink-0 text-base leading-none" aria-hidden="true">developer_board</span>
        <span>High-Speed PCB</span>
      </button>
    </div>

    <!-- Live Dynamic Architecture Preview Card -->
    <div class="max-w-4xl mx-auto bg-white dark:bg-brand-surface rounded-2xl p-6 sm:p-8 border border-slate-300 dark:border-brand-border shadow-md transition-all" id="archCard">
