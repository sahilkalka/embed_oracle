<!-- Interactive Scripts: Typewriter, Spotlight Cursor, Oscilloscope & Bring-Up -->
<script type="module">
  // 1. Typewriter Animation
  const typewriterTarget = document.getElementById('typewriterTarget');
  const typewriterPhrases = [
    'TouchGFX & Qt Embedded HMIs',
    'High-Speed PCB Layouts',
    'Automotive CAN-FD ECUs',
    'Ultra-Low Power Firmware',
    'TinyML Edge AI Nodes',
    'Connected IoT Hardware'
  ];
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  if (typewriterTarget) {
  function typeStep() {
    const currentPhrase = typewriterPhrases[phraseIndex];
    if (isDeleting) {
      typewriterTarget.textContent = currentPhrase.substring(0, charIndex - 1);
      charIndex--;
    } else {
      typewriterTarget.textContent = currentPhrase.substring(0, charIndex + 1);
      charIndex++;
    }

    let speed = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentPhrase.length) {
      speed = 2000; // Pause at end
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % typewriterPhrases.length;
      speed = 400; // Pause before typing next
    }

    setTimeout(typeStep, speed);
  }
  typeStep();
  }

  // 3. Spotlight Cursor Tracker on Service Cards
  document.querySelectorAll('.spotlight-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // 4. Metric Counter Animation
  function startCounters() {
    document.querySelectorAll('.count-up').forEach(el => {
      const target = parseFloat(el.getAttribute('data-target'));
      const isDecimal = el.getAttribute('data-decimal') === '1';
      let current = 0;
      const step = target / 40;
      const interval = setInterval(() => {
        current += step;
        if (current >= target) {
          el.textContent = isDecimal ? target.toFixed(1) : Math.round(target);
          clearInterval(interval);
        } else {
          el.textContent = isDecimal ? current.toFixed(1) : Math.round(current);
        }
      }, 30);
    });
  }
  startCounters();

  // 5. Archetypes Configurator Data
  const ARCHETYPES = {
    hmi: {
      mcu: 'STM32U5/H7 (TouchGFX) • i.MX8 (Qt)',
      pcb: '6-Layer MIPI-DSI / LVDS + PCAP',
      power: '60 FPS Chrom-ART / NeoChrom GPU',
      turn: '3 - 4 Weeks End-to-End',
      code: `// TouchGFX C++ MVP (STM32U5 NeoChrom GPU)
void MedicalHmiView::handleTickEvent() {
    presenter->pollVitalsQueue(&patientData);
    ecgWaveformGraph.addValue(patientData.ecgMv);
    spo2Gauge.updateValue(patientData.spo2Pct, 12);
    invalidate(); // 60 FPS DMA2D VSYNC transfer
}`
    },
    iot: {
      mcu: 'ESP32-S3 Dual 240MHz',
      pcb: '4-Layer FR-4 (1.6mm)',
      power: '< 15µA Deep Sleep',
      turn: '3 - 4 Weeks End-to-End',
      code: `// IoT Node Firmware (ESP32-S3)
void init_iot_node(void) {
    power_rail_config(RAIL_3V3, ULTRA_LOW_NOISE);
    lora_mesh_join(CHANNEL_915MHZ);
    bme680_sensor_read(&telemetry);
    esp_sleep_enable_timer_wakeup(60 * 1000000);
    esp_deep_sleep_start();
}`
    },
    automotive: {
      mcu: 'STM32H743 Cortex-M7 @ 480MHz',
      pcb: '6-Layer ENIG (ISO 7637-2 Surge)',
      power: '9V - 36V Automotive DC',
      turn: '4 - 5 Weeks with HIL',
      code: `// Automotive ECU (CAN-FD 5Mbps)
void can_fd_init(void) {
    FDCAN1->CCCR |= FDCAN_CCCR_FDOE | FDCAN_CCCR_BRSE;
    fdcan_set_bitrate(1000000, 5000000); // 1M Arb / 5M Data
    hil_watchdog_refresh();
    iso26262_safety_monitor_start();
}`
    },
    edgeai: {
      mcu: 'NXP i.MX RT1060 + Arm Ethos NPU',
      pcb: '6-Layer Controlled 50Ω/90Ω',
      power: 'Dynamic DVFS 1.2V / 3.3V',
      turn: '4 Weeks Prototype',
      code: `// TinyML Vibration Anomaly Detection
void run_edge_inference(const float* accel_fft) {
    tflite::MicroInterpreter interpreter(model, tensor_arena);
    interpreter.Invoke();
    float anomaly_score = interpreter.output(0)->data.f[0];
    if (anomaly_score > 0.85f) trigger_alarm();
}`
    },
    highspeed: {
      mcu: 'Xilinx Zynq-7000 / DDR3 Memory',
      pcb: '8-Layer Megtron-6 (Low Loss)',
      power: 'Point-of-Load PMIC Multi-Rail',
      turn: '5 Weeks End-to-End',
      code: `// High-Speed DDR3 Calibration
int ddr3_phy_training(void) {
    calibrate_write_leveling();
    deskew_data_lanes(LANE_0_TO_3);
    assert(eye_margin_ps > 180);
    return PHY_TRAINED_OK;
}`
    }
  };

  const archetypeBtns = document.querySelectorAll('.archetype-btn');
  archetypeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-type');
      const data = ARCHETYPES[type];
      if (!data) return;

      archetypeBtns.forEach(b => {
        b.className = 'min-h-[44px] px-3.5 py-2.5 inline-flex items-center justify-center gap-1.5 rounded-xl bg-white dark:bg-brand-surface text-slate-900 dark:text-white font-bold border border-slate-300 dark:border-brand-border hover:border-brand-500 transition archetype-btn';
        b.setAttribute('aria-pressed', 'false');
      });
      btn.className = 'min-h-[44px] px-3.5 py-2.5 inline-flex items-center justify-center gap-1.5 rounded-xl bg-brand-500 text-white font-black border border-white/20 shadow-md transition transform scale-105 archetype-btn';
      btn.setAttribute('aria-pressed', 'true');

      document.getElementById('specMcu').textContent = data.mcu;
      document.getElementById('specPcb').textContent = data.pcb;
      document.getElementById('specPower').textContent = data.power;
      document.getElementById('specTurn').textContent = data.turn;
      document.getElementById('liveCodeSnippet').textContent = data.code;
      const announcement = document.getElementById('archetype-announcement');
      if (announcement) announcement.textContent = `Showing ${btn.getAttribute('aria-label') || btn.textContent.trim()} reference architecture.`;
    });
  });

  // 6. Console Tabs
  const tabBtns = document.querySelectorAll('.console-tab-btn');
  const tabCode = document.getElementById('tabContentCode');
  const tabScope = document.getElementById('tabContentScope');
  const tabTerm = document.getElementById('tabContentTerminal');
  const tabLogic = document.getElementById('tabContentLogic');
  const ACTIVE_TAB_CLS = 'console-tab-btn w-full md:flex-1 min-h-[38px] py-1.5 px-2 rounded-lg bg-white dark:bg-brand-surface text-brand-600 dark:text-accent font-black text-xs shadow-xs border border-slate-200/80 dark:border-white/10 inline-flex items-center justify-center gap-1.5 transition whitespace-nowrap overflow-hidden';
  const INACTIVE_TAB_CLS = 'console-tab-btn w-full md:flex-1 min-h-[38px] py-1.5 px-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/50 dark:hover:bg-white/5 font-bold text-xs inline-flex items-center justify-center gap-1.5 transition whitespace-nowrap overflow-hidden';

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      tabBtns.forEach(b => {
        b.className = INACTIVE_TAB_CLS;
        b.setAttribute('aria-selected', 'false');
      });
      btn.className = ACTIVE_TAB_CLS;
      btn.setAttribute('aria-selected', 'true');

      if (tabCode) tabCode.classList.add('hidden');
      if (tabScope) tabScope.classList.add('hidden');
      if (tabTerm) tabTerm.classList.add('hidden');
      if (tabLogic) tabLogic.classList.add('hidden');

      const fnEl = document.getElementById('consoleActiveFilename');
      if (fnEl) {
        if (target === 'code') fnEl.textContent = 'src/bringup/main.c';
        if (target === 'scope') fnEl.textContent = 'rigol_ds1054z.ch1';
        if (target === 'terminal') fnEl.textContent = '/dev/ttyUSB0 (115200 8N1)';
        if (target === 'logic') fnEl.textContent = 'saleae_logic_pro16.spi';
      }

      if (target === 'code' && tabCode) tabCode.classList.remove('hidden');
      if (target === 'scope' && tabScope) {
        tabScope.classList.remove('hidden');
        startOscilloscope();
      }
      if (target === 'terminal' && tabTerm) tabTerm.classList.remove('hidden');
      if (target === 'logic' && tabLogic) tabLogic.classList.remove('hidden');
    });
  });

  // 7. Multi-Waveform Live Canvas Oscilloscope
  let currentWaveform = 'square';
  let scopeAnimId = null;
  const ACTIVE_WAVE_CLS = 'waveform-btn min-h-[32px] px-2.5 py-1 flex-1 min-[520px]:flex-initial inline-flex items-center justify-center gap-1 bg-brand-500 text-white rounded-lg text-xs font-bold border border-brand-500 shadow-xs transition';
  const INACTIVE_WAVE_CLS = 'waveform-btn min-h-[32px] px-2.5 py-1 flex-1 min-[520px]:flex-initial inline-flex items-center justify-center gap-1 bg-slate-800/90 hover:bg-slate-700 text-slate-300 hover:text-white rounded-lg text-xs font-bold border border-slate-700 transition';

  function setWaveform(type) {
    currentWaveform = type;
    const label = document.getElementById('scopeSignalLabel');
    if (type === 'square') label.textContent = 'Signal: Clock PWM (10.0 MHz)';
    if (type === 'sine') label.textContent = 'Signal: Analog Sine (1.0 kHz)';
    if (type === 'burst') label.textContent = 'Signal: UART TX Burst (115.2k)';
    document.querySelectorAll('.waveform-btn').forEach(btn => {
      btn.className = btn.getAttribute('data-wave') === type ? ACTIVE_WAVE_CLS : INACTIVE_WAVE_CLS;
    });
  }
  window.setWaveform = setWaveform;

  function startOscilloscope() {
    if (scopeAnimId) cancelAnimationFrame(scopeAnimId);
    const canvas = document.getElementById('scopeCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let offset = 0;

    function draw() {
      const rootStyles = getComputedStyle(document.documentElement);
      const scopeBg = rootStyles.getPropertyValue('--bg-dark').trim() || '#0b1412';
      const scopeGrid = rootStyles.getPropertyValue('--border-color').trim() || '#1e3831';
      const scopeTrace = rootStyles.getPropertyValue('--secondary-color').trim() || '#10b981';
      ctx.fillStyle = scopeBg;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Grid Lines
      ctx.strokeStyle = scopeGrid;
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += 30) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
      }
      for (let y = 0; y < canvas.height; y += 30) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }

      // Signal Trace
      ctx.strokeStyle = scopeTrace;
      ctx.lineWidth = 2.5;
      ctx.shadowBlur = 10;
      ctx.shadowColor = scopeTrace;
      ctx.beginPath();

      if (currentWaveform === 'square') {
        const period = 50;
        for (let x = 0; x < canvas.width; x++) {
          const cycleX = (x + offset) % period;
          const y = cycleX < period / 2 ? 35 : 115;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
      } else if (currentWaveform === 'sine') {
        for (let x = 0; x < canvas.width; x++) {
          const y = 75 + Math.sin((x + offset) * 0.08) * 45;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
      } else if (currentWaveform === 'burst') {
        // Serial packet bursts
        for (let x = 0; x < canvas.width; x++) {
          const noise = ((Math.sin((x + offset) * 0.2) > 0.1) ? 35 : 115);
          if (x === 0) ctx.moveTo(x, noise);
          else ctx.lineTo(x, noise);
        }
      }

      ctx.stroke();
      ctx.shadowBlur = 0;

      offset += 2.5;
      scopeAnimId = requestAnimationFrame(draw);
    }
    draw();
  }

  // 8. Virtual Bring-Up Button
  const btnBringUp = document.getElementById('btnRunBringUp');
  const bringUpStatus = document.getElementById('bringUpStatus');
  const termLogs = document.getElementById('terminalLogs');

  if (btnBringUp) btnBringUp.addEventListener('click', () => {
    // Switch to terminal tab
    tabBtns.forEach(b => {
      b.className = b.getAttribute('data-tab') === 'terminal' ? ACTIVE_TAB_CLS : INACTIVE_TAB_CLS;
    });
    tabCode.classList.add('hidden');
    tabScope.classList.add('hidden');
    tabTerm.classList.remove('hidden');

    const fnEl = document.getElementById('consoleActiveFilename');
    if (fnEl) fnEl.textContent = '/dev/ttyUSB0 (115200 8N1)';

    btnBringUp.disabled = true;
    bringUpStatus.textContent = 'Executing bring-up...';
    bringUpStatus.className = 'text-amber-500 font-bold animate-pulse';
    termLogs.innerHTML = '<div class="text-slate-400 font-bold mb-1">// Initiating automated hardware bench cycle...</div>';

    const steps = [
      { t: 300, msg: '<div class="text-emerald-400 font-medium"><span class="text-slate-500">[0.001s]</span> <span class="text-cyan-400 font-bold">[POWER]</span> LDO rails 3.3V stable (3.302V, ripple &lt; 8mV)... <span class="text-emerald-300 font-bold">OK</span></div>' },
      { t: 800, msg: '<div class="text-emerald-400 font-medium"><span class="text-slate-500">[0.015s]</span> <span class="text-cyan-400 font-bold">[CLOCK]</span> 72MHz PLL locked, jitter &lt; 5ps... <span class="text-emerald-300 font-bold">OK</span></div>' },
      { t: 1300, msg: '<div class="text-emerald-400 font-medium"><span class="text-slate-500">[0.045s]</span> <span class="text-cyan-400 font-bold">[PERIPH]</span> SPI Flash JEDEC ID verified (Winbond 16MB)... <span class="text-emerald-300 font-bold">OK</span></div>' },
      { t: 1800, msg: '<div class="text-emerald-400 font-medium"><span class="text-slate-500">[0.092s]</span> <span class="text-amber-400 font-bold">[HIL]</span> CAN-FD bus arbitration 5Mbps loopback test... <span class="text-emerald-300 font-bold">PASS</span></div>' },
      { t: 2300, msg: '<div class="text-brand-400 font-bold"><span class="text-slate-500">[0.120s]</span> <span class="text-emerald-400 font-bold">[RTOS]</span> FreeRTOS kernel started. 4 tasks active. SYSTEM READY.</div>' }
    ];

    steps.forEach(step => {
      setTimeout(() => {
        termLogs.innerHTML += step.msg;
      }, step.t);
    });

    setTimeout(() => {
      btnBringUp.disabled = false;
      bringUpStatus.textContent = 'Board Status: ONLINE';
      bringUpStatus.className = 'text-slate-700 dark:text-slate-300 font-bold';
    }, 2400);
  });

  // 9. Instant Homepage Sandbox Slider
  const miniSlider = document.getElementById('miniCurrentSlider');
  const miniCurrentLabel = document.getElementById('miniCurrentLabel');
  const miniWidthResult = document.getElementById('miniWidthResult');
  const miniWidthMmResult = document.getElementById('miniWidthMmResult');

  function updateMiniTrace() {
    const current = parseFloat(miniSlider.value);
    miniCurrentLabel.textContent = current.toFixed(1) + ' Amps';
    
    // IPC-2221 External: A = (I / (0.048 * (10^0.44)))^(1/0.725)
    const areaMils2 = Math.pow(current / (0.048 * Math.pow(10, 0.44)), 1 / 0.725);
    const widthMils = areaMils2 / 1.378; // 1 oz
    const widthMm = widthMils * 0.0254;

    miniWidthResult.textContent = widthMils.toFixed(1) + ' mils';
    miniWidthMmResult.textContent = '(' + widthMm.toFixed(2) + ' mm)';
  }

  if (miniSlider) { miniSlider.addEventListener('input', updateMiniTrace); updateMiniTrace(); }
  
  // Estimator State & Handler
  let currentEstPhase = 'prototype';
  let currentEstComplexity = 'low';
  let currentEstCompliance = 'none';
  let estimatorRequestId = 0;

  function updateEstimator() {
    const requestId = ++estimatorRequestId;
    const requestState = {
      phase: currentEstPhase,
      complexity: currentEstComplexity,
      compliance: currentEstCompliance
    };
    const statusEl = document.getElementById('estimator-status');
    if (statusEl) statusEl.textContent = 'Updating the planning estimate…';

    fetch('/api/estimator/calculate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(requestState)
    })
    .then(r => r.json())
    .then(data => {
      if (requestId !== estimatorRequestId) return;
      if (!data || !data.success) {
        throw new Error(data && data.message ? data.message : 'The estimator returned an unsuccessful response.');
      }
      const timeEl = document.getElementById('estTimelineOutput');
      const compEl = document.getElementById('estComplexityOutput');
      const listEl = document.getElementById('estDeliverablesList');
      const teamEl = document.getElementById('estTeamOutput');
      const ctaEl = document.getElementById('estQuoteCta');

      if (timeEl) timeEl.textContent = data.timeline;
      if (compEl) compEl.textContent = data.complexityLabel + ' • ' + data.complianceLabel;
      if (teamEl) teamEl.textContent = data.recommendedTeam;
      if (listEl) {
        listEl.innerHTML = data.deliverables.map(d =>
          `<li class="flex items-center space-x-2"><span class="text-emerald-500 font-bold">✓</span><span>${d}</span></li>`
        ).join('');
      }
      if (ctaEl) {
        const serviceByPhase = {
          prototype: 'Hardware Design',
          'full-cycle': 'End-to-End Product',
          firmware: 'Firmware/BSP',
          hmi: 'Embedded UI / HMI'
        };
        const params = new URLSearchParams({
          service: serviceByPhase[requestState.phase] || 'Hardware Design',
          subject: `Scope estimate: ${data.timeline} ${data.complexityLabel}`,
          'estimate-timeline': data.timeline || '',
          'estimate-complexity': data.complexityLabel || '',
          'estimate-compliance': data.complianceLabel || '',
          'estimate-team': data.recommendedTeam || ''
        });
        params.set('estimate-deliverables', Array.isArray(data.deliverables) ? data.deliverables.join('; ') : '');
        ctaEl.href = `/contact?${params.toString()}`;
      }
      if (statusEl) statusEl.textContent = 'Planning estimate only; final scope and timeline are confirmed after engineering review.';
    })
    .catch(err => {
      if (requestId !== estimatorRequestId) return;
      console.error('[ESTIMATOR] Could not calculate the planning estimate.', err);
      if (statusEl) statusEl.textContent = 'Unable to refresh the estimate. The displayed planning values remain available to discuss with engineering.';
    });
  }

  document.querySelectorAll('.est-phase-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.est-phase-btn').forEach(b => {
        b.className = 'est-phase-btn px-4 py-3 rounded-2xl bg-white dark:bg-brand-surface text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-left transition hover:border-brand-500 active:scale-95';
        b.setAttribute('aria-pressed', 'false');
      });
      btn.className = 'est-phase-btn px-4 py-3 rounded-2xl bg-brand-500 text-white font-black border border-brand-500 shadow-md text-left transition transform active:scale-95';
      btn.setAttribute('aria-pressed', 'true');
      currentEstPhase = btn.dataset.val;
      updateEstimator();
    });
  });

  document.querySelectorAll('.est-comp-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.est-comp-btn').forEach(b => {
        b.className = 'est-comp-btn px-4 py-3 rounded-2xl bg-white dark:bg-brand-surface text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-left transition hover:border-brand-500 active:scale-95';
        b.setAttribute('aria-pressed', 'false');
      });
      btn.className = 'est-comp-btn px-4 py-3 rounded-2xl bg-brand-500 text-white font-black border border-brand-500 shadow-md text-left transition transform active:scale-95';
      btn.setAttribute('aria-pressed', 'true');
      currentEstComplexity = btn.dataset.val;
      updateEstimator();
    });
  });

  document.querySelectorAll('.est-comp-rule').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.est-comp-rule').forEach(b => {
        b.className = 'est-comp-rule min-h-[44px] px-3 py-2.5 flex items-center justify-center rounded-xl bg-white dark:bg-brand-surface text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-brand-border text-center transition hover:border-brand-500 active:scale-95';
        b.setAttribute('aria-pressed', 'false');
      });
      btn.className = 'est-comp-rule min-h-[44px] px-3 py-2.5 flex items-center justify-center rounded-xl bg-brand-500 text-white font-black border border-brand-500 text-center transition active:scale-95';
      btn.setAttribute('aria-pressed', 'true');
      currentEstCompliance = btn.dataset.val;
      updateEstimator();
    });
  });

  updateEstimator();

</script>

