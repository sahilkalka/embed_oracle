          <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2.05 21.95l4.89-1.284C8.384 21.526 10.134 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2c-1.638 0-3.167-.478-4.46-1.3l-.32-.203-3.308.868.883-3.224-.222-.352C3.69 14.622 3.2 13.153 3.2 11.6c0-4.852 3.948-8.8 8.8-8.8s8.8 3.948 8.8 8.8c0 4.851-3.948 8.8-8.8 8.8z"/>
        </svg>
        <span class="max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-xs transition-all duration-300 ease-in-out text-xs font-bold pl-0 group-hover:pl-2">WhatsApp Us</span>
      </a>
    </aside>
  <% } %>

  <!-- Back-to-Top Floating Button -->
  <% if (settings.enable_back_to_top !== 'false') { %>
    <button id="back-to-top-btn" type="button" aria-label="Back to top"  class="hidden pointer-events-none fixed bottom-20 right-6 z-40 p-3 rounded-full bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 shadow-xl hover:bg-slate-100 dark:hover:bg-slate-700 transition active:scale-95">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
    </button>
  <% } %>

  <!-- Delayed Popup RFQ Modal -->
  <% if (settings.enable_rfq_modal === 'true') { %>
    <div id="rfq-auto-modal" aria-hidden="true" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="w-full max-w-lg bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-2xl relative animate-in fade-in zoom-in-95 duration-200">
        <button id="rfq-modal-close" type="button" aria-label="Close dialog" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 dark:hover:text-white p-1 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <span class="px-2.5 py-1 bg-accent/20 text-accent font-bold rounded-full text-xs uppercase tracking-wider">Fast-Track RFQ</span>
        <h3 class="text-xl font-black text-slate-900 dark:text-white mt-2">Have a New Embedded Design Project?</h3>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">Get an engineering proposal with turnaround times and BOM estimates within 24 hours.</p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="btn-shimmer flex-1 inline-flex items-center justify-center gap-2 py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs shadow-md transition">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>Request Quote Now &rarr;</span>
          </a>
          <button type="button" id="rfq-modal-dismiss" class="px-4 py-3 bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-300 rounded-xl text-xs font-semibold hover:bg-slate-200 transition inline-flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Maybe Later</span>
          </button>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Admin Dynamic Body Script Injection -->
  <% if (settings.custom_body_scripts && settings.custom_body_scripts.trim()) { %>
    <%- settings.custom_body_scripts %>
  <% } %>

  <!-- Global Client-Side Scripts -->
  <script src="/assets/js/header-search.js?v=<%= assetVersion %>"></script>
  <script>
    // 3. Back-to-Top Button Scroll Handler
    const backToTopBtn = document.getElementById('back-to-top-btn');
    if (backToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          backToTopBtn.classList.remove('hidden', 'pointer-events-none');
        } else {
          backToTopBtn.classList.add('hidden', 'pointer-events-none');
        }
      });
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 4. Delayed RFQ Popup Modal Handler
    const rfqModal = document.getElementById('rfq-auto-modal');
    const rfqClose = document.getElementById('rfq-modal-close');
    const rfqDismiss = document.getElementById('rfq-modal-dismiss');
    if (rfqModal && !sessionStorage.getItem('rfq-dismissed')) {
      const delaySec = Number('<%= settings.rfq_modal_delay_sec || 5 %>') || 5;
      const showRfqModal = () => {
        if (!sessionStorage.getItem('rfq-dismissed')) {
          rfqModal.setAttribute('aria-hidden', 'false');
          rfqModal.classList.remove('hidden');
        }
      };
      setTimeout(() => {
        if (document.documentElement.dataset.cookieConsentPending === 'true') {
          document.addEventListener('cookieconsentresolved', showRfqModal, { once: true });
        } else {
          showRfqModal();
        }
      }, delaySec * 1000);

      const hideRfq = () => {
        rfqModal.classList.add('hidden');
        rfqModal.setAttribute('aria-hidden', 'true');
        sessionStorage.setItem('rfq-dismissed', 'true');
      };
      if (rfqClose) rfqClose.addEventListener('click', hideRfq);
      if (rfqDismiss) rfqDismiss.addEventListener('click', hideRfq);
    }

    // 5. Card Spotlight Cursor Tracker
    document.querySelectorAll('.spotlight-card, .interactive-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });

    // 6. Mobile Navigation Menu
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        const isHidden = mobileMenu.classList.toggle('hidden');
        mobileMenu.setAttribute('aria-hidden', isHidden ? 'true' : 'false');
        mobileMenuBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          mobileMenu.setAttribute('aria-hidden', 'true');
          mobileMenuBtn.setAttribute('aria-expanded', 'false');
          mobileMenuBtn.focus();
        }
      });
    }

    // 7. Header Quick Search Widget
    window.HeaderSearch.init();

    // 9. Newsletter Form Submission AJAX
    const newsletterForm = document.getElementById('newsletter-form');
    const newsletterStatus = document.getElementById('newsletter-status');
    if (newsletterForm) {
      newsletterForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        newsletterStatus.textContent = 'Submitting...';
        newsletterStatus.className = 'text-xs text-accent';
        const formData = new FormData(newsletterForm);
        const data = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          if (result.success) {
            newsletterStatus.textContent = result.message;
            newsletterStatus.className = 'text-xs text-accent font-semibold';
            newsletterForm.reset();
          } else {
            newsletterStatus.textContent = result.message;
            newsletterStatus.className = 'text-xs text-red-400';
          }
        } catch (err) {
          newsletterStatus.textContent = 'Error connecting to server. Please try again.';
          newsletterStatus.className = 'text-xs text-red-400';
        }
      });
    }
  </script>

  <%- include('../partials/copilot') %>

  <script>
    (function() {
      const trigger = document.getElementById('copilot-trigger-btn');
      if (!trigger) return;

      let loaded = false;
      let loading = null;
      let clickReplayPending = false;

      function loadCopilot() {
        if (loaded) return Promise.resolve();
        if (loading) return loading;

        loading = new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = <%- JSON.stringify('/assets/js/copilot-widget.js?v=' + assetVersion) %>;
          script.async = true;
          script.onload = () => {
            loaded = true;
            resolve();
          };
          script.onerror = () => {
            script.remove();
            loading = null;
            reject(new Error('Failed to load Copilot widget script.'));
          };
          document.body.appendChild(script);
        });

        return loading;
      }

      function preloadCopilot() {
        loadCopilot().catch(error => console.error('[COPILOT] Failed to load widget.', error));
      }

      trigger.addEventListener('pointerenter', preloadCopilot, { once: true });
      trigger.addEventListener('focus', preloadCopilot, { once: true });
      trigger.addEventListener('click', event => {
        if (loaded) return;
        event.preventDefault();
        if (clickReplayPending) return;

        clickReplayPending = true;
        trigger.setAttribute('aria-busy', 'true');
        loadCopilot().then(() => {
          clickReplayPending = false;
          trigger.removeAttribute('aria-busy');
          trigger.click();
        }).catch(error => {
          clickReplayPending = false;
          trigger.removeAttribute('aria-busy');
          console.error('[COPILOT] Failed to load widget.', error);
        });
      });
    })();
  </script>

  <script src="/assets/js/theme-manager.js?v=<%= assetVersion %>"></script>
  <script src="/assets/js/cookie-consent.js?v=<%= assetVersion %>" defer></script>
  <script src="/assets/js/ui-effects.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
