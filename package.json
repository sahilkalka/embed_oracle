{
  "name": "embeddedindia-portal",
  "version": "1.0.0",
  "description": "Embedded India web portal and engineering hub with dynamic tools, automated blog engine, SEO, and admin dashboard",
  "main": "app.js",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "start": "node app.js",
    "start:cluster": "node src/cluster.js",
    "dev": "nodemon app.js",
    "build": "npm run build:css && npm run generate-lead-magnet",
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./src/public/css/input.css -o ./public/css/style.css --minify",
    "watch:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./src/public/css/input.css -o ./public/css/style.css --watch",
    "db:init": "node scripts/init-db.js && node scripts/seed-sqlite.js",
    "localize-assets": "node scripts/localize-assets.js",
    "generate-lead-magnet": "node scripts/generate-lead-magnet.js",
    "pre-deploy": "npm run build && node --check app.js && node --check src/server.js && node --check src/cluster.js",
    "pack": "npm run build && node scripts/pack-bundle.js",
    "pack:cpanel": "npm run build && node scripts/pack-bundle.js",
    "oracle:setup": "bash scripts/oracle-setup.sh",
    "oracle:deploy": "bash scripts/oracle-deploy.sh",
    "server:setup": "bash server-deploy.sh",
    "server:fresh": "bash server-deploy.sh fresh",
    "server:update": "bash server-deploy.sh update",
    "admin:reset": "node scripts/reset-admin.js",
    "test": "playwright test --project=Desktop-Chrome",
    "test:visual": "node tests/visual_audit_runner.js --test",
    "test:visual:quick": "node tests/visual_audit_runner.js --test --quick",
    "test:visual:reference": "node tests/visual_audit_runner.js --reference",
    "test:visual:approve": "node tests/visual_audit_runner.js --approve",
    "test:improvement-plan": "node scripts/test-improvement-plan.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.2.4",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.7",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "prisma": "^5.22.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.4.20",
    "backstopjs": "^6.3.25",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "puppeteer": "^25.16.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17"
  }
}
