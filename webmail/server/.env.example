# Server Port & Environment
PORT=3005
NODE_ENV=development
APP_URL=http://localhost:5173

# Database (SQLite with WAL mode)
DATABASE_URL="file:./prisma/webmail.db"

# Security & JWT
JWT_SECRET=change-this-to-a-secure-32-char-random-string-in-production
COOKIE_NAME=ei_webmail_token

# Mailbox Default Identity
DEFAULT_MAILBOX_NAME="Embedded India"
DEFAULT_MAILBOX_EMAIL="info@embeddedindia.in"

# Amazon SES Configuration (Primary High-Deliverability Outbound)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL="Embedded India <info@embeddedindia.in>"

# Fallback SMTP Settings (Alternative to SES SDK)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Inbound SES Webhook Secret (Protects /api/webhooks/ses-inbound)
SES_WEBHOOK_SECRET=

# Local SMTP Receiver (Optional - for direct port 25 incoming delivery on server)
ENABLE_LOCAL_SMTP_RECEIVER=false
LOCAL_SMTP_PORT=2525
