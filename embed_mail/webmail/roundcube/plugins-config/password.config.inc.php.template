<?php
/* Embedded India Mail — password change (Settings > Password).
 * Writes the new hash straight into the mail server's mailbox table, the same way
 * the mail admin does. Installed to plugins/password/config.inc.php. */
$config['password_driver'] = 'sql';
$config['password_db_dsn'] = 'mysql://__MC_DBUSER__:__MC_DBPASS__@mysql/__MC_DBNAME__';
$config['password_query'] = 'UPDATE mailbox SET password = %P, attributes = JSON_SET(attributes, \'$.force_pw_update\', \'0\') WHERE username = %u';
$config['password_algorithm'] = 'blowfish-crypt';
$config['password_algorithm_prefix'] = '{BLF-CRYPT}';
$config['password_confirm_current'] = true;
$config['password_minimum_length'] = 12;
$config['password_require_nonalpha'] = true;
$config['password_minimum_score'] = 3;
$config['password_force_save'] = true;
$config['password_log'] = true;
